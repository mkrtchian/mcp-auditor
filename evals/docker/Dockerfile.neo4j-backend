# Neo4j backend image for the nuisance suite's neo4j fixture: stock Neo4j 5.26 LTS with the
# matching APOC core plugin moved into the plugins directory, so apoc.load.* is available without
# NEO4J_PLUGINS fetching a jar at container start (the confined stand-up may deny network). The jar
# ships inside the base image under /var/lib/neo4j/labs, so this is a copy within the image, not a
# COPY/ADD from the build context. Not a server under audit and not a compose service:
# evals/neo4j_backend.py stands one persistent container of this image, reached by container name on
# the neo4j bridge; the fix-check (its own module) stands a separate one with a sentinel.
FROM neo4j:5.26.32@sha256:414adfe41c6ff32abb752be37f265c77607c166cab298f65a917fc4f05776218
RUN cp /var/lib/neo4j/labs/apoc-5.26.32-core.jar /var/lib/neo4j/plugins/apoc-5.26.32-core.jar

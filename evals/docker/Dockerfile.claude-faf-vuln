ADD --checksum=sha256:10e4cd48c594274263af9909d41f2a3cc9965fccb0da2ddc12f52134bfed89ac https://raw.githubusercontent.com/Wolfe-Jam/claude-faf-mcp/dcf631f22b0cf8821a35e6613608b2248848ad38/examples/test-project/tsconfig.json /work/tsconfig.json

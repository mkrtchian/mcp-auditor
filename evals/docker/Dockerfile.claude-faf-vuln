ADD --checksum=sha256:ad95d7d9dde60f848e6445784fb8fe5b1eccc86f4d69387a1b738f460ec88b2a https://raw.githubusercontent.com/Wolfe-Jam/claude-faf-mcp/dcf631f22b0cf8821a35e6613608b2248848ad38/examples/test-project/package.json /work/package.json
ADD --checksum=sha256:879e7a91d7930d9e58a23afc8696a3b214453f992ad2c075e454e00363394f83 https://raw.githubusercontent.com/Wolfe-Jam/claude-faf-mcp/dcf631f22b0cf8821a35e6613608b2248848ad38/examples/test-project/project.faf /work/project.faf

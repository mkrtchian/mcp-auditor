# dbt-mcp 1.17.1 with the fix check's decoy project, for the patched arm of the CVE-2026-44968
# fix check only, never a run: the run image (Dockerfile.dbt) carries no decoy. With the decoy
# present, a patched arm that surfaces nothing shows the fix rejecting the injected flag, not the
# decoy's absence. Same instructions as the run image up to the decoy, for the layer cache.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/dbt \
    && /opt/dbt/bin/pip install --no-cache-dir "dbt-core==1.12.6" "dbt-duckdb==1.11.1" \
    && ln -s /opt/dbt/bin/dbt /usr/local/bin/dbt

RUN python -m venv /opt/mcp \
    && /opt/mcp/bin/pip install --no-cache-dir "dbt-mcp==1.17.1" "pydantic<2.14"

RUN git clone https://github.com/dbt-labs/jaffle_shop_duckdb /project \
    && git -C /project checkout 20cc904370818ceab08cf19f8fd196e9e81def88

RUN cd /project && /opt/dbt/bin/dbt seed --profiles-dir /project \
    && /opt/dbt/bin/dbt run --profiles-dir /project

RUN chmod -R 0777 /project

# A second dbt project outside the declared project scope: its one model reads the file the fix
# check plants and forces its bytes into a conversion error that dbt returns in the tool response.
RUN mkdir -p /decoy/models \
    && printf "name: 'decoy'\nconfig-version: 2\nversion: '0.1'\nprofile: 'jaffle_shop'\nmodel-paths: [\"models\"]\n" > /decoy/dbt_project.yml \
    && printf "{{ config(materialized='table') }}\nselect content::integer as x from read_text('/srv/marker')\n" > /decoy/models/leak.sql \
    && chmod -R 0777 /decoy

ENV DBT_PROJECT_DIR=/project \
    DBT_PROFILES_DIR=/project \
    DBT_PATH=/opt/dbt/bin/dbt \
    DISABLE_SEMANTIC_LAYER=true \
    DISABLE_DISCOVERY=true \
    DISABLE_ADMIN_API=true \
    DISABLE_PRODUCT_DOCS=true

ENTRYPOINT ["/opt/mcp/bin/dbt-mcp"]

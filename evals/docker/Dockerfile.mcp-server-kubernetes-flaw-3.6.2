# mcp-server-kubernetes 3.6.2 on Node 22 (serves the fix check only). The server shells out to the
# kubectl binary and, for its Helm tools, to Helm. kubectl v1.37.3 and Helm v3.22.1 are pinned by
# their published SHA-256, the base by digest, and the server at 3.6.2 from npm. A default chart
# scaffold is generated by `helm create` at /opt/sample-chart at build. Transitive npm deps float.
# No local COPY/ADD.
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb
ADD --checksum=sha256:9a1b55af2795b25dd288dbef62387db9b5530087ab918d28c6ad067f2e3cb07c https://dl.k8s.io/v1.37.3/bin/linux/amd64/kubectl /usr/local/bin/kubectl
RUN chmod 0755 /usr/local/bin/kubectl
ADD --checksum=sha256:896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea https://get.helm.sh/helm-v3.22.1-linux-amd64.tar.gz /tmp/helm.tgz
RUN tar -xzf /tmp/helm.tgz -C /tmp linux-amd64/helm \
 && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
 && chmod 0755 /usr/local/bin/helm \
 && rm -rf /tmp/helm.tgz /tmp/linux-amd64 \
 && helm create /opt/sample-chart \
 && chmod -R a+rX /opt/sample-chart
RUN npm install -g mcp-server-kubernetes@3.6.2
ENV HOME=/tmp

# Vulnerable @nor2/heim-mcp, pinned to commit 3c08b72 (0.1.3), the exec() command-injection
# version (CVE-2026-5602). Built from the real upstream source, not a reimplementation.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

# curl: used by the command-execution exploits to reach the internal/SSRF sentinels.
# ca-certificates: TLS for the build-time source fetch. The server itself needs neither.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG HEIM_COMMIT=3c08b7234b902b467adb7e888a5119104401a44c
RUN curl -sfL "https://codeload.github.com/Nor2-io/heim-mcp/tar.gz/${HEIM_COMMIT}" \
    | tar xz --strip-components=1
RUN npm install && npm run build

# The published heim rust-http example application (Nor2-io/heim caf7020,
# heim-docs/.../guides/examples/Basic-Rust-Application.mdx, the generated component.toml,
# application.toml, Cargo.toml and src/lib.rs), seeded whole outside the layout so the benign
# `heim deploy /opt/myapp` points at a real, deployable heim application the way a working heim
# install would. Inlined so the Dockerfile fingerprint covers its content.
RUN mkdir -p /opt/myapp/src
RUN cat > /opt/myapp/component.toml <<'COMPONENT_TOML_EOF'
name = "myapp" # Component name
version = "0.1.0"

[commands] # Custom commands that can be used from the heim cli
run = "wasmtime serve -S cli target/wasm32-wasip2/debug/myapp.wasm --addr=127.0.0.1:8080"
run_production = "wasmtime serve -S cli target/wasm32-wasip2/release/myapp.wasm --addr=127.0.0.1:8080"


[build.dev] # Dev build command and output
build = "cargo build --target=wasm32-wasip2"
wasm_path = "target/wasm32-wasip2/debug/myapp.wasm"

[build.prod] # Prod build command and output
build = "cargo build --target=wasm32-wasip2 --release"
wasm_path = "target/wasm32-wasip2/release/myapp.wasm"
COMPONENT_TOML_EOF
RUN cat > /opt/myapp/application.toml <<'APPLICATION_TOML_EOF'
name = "myapp" # application name
component_target = 'myapp:0.1.0' # component to target

[[trigger]] # Trigger definition
type = 'http'
path = '/myapp'
method = 'GET'
APPLICATION_TOML_EOF
RUN cat > /opt/myapp/Cargo.toml <<'CARGO_TOML_EOF'
[package]
name = "myapp"
version = "0.1.0"
edition = "2021"

[lib]
crate-type = ["cdylib"]

[package.metadata.component]
package = "myorg:myapp"
proxy = false

[dependencies]
waki = { version = "0.5.0", features = ["json"] }

# reduce wasm binary size
[profile.release]
lto = true
strip = "symbols"
CARGO_TOML_EOF
RUN cat > /opt/myapp/src/lib.rs <<'LIB_RS_EOF'
use waki::{handler, ErrorCode, Request, Response};

#[handler]
fn hello(req: Request) -> Result<Response, ErrorCode> {
    Response::builder()
        .status_code(200)
        .body("Hello World")
        .build()
}
LIB_RS_EOF

# The `heim` CLI is an external program heim-mcp shells out to; its toolchain cannot run under
# the container confinement (no Heim runtime, no registry, no network) and heim.dev no longer
# distributes it, so it is served by a stand-in under its real name on PATH. For `heim deploy
# /opt/myapp` the stand-in serves the documented `heim deploy` output (same source as the app);
# `heim deploy` with any other / no path gets heim's build error, and any non-deploy invocation
# the unrecognized-subcommand error. The command-injection flaw lives entirely in heim-mcp's
# exec() call. Baked inline so the Dockerfile fingerprint covers the stand-in's content. Its
# outputs are recorded in the calibration card (stand_ins).
RUN mkdir -p /usr/local/share/heim
RUN cat > /usr/local/share/heim/deploy.stdout <<'HEIM_DEPLOY_STDOUT_EOF'

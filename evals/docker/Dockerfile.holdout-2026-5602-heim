# Vulnerable @nor2/heim-mcp, pinned to commit 3c08b72 (0.1.3), the exec() command-injection
# version (CVE-2026-5602). Built from the real upstream source, not a reimplementation.
FROM node:22-bookworm-slim

# curl: used by the command-execution exploits to reach the internal/SSRF sentinels.
# ca-certificates: TLS for the build-time source fetch. The server itself needs neither.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG HEIM_COMMIT=3c08b72
RUN curl -sfL "https://codeload.github.com/Nor2-io/heim-mcp/tar.gz/${HEIM_COMMIT}" \
    | tar xz --strip-components=1
RUN npm install && npm run build

# The `heim` CLI is an external dependency heim-mcp shells out to; it is not part of the
# server. Stubbing it with a no-op lets the server's deploy tool run without the real Heim
# toolchain. The command-injection flaw lives entirely in heim-mcp's exec() call, not here.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/heim && chmod +x /usr/local/bin/heim

ENTRYPOINT ["node", "/app/dist/index.js"]

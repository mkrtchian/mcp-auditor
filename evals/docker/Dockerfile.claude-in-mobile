# claude-in-mobile 3.10.3 (first fixed version for CVE-2026-81562). The fix commit a86d9e5
# moves every adb invocation to execFileSync(adb, argv) so the host shell is never spawned,
# and extends the shell-command denylist to cover the lone `&` the 3.10.2 denylist missed.
# Built from its public GitHub repository at the commit the v3.10.3 tag points to (same build
# method as the vulnerable image) to keep the two byte-comparable.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone https://github.com/AlexGladkov/claude-in-mobile.git app \
    && cd app \
    && git checkout a86d9e55694c98a122943eeff859461d0b9aa6d6

WORKDIR /opt/app
RUN npm install --no-audit --no-fund --loglevel=error \
    && npm run build

RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/adb && chmod 0755 /usr/local/bin/adb
ENV ADB_PATH=/usr/local/bin/adb

ENTRYPOINT ["node", "/opt/app/dist/index.js"]

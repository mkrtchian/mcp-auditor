# faf-mcp (GHSA-j4r7-8ph4-43g3) patched: npm faf-mcp 2.1.3, the advisory's first patched release,
# installed as its documentation gives it (npm install -g faf-mcp). safe-path.js's confineFileOp
# confines faf_read/faf_write to the project root (cwd) plus the OS temp dir (FAF_ALLOWED_ROOTS
# left unset, its documented default). Doubles as the nuisance run image. The project directory
# /work holds the project.faf the faf-mcp package itself publishes (package.json lists it under
# `files`), copied whole from the installed package, and belongs to the run's unprivileged
# account so faf_write can write inside the project, as a user's own project directory does.
# No COPY and no download from the build context.
FROM node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN npm install -g faf-mcp@2.1.3
RUN mkdir -p /work \
 && cp /usr/local/lib/node_modules/faf-mcp/project.faf /work/project.faf \
 && chown -R 65534:65534 /work
ENTRYPOINT ["faf-mcp"]

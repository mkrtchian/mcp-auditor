# Vulnerable mcp-shell (v0.5.0, < 0.6.0): the shipped security.yaml runs secure mode
# (use_shell_execution: false) but allowlists the /bin/bash, /usr/bin/git and /usr/bin/python3
# interpreters, so validateCommand's first-token check is bypassed and `/bin/bash <anything>`
# executes arbitrarily (CVE-2026-55581). Real pinned software, cloned from the public source at
# the v0.5.0 tag and built from it. Single stage: the go toolchain stays in the image because a
# two-stage `COPY --from=builder` would hide the baked binary and security.yaml from the
# Dockerfile fingerprint; the runtime packages mirror the upstream alpine runtime of the tag.
FROM golang:1.25-alpine

RUN apk add --no-cache \
    bash curl wget git make findutils grep sed gawk tar gzip unzip ca-certificates \
 && rm -rf /var/cache/apk/*

WORKDIR /src
RUN git clone --depth 1 --branch v0.5.0 https://github.com/sonirico/mcp-shell . \
 && CGO_ENABLED=0 GOOS=linux go build \
      -ldflags "-X main.version=v0.5.0 -s -w -extldflags '-static'" \
      -a -installsuffix cgo -o /usr/local/bin/mcp-shell . \
 && mkdir -p /etc/mcp-shell \
 && cp /src/security.yaml /etc/mcp-shell/security.yaml \
 && chmod +x /usr/local/bin/mcp-shell

ENV MCP_SHELL_SEC_CONFIG_FILE=/etc/mcp-shell/security.yaml
ENV PATH="/usr/local/bin:${PATH}"
ENTRYPOINT ["mcp-shell"]

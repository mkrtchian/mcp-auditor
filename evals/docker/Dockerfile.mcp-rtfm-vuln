# mcp-rtfm (CVE-2026-7728), vulnerable commit dc980194d023 (0.1.0, the parent of the fix e6f0686):
# read_doc builds the path from projectPath, .handoff_docs and docFile with no check on docFile.
# The repository has no git tags and is not on npm, so both arms are git commits.
# Same build as Dockerfile.mcp-rtfm but for the server commit: git 2.56.0 from its release tarball,
# and /work holds the server's own sample project (tests/helpers/fixture-project.ts, identical at
# dc98019 and e6f0686) with .handoff_docs generated by the server itself at build time (README
# Quick Start call, through tests/fixtures/mcp-client.ts), owned by the run user (65534).
# No COPY/ADD from the build context.
FROM node:20@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5
RUN apt-get update && apt-get install -y --no-install-recommends cargo gettext && rm -rf /var/lib/apt/lists/* \
    && curl -fsSLo /tmp/git-2.56.0.tar.xz https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.56.0.tar.xz \
    && echo '26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3  /tmp/git-2.56.0.tar.xz' | sha256sum -c - \
    && tar -C /tmp -xJf /tmp/git-2.56.0.tar.xz \
    && make -C /tmp/git-2.56.0 -j"$(nproc)" prefix=/usr/local all \
    && make -C /tmp/git-2.56.0 prefix=/usr/local install \
    && rm -rf /tmp/git-2.56.0 /tmp/git-2.56.0.tar.xz \
    && /usr/local/bin/git --version | grep -qx 'git version 2.56.0'
RUN git clone https://github.com/ryanjoachim/mcp-rtfm.git /app \
    && git -C /app checkout dc980194d0238a24dd014b38572a5a9995692506
WORKDIR /app
RUN npm install && npm run build
RUN npx tsc --outDir /app/test-build --target ES2022 --module Node16 --moduleResolution Node16 \
        --types node --skipLibCheck tests/helpers/fixture-project.ts tests/fixtures/mcp-client.ts \
    && mkdir /tmp/sample \
    && d="$(TMPDIR=/tmp/sample node --input-type=module -e 'import { createFixtureProject } from "/app/test-build/helpers/fixture-project.js"; process.stdout.write(await createFixtureProject());')" \
    && mv "$d" /work \
    && node --input-type=module -e 'import { McpTestClient } from "/app/test-build/fixtures/mcp-client.js"; const c = await McpTestClient.create(); const r = await c.callTool("analyze_project", { projectPath: "/work", options: { mode: "analyze", initDocs: true } }); await c.close(); if (r.isError) { console.error(JSON.stringify(r)); process.exit(1); }' \
    && test -f /work/.handoff_docs/techStack.md \
    && rm -rf /app/test-build /tmp/sample \
    && chown -R 65534:65534 /work \
    && chmod -R a+rX /app
ENTRYPOINT ["node", "/app/build/index.js"]

# python_sandbox_server, a stdio MCP server shipped inside the IBM mcp-context-forge monorepo
# (https://github.com/IBM/mcp-context-forge), tag v1.0.1: CVE-2026-53710, a RestrictedPython
# sandbox escape. safe_builtins exposes raw getattr/setattr/hasattr (a function call
# RestrictedPython never mediates, unlike dotted attribute access), and validate_code's dunder
# check is a plain substring match over the source text, bypassed by building the dunder name at
# runtime ("__cla" + "ss__"). execute_code then walks ''.__class__.__base__.__subclasses__() to
# subprocess.Popen and runs an OS command. No COPY/ADD: the source is fetched by RUN from the
# tagged repository, never baked in from the build context.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "fastmcp>=3.2.4" \
    "orjson>=3.11.8" \
    "pydantic>=2.13.3" \
    "RestrictedPython>=8.1" \
    "typing-extensions>=4.15.0"

RUN git clone --quiet --depth 1 --branch v1.0.1 https://github.com/IBM/mcp-context-forge.git /src \
 && mkdir -p /app \
 && cp -r /src/mcp-servers/python/python_sandbox_server/src/python_sandbox_server /app/python_sandbox_server \
 && rm -rf /src

WORKDIR /app
# The kit launches with -w /, so pin the package on the path rather than relying on cwd.
ENV PYTHONPATH=/app

# Default transport is stdio (mcp.run()); no scope argument is taken.
ENTRYPOINT ["python3", "-m", "python_sandbox_server.server_fastmcp"]

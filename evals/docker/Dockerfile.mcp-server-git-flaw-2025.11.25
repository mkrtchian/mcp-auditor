# PyPI:mcp-server-git fix-check-only image: the server pinned at 2025.11.25. It serves the fix check of
# the four flaws patched at 2025.12.18, never a run. Transitive pip dependencies float (no lockfile);
# the one exception is mcp, which the server declares unbounded (mcp>=1.0.0) while mcp 2.x removed the
# low-level Server.list_tools decorator the server registers its tools with, so an unbounded install
# crashes the server at import. Base pinned by digest for cross-machine reproducibility
# (python:3.12-slim-bookworm, whose Debian git package is 2.39.5).
FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64

RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "mcp-server-git==2025.11.25" "mcp<2"

RUN git config --system user.name "Project Maintainer" \
 && git config --system user.email "maint@example.invalid" \
 && git config --system init.defaultBranch main \
 && git config --system safe.directory "*"

# A git repository baked into the image so the run's benign calls answer without a mount. During a
# fix check the frozen /srv layout is mounted over /srv and shadows this tree.
ENV GIT_AUTHOR_DATE="2026-02-01T00:00:00+0000" \
    GIT_COMMITTER_DATE="2026-02-01T00:00:00+0000"
RUN set -eu; \
  mkdir -p /srv/app; cd /srv/app; \
  git init -q -b main; \
  printf 'widget inventory\nitem: alpha\nitem: bravo\n' > inventory.txt; \
  git add inventory.txt; \
  git commit -q -m "Add inventory listing"; \
  git tag v0; \
  printf 'item: charlie\n' >> inventory.txt; \
  printf 'release notes line one\n' > notes.txt; \
  git add notes.txt; \
  chown -R 65534:65534 /srv
ENV GIT_AUTHOR_DATE="" GIT_COMMITTER_DATE=""

WORKDIR /
ENTRYPOINT ["python", "-m", "mcp_server_git"]

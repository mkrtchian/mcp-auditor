# Patched server: IBM mcp-context-forge python_sandbox_server v1.0.2 (CVE-2026-53710 fixed).
# v1.0.2 drops getattr/setattr from safe_builtins and mediates every attribute access, so the
# runtime-built-dunder escape fails and execute_code stays inside the sandbox.
# Base pinned by digest for cross-machine reproducibility (python:3.12-slim-bookworm).
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && pip install --no-cache-dir \
        "python-sandbox-server @ git+https://github.com/IBM/mcp-context-forge.git@9c2ac54a9e7a59d398c419837c7a5acbdb67c5fd#subdirectory=mcp-servers/python/python_sandbox_server" \
    && apt-get purge -y git \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["python", "-m", "python_sandbox_server.server_fastmcp"]

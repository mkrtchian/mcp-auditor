# Vulnerable mcp-server-fetch, pinned to the version the CVE-2026-104120 reporter reproduced on
# (PyPI mcp-server-fetch 2026.6.4, released 2026-06-04). No SSRF egress guard: fetch_url and the
# robots.txt pre-check request any caller-supplied URL, including link-local / cloud-metadata
# addresses. Real software from PyPI, never a reimplementation.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

# The server declares mcp>=1.1.3 with no upper bound; mcp 2.x renamed McpError and breaks its
# import, so pin the SDK to the last 1.x current at this server's release (2026-06-04).
RUN pip install --no-cache-dir "mcp-server-fetch==2026.6.4" "mcp==1.27.2"

# Documented pip launch (README, "Using PIP": python -m mcp_server_fetch). The first documented
# stdio launch is uvx, which resolves and downloads from PyPI at start and cannot run on the
# closed fixture network; the pip launch runs the identical module. No option is set beyond the
# default: robots.txt handling stays at its documented default. The launch appends no arguments
# for an SSRF target, so the full command lives here.
ENTRYPOINT ["python", "-m", "mcp_server_fetch"]

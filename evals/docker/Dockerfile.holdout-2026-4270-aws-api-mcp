# Vulnerable awslabs.aws-api-mcp-server (CVE-2026-4270, GHSA-2cpp-j2fc-qhp7).
# 1.3.8 is in the affected range (>=0.2.14,<1.3.9): the shorthand `@=` paramfile
# resolver (awscli.shorthand.LOCAL_PREFIX_MAP) is left unpatched, so `file://` /
# `fileb://` read any local file, bypassing the workdir/no-access restriction.
FROM python:3.12-slim-bookworm

# mcp pinned <2 (mcp 2.x renames McpError and breaks the server imports) and the
# fastmcp/pydantic that resolve cleanly with it, matching the combo the kit runs under.
RUN pip install --no-cache-dir \
      "awslabs.aws-api-mcp-server==1.3.8" \
      "mcp==1.30.0" \
      "fastmcp==3.4.9" \
      "pydantic==2.11.10"

# A region is mandatory (main() aborts without AWS_REGION). No credentials are
# planted: the exploit surfaces at client-side command validation, before any API call.
ENV AWS_REGION=us-east-1 \
    AWS_API_MCP_TELEMETRY=false

# The launch appends the allowed scope (/srv/app) as the final argument; map it to
# the server's working-directory env (default file-access mode is workdir).
RUN printf '#!/bin/sh\nexport AWS_API_MCP_WORKING_DIR="$1"\nexec awslabs.aws-api-mcp-server\n' \
      > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

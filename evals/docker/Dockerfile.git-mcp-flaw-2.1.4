# @cyanheads/git-mcp-server 2.1.4, vulnerable arm for CVE-2025-53107: git_add interpolates its
# files argument into a shell command unescaped, so a $(...) substitution runs arbitrary
# commands. No COPY/ADD from the build context; the server installs from npm by RUN.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Trust every bind-mounted repo regardless of the uid the container runs as, so benign
# read-only git calls do not trip git's dubious-ownership guard.
RUN git config --system --add safe.directory '*'
RUN npm install -g @cyanheads/git-mcp-server@2.1.4 \
 && npm cache clean --force \
 && mkdir -p /usr/local/lib/node_modules/@cyanheads/git-mcp-server/logs \
 && chmod -R 0777 /usr/local/lib/node_modules/@cyanheads/git-mcp-server/logs
# File logging must be writable under an unprivileged uid; winston opens the log files eagerly
# and the process dies silently otherwise.
ENV MCP_TRANSPORT_TYPE=stdio \
    MCP_LOG_LEVEL=error \
    LOGS_DIR=/tmp \
    NODE_NO_WARNINGS=1 \
    GIT_SIGN_COMMITS=false
# A world-writable throwaway git repo for the git_add benign call: staging into the
# read-only /srv/app mount errors, so the benign stages a file here instead (the patched arm
# must not error on the benign, or CVE-2025-53107 would not count).
RUN git init -q /tmp/benignrepo \
 && printf 'benign\n' > /tmp/benignrepo/note.txt \
 && chmod -R 0777 /tmp/benignrepo
ENTRYPOINT ["git-mcp-server"]

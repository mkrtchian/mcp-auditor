# graph.facebook.com stand-in for gomarble-ai/facebook-ads-mcp-server at 4e53875, served under the
# host's real name on the backend's closed bridge. The Graph API is a remote Meta service behind
# an account and a token, so it cannot run here.
#   GET /v22.0/<id>/insights with an access_token query parameter: the first example response of
#     Meta's Ads Insights API page (https://developers.facebook.com/docs/marketing-api/insights/,
#     retrieved 2026-11-07, sha256 4aa6b9ffc52591722ca701686facef70d604f8428a7fd0c8bab7ec8d3f53ab72),
#     copied unedited.
#   GET /v22.0/<id>/insights without an access_token query parameter: the real Graph API's
#     answer, captured 2026-11-07.
#   any other request: the real Graph API's answer to an unsupported GET, captured 2026-11-07.
# The captures sit in evals/stand_ins/facebook-ads-responder/graph.facebook.com.captures.json.
# The certificate is the backend's fixed self-signed pair, trusted by the server through
# REQUESTS_CA_BUNDLE.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN echo '' | base64 -d > /cert.pem \
 && echo '' | base64 -d > /key.pem

RUN mkdir -p /graph && cat > /graph/insights.json <<'EOF'
{
  "data": [
    {
      "account_id": "<AD_ACCOUNT_ID>",
      "campaign_id": "<CAMPAIGN_ID>",
      "date_start": "2025-03-14",
      "date_stop": "2025-04-12",
      "impressions": "361324",
      "spend": "5339.5"
    }
  ],
  "paging": {
    "cursors": {
    "before": "MAZDZD",
    "after": "MAZDZD"
    }
  }
}
EOF

RUN cat > /responder.js <<'EOF'
const https = require('https');
const fs = require('fs');

const JSON_TYPE = 'application/json; charset=UTF-8';
const INSIGHTS = [200, {}, fs.readFileSync('/graph/insights.json')];
const NO_ACCESS_TOKEN = [403, {"x-ad-api-version-warning": "You are calling a deprecated version of the Ads API.", "www-authenticate": "OAuth \"Facebook Platform\" \"insufficient_scope\" \"(#200) Provide valid app ID\"", "facebook-api-version": "v22.0"}, "{\"error\":{\"message\":\"(#200) Provide valid app ID\",\"type\":\"OAuthException\",\"code\":200,\"fbtrace_id\":\"AaV3zhjVgiowgSuSh1be2dn\"}}"];
const UNSUPPORTED = [400, {"www-authenticate": "OAuth \"Facebook Platform\" \"invalid_request\" \"Unsupported get request. Please read the Graph API documentation at https://developers.facebook.com/docs/graph-api\"", "facebook-api-version": "v21.0"}, "{\"error\":{\"message\":\"Unsupported get request. Please read the Graph API documentation at https:\\/\\/developers.facebook.com\\/docs\\/graph-api\",\"type\":\"GraphMethodException\",\"code\":100,\"error_subcode\":33,\"fbtrace_id\":\"AoiTl1CPTC9D32JK8zwBXIH\"}}"];

https.createServer({ key: fs.readFileSync('/key.pem'), cert: fs.readFileSync('/cert.pem') }, (req, res) => {
  const url = new URL(req.url, 'https://graph.facebook.com');
  const parts = url.pathname.split('/').slice(1);
  let answer = UNSUPPORTED;
  if (req.method === 'GET' && parts.length === 3 && parts[0] === 'v22.0' && parts[2] === 'insights') {
    answer = url.searchParams.has('access_token') ? INSIGHTS : NO_ACCESS_TOKEN;
  }
  res.writeHead(answer[0], { ...answer[1], 'content-type': JSON_TYPE });
  res.end(answer[2]);
}).listen(443);
EOF

ENTRYPOINT ["node", "/responder.js"]

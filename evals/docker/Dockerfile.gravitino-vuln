# syntax=docker/dockerfile:1
# Apache Gravitino's MCP server at v1.2.0 (vulnerable to CVE-2026-41041), run over stdio, for the
# nuisance suite's CVE-2026-41041 fix check.
FROM python@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39

# git is needed to install the MCP server from its pinned source revision.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Pinned at the v1.2.0 release commit.
RUN pip install --no-cache-dir \
    "gravitino_mcp_server @ git+https://github.com/apache/gravitino.git@1c1665f05e24f69833bcedfb0e6dc6b477f95dc4#subdirectory=mcp-server"

ENTRYPOINT ["python", "-m", "mcp_server"]

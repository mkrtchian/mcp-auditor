# flyto-core MCP server, vulnerable version (CVE-2026-55787, SSRF guard bypass via IPv6
# transition addresses). Real pinned software from PyPI, no stub.
# Base pinned by digest for cross-machine reproducibility (python:3.12-slim).
FROM python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

# The vulnerable release: is_private_ip() checks plain range membership and never unwraps the
# IPv4 embedded in an IPv6 transition form, so ::ffff:<ip> / 6to4 / NAT64 bypass the guard.
RUN pip install --no-cache-dir "flyto-core==2.26.2"

# STDIO MCP transport (core/mcp_server.py). Tools reach the modules through tools/call
# execute_module; http.get runs the SSRF guard (validate_url_with_env_config) then fetches.
ENTRYPOINT ["python", "-m", "core.mcp_server"]

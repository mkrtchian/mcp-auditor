# Run image of the ArcadeDB MCP stdio server at its patched version 26.7.1.
# Launch: ArcadeDB's documented stdio launch (ARCADEDB_SETTINGS with the root password, then
# bin/mcp-stdio.sh), with the documented Docker quick-start database: the OpenBeer dataset imported
# as "Imported" (docs.arcadedb.com, how-to/operations/docker, "Quick start with the OpenBeer
# database"). The network is closed at run time, so the dataset is fetched here, pinned by commit
# and checksum, and imported from the local copy.
FROM arcadedata/arcadedb:26.7.1@sha256:37db3d210bde5849ba5c772ce33b8666b215a77f7b88331fda31fbbf2d130738

USER root

ADD --checksum=sha256:65dae3b7f1db115666e63b4855dd6224064c8be531ee034e301d201309cc8c53 \
  https://github.com/ArcadeData/arcadedb-datasets/raw/6352075b2046178d6063ddbe102e50d117a436e0/orientdb/OpenBeer.gz \
  /home/arcadedb/datasets/OpenBeer.gz

# MCP permissions (config/mcp-config.json): every tool class allowed, allowedUsers at its
# documented default.
RUN printf '%s' '{"enabled":true,"allowReads":true,"allowInsert":true,"allowUpdate":true,"allowDelete":true,"allowSchemaChange":true,"allowAdmin":true,"allowedUsers":["root"]}' \
  > /home/arcadedb/config/mcp-config.json

# The run's uid is not the image's arcadedb user: let it write the server's runtime directories.
RUN chmod -R a+rwX /home/arcadedb

ENV ARCADEDB_SETTINGS="-Darcadedb.server.rootPassword=playwithdata -Darcadedb.server.defaultDatabases=Imported[root]{import:file:///home/arcadedb/datasets/OpenBeer.gz}"

ENTRYPOINT ["/__cacert_entrypoint.sh"]
CMD ["/home/arcadedb/bin/mcp-stdio.sh"]

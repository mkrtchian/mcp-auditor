# CVE-2026-19978 vulnerable build: jiantao88/android-mcp-server at the last affected commit
# cfb872b (OS command injection in executeAdbCommand: child_process.exec with the deviceId /
# packageName / permission / text / path arguments interpolated into a shell string).
# Real software, pinned by commit, cloned from the public repo and built with its own toolchain.
#
# The server runs the adb binary it is handed as argv[2]. The reference deployment attaches an
# Android device over adb; no emulator or physical device can run under the suite confinement, so a
# device-side adb transport listens on the local emulator port (127.0.0.1:5555) and the entrypoint
# waits for adb to report the device before the server starts, so one device is attached on launch.
# The flaw runs in the server's own shell and never reaches the device.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

# git to fetch the pinned commit; curl and unzip fetch and unpack Platform-Tools, and curl lets the
# command-execution primitive reach internal http endpoints (a realistic deployment image).
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/*

# Real Android SDK Platform-Tools (adb), release 37.0.1, installed as the README prescribes
# (download the Android SDK Platform Tools). The README names no version, so the stable release
# current on the calibration day (2026-11-05) is used: 37.0.1 (July 2026). Google's SDK repository
# manifest (dl.google.com/android/repository/repository2-3.xml) publishes only the zip's sha1 and
# size: the download matched both, and the sha256 pinned here was computed from it.
ARG PLATFORM_TOOLS_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
RUN curl -fsSL -o /tmp/platform-tools.zip \
      https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip \
    && echo "${PLATFORM_TOOLS_SHA256}  /tmp/platform-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/platform-tools.zip -d /opt/android \
    && rm /tmp/platform-tools.zip
ENV PATH=/opt/android/platform-tools:$PATH

WORKDIR /app
RUN git clone https://github.com/jiantao88/android-mcp-server.git . \
 && git checkout cfb872b2446794193b58edd63f4dbf6af48a6292 \
 && npm install --no-audit --no-fund \
 && npm run build

# Device-side adb transport (the device stand-in). It serves the adb A_CNXN connection handshake
# with the device identity, and answers A_OPEN stream requests with A_CLSE; adb auto-detects a
# listener on the local emulator port 5555 as emulator-5554. The device identity (version
# 0x01000001, maxdata 1048576 and the banner) is the one the real device sent in a capture of
# 2026-11-13: Android Emulator 37.2.13 running system-images;android-37.0;default;x86_64 r06, the
# AVD made by cmdline-tools 23.0 avdmanager from the medium_phone profile, which `adb devices -l`
# lists as emulator-5554 device product:sdk_phone64_x86_64 model:Android_SDK_built_for_x86_64
# device:emu64x. Wire framing (A_CNXN, A_OPEN, A_CLSE) follows the AOSP adb protocol doc
# (android.googlesource.com/platform/packages/modules/adb/+/refs/heads/main/docs/dev/protocol.md).
RUN cat > /usr/local/lib/adbd.js <<'JS'
const net = require("net");
const A_CNXN = 0x4e584e43;
const A_OPEN = 0x4e45504f;
const A_CLSE = 0x45534c43;
const BANNER = Buffer.from(
  "device::ro.product.name=sdk_phone64_x86_64;ro.product.model=Android SDK built for x86_64;ro.product.device=emu64x;" +
  "features=shell_v2,cmd,stat_v2,ls_v2,fixed_push_mkdir,apex,abb,fixed_push_symlink_timestamp,abb_exec," +
  "remount_shell,track_app,sendrecv_v2,sendrecv_v2_brotli,sendrecv_v2_lz4,sendrecv_v2_zstd," +
  "sendrecv_v2_dry_run_send,openscreen_mdns,devicetracker_proto_format,devraw,app_info,server_status," +
  "track_mdns,delayed_ack"
);
function checksum(buf) { let s = 0; for (const b of buf) s = (s + b) >>> 0; return s; }
function pack(cmd, a0, a1, data) {
  const h = Buffer.alloc(24);
  h.writeUInt32LE(cmd >>> 0, 0);
  h.writeUInt32LE(a0 >>> 0, 4);
  h.writeUInt32LE(a1 >>> 0, 8);
  h.writeUInt32LE(data.length, 12);
  h.writeUInt32LE(checksum(data), 16);
  h.writeUInt32LE((cmd ^ 0xffffffff) >>> 0, 20);
  return Buffer.concat([h, data]);
}
const PORT = parseInt(process.argv[2] || "5555", 10);
net.createServer((sock) => {
  let buf = Buffer.alloc(0);
  sock.on("data", (d) => {
    buf = Buffer.concat([buf, d]);
    while (buf.length >= 24) {
      const cmd = buf.readUInt32LE(0);
      const dlen = buf.readUInt32LE(12);
      if (buf.length < 24 + dlen) break;
      const arg0 = buf.readUInt32LE(4);
      buf = buf.subarray(24 + dlen);
      if (cmd === A_CNXN) sock.write(pack(A_CNXN, 0x01000001, 1024 * 1024, BANNER));
      else if (cmd === A_OPEN) sock.write(pack(A_CLSE, 0, arg0, Buffer.alloc(0)));
    }
  });
  sock.on("error", () => {});
}).listen(PORT, "127.0.0.1");
JS

RUN cat > /usr/local/bin/startup <<'SH'
#!/bin/sh
node /usr/local/lib/adbd.js 5555 &
until node -e 'require("net").connect(5555,"127.0.0.1").on("connect",function(){process.exit(0)}).on("error",function(){process.exit(1)})' 2>/dev/null; do sleep 0.2; done
adb start-server >/dev/null 2>&1
i=0
until adb devices 2>/dev/null | grep -qE 'emulator-5554[[:space:]]+device'; do
  i=$((i+1)); [ "$i" -ge 60 ] && break; sleep 0.25
done
exec "$@"
SH
RUN chmod +x /usr/local/bin/startup

ENTRYPOINT ["/usr/local/bin/startup"]
# The MCP stdio server; argv[2] is the adb path the README documents.
CMD ["node", "/app/build/index.js", "/opt/android/platform-tools/adb"]

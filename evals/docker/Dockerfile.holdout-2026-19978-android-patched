# CVE-2026-19978 patched build: jiantao88/android-mcp-server at the fix commit 14e2bf2
# (createAdbExecutor runs adb through execFile with an argument vector and validates the
# package/permission/deviceId inputs, so caller input can no longer become host shell syntax).
# Same base and toolchain as the vulnerable image; only the checked-out commit differs.
FROM node:20-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates adb curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone https://github.com/jiantao88/android-mcp-server.git . \
 && git checkout 14e2bf27c88ba137e35cbb0c2a75f72b595bb98a \
 && npm install --no-audit --no-fund \
 && npm run build

CMD ["node", "/app/build/index.js", "/usr/bin/adb"]

# Public-service stand-in: replays one capture (evals/stand_ins/<host>.json, mounted at
# /stand-in/capture.json) under the service's real name inside a closed fixture network. HTTP on
# BIND_ADDR:80, HTTPS on BIND_ADDR:443 with the leaf mounted at /stand-in/cert.pem and its key at
# /stand-in/key.pem (BIND_ADDR defaults to every address). A request matching a captured
# (scheme, method, target) gets it verbatim, with only its Content-Type and Location headers:
# the others are provenance, so a replayed Strict-Transport-Security or Alt-Svc cannot change a
# client's behaviour. A HEAD gets the GET route of its target without the body. Any other
# request gets the capture's default for its scheme (the real host's answer to a path it does
# not have), with the request's target wherever the captured answer quoted the probed one: in
# Location as sent, in an HTML or JSON body in the form the capture measured (path_form),
# escaped with markupsafe's table for HTML and as a JSON string's content for JSON; and a
# `miss <scheme> <method> <target>` line on stderr, which the planting teardown logs. The table
# is written out because the image carries no markupsafe, and html.escape writes &quot; and
# &#x27;, which CKAN does not.
# No COPY/ADD: the fingerprint hashes instructions only, so the server is inlined, and the
# capture and the TLS files are mounted per launch, never built in.
# Base pinned by digest for cross-machine reproducibility (python:3.13-slim).
FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1

ENTRYPOINT ["python", "-u", "-c", "import json,os,ssl,sys,threading,urllib.parse\nfrom http.server import BaseHTTPRequestHandler,ThreadingHTTPServer\ncapture=json.load(open('/stand-in/capture.json'))\nroutes={(r['scheme'],r['method'],r['target']):r for r in capture['routes']}\ndefaults={d['scheme']:d for d in capture['defaults']}\nreplayed={'content-type','location'}\nHTML_TABLE=(('&','&amp;'),('<','&lt;'),('>','&gt;'),('\"','&#34;'),(\"'\",'&#39;'))\ndef media_type(headers):\n for name,value in headers:\n  if name.lower()=='content-type':return value.split(';',1)[0].strip().lower()\n return None\ndef quoted(target,default):\n value=urllib.parse.unquote(target) if default['path_form']=='decoded' else target\n if media_type(default['headers'])=='text/html':\n  for raw,escaped in HTML_TABLE:value=value.replace(raw,escaped)\n  return value\n return json.dumps(value)[1:-1]\ndef answer(scheme,method,target):\n route=routes.get((scheme,method,target))\n if route is None and method=='HEAD':route=routes.get((scheme,'GET',target))\n if route is not None:return route['status'],route['headers'],route['body']\n sys.stderr.write('miss %s %s %s\\n'%(scheme,method,target))\n default=defaults[scheme]\n probed=default['probed_target']\n headers=[(name,value.replace(probed,target) if name.lower()=='location' else value) for name,value in default['headers']]\n body=default['body']\n if default['path_form'] is not None:body=body.replace(probed,quoted(target,default))\n return default['status'],headers,body\ndef handler(scheme):\n class Replay(BaseHTTPRequestHandler):\n  def __getattr__(self,name):\n   if name.startswith('do_'):return self.replay\n   raise AttributeError(name)\n  def replay(self):\n   status,headers,text=answer(scheme,self.command,self.path)\n   body=text.encode()\n   self.send_response(status)\n   for name,value in headers:\n    if name.lower() in replayed:self.send_header(name,value)\n   self.send_header('Content-Length',str(len(body)));self.end_headers()\n   if self.command!='HEAD':self.wfile.write(body)\n  def log_message(self,*args):pass\n return Replay\nbind=os.environ.get('BIND_ADDR','')\nplain=ThreadingHTTPServer((bind,80),handler('http'))\nsecure=ThreadingHTTPServer((bind,443),handler('https'))\ncontext=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\ncontext.load_cert_chain('/stand-in/cert.pem','/stand-in/key.pem')\nsecure.socket=context.wrap_socket(secure.socket,server_side=True,do_handshake_on_connect=False)\nthreading.Thread(target=plain.serve_forever,daemon=True).start()\nsecure.serve_forever()"]

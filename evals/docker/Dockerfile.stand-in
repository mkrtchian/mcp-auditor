# Public-service stand-in: replays one capture (evals/stand_ins/<host>.json, mounted at
# /stand-in/capture.json) under the service's real name inside a closed fixture network. HTTP on
# BIND_ADDR:80, HTTPS on BIND_ADDR:443 with the leaf mounted at /stand-in/cert.pem and its key at
# /stand-in/key.pem (BIND_ADDR defaults to every address). A request matching a captured
# (scheme, method, target) gets its recorded status and body, with only its Content-Type and
# Location headers: the others are provenance, so a replayed Strict-Transport-Security or
# Alt-Svc cannot change a client's behaviour. Any other request gets 404 with an empty body and
# a `miss <scheme> <method> <target>` line on stderr, which the planting teardown logs.
# No COPY/ADD: the fingerprint hashes instructions only, so the server is inlined, and the
# capture and the TLS files are mounted per launch, never built in.
# Base pinned by digest for cross-machine reproducibility (python:3.13-slim).
FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1

ENTRYPOINT ["python", "-u", "-c", "import json,os,ssl,sys,threading\nfrom http.server import BaseHTTPRequestHandler,ThreadingHTTPServer\ncapture=json.load(open('/stand-in/capture.json'))\nroutes={(r['scheme'],r['method'],r['target']):r for r in capture['routes']}\nreplayed={'content-type','location'}\ndef handler(scheme):\n class Replay(BaseHTTPRequestHandler):\n  def __getattr__(self,name):\n   if name.startswith('do_'):return self.replay\n   raise AttributeError(name)\n  def replay(self):\n   route=routes.get((scheme,self.command,self.path))\n   if route is None:\n    sys.stderr.write('miss %s %s %s\\n'%(scheme,self.command,self.path))\n    self.send_response(404);self.send_header('Content-Length','0');self.end_headers();return\n   body=route['body'].encode()\n   self.send_response(route['status'])\n   for name,value in route['headers']:\n    if name.lower() in replayed:self.send_header(name,value)\n   self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)\n  def log_message(self,*args):pass\n return Replay\nbind=os.environ.get('BIND_ADDR','')\nplain=ThreadingHTTPServer((bind,80),handler('http'))\nsecure=ThreadingHTTPServer((bind,443),handler('https'))\ncontext=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)\ncontext.load_cert_chain('/stand-in/cert.pem','/stand-in/key.pem')\nsecure.socket=context.wrap_socket(secure.socket,server_side=True,do_handshake_on_connect=False)\nthreading.Thread(target=plain.serve_forever,daemon=True).start()\nsecure.serve_forever()"]

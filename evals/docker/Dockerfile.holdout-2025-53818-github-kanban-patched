# Patched github-kanban-mcp-server. Built from the real pinned upstream source at the first
# commit that fixes the add_comment OS command injection
# (253d93bbdf7ee9fe42bd8fdf15feea93ae59cbae, "fix: prevent gh command injection"; released as
# the v0.4.1 tree). It replaces execAsync(shell string) with execFile('gh', [...argv]) and adds
# issue_number / repo validation. This is the same server build as the vulnerable image except
# for the fix, so the pair isolates exactly CVE-2025-53818 (and its create_issue sibling). gh is
# the same pinned real CLI; api.github.com is served by the stand-in (see the fixture).
FROM node:20-bookworm@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5

ARG GH_VERSION=2.103.3
ARG GH_DEB_SHA256=e3bafef96328d1a67de3a968bdfe1cc2ffd58cf6aba8b5e201356897ed06bb3d
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && curl -fsSL -o /tmp/gh.deb "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.deb" \
    && echo "${GH_DEB_SHA256}  /tmp/gh.deb" | sha256sum -c - \
    && dpkg -i /tmp/gh.deb \
    && rm -f /tmp/gh.deb \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version

ARG COMMIT=253d93bbdf7ee9fe42bd8fdf15feea93ae59cbae
WORKDIR /opt/server
RUN git init -q \
    && git remote add origin https://github.com/sunwood-ai-labs/github-kanban-mcp-server.git \
    && git fetch -q --depth 1 origin "$COMMIT" \
    && git checkout -q FETCH_HEAD \
    && npm install --no-audit --no-fund \
    && test -f build/index.js

ENV GH_TOKEN=gho_A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8
ENV GH_NO_UPDATE_NOTIFIER=1

RUN mkdir -p /repo/.git \
    && printf '[core]\n\trepositoryformatversion = 0\n[remote "origin"]\n\turl = https://github.com/acme/kanban.git\n' > /repo/.git/config \
    && chmod -R a+rX /repo

ENTRYPOINT ["node", "/opt/server/build/index.js"]

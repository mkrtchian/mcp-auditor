# CVE-2026-54785 patched: gemini-bridge 1.3.1 (the advisory's first patched release). 1.3.1's
# _resolve_path resolves symlinks and confines with Path.relative_to(root); inline mode skips any
# entry that resolves outside `directory`. Doubles as the nuisance run image. Same stub `gemini` CLI
# and /work scope as the vulnerable image, so only the server version differs.
# mcp<2: gemini-bridge uses mcp.server.fastmcp.FastMCP (mcp 1.x); mcp 2.x renamed it.
# No COPY/ADD from the build context.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN pip install --no-cache-dir "mcp<2" "gemini-bridge==1.3.1"
RUN printf '#!/bin/sh\ncat\n' > /usr/local/bin/gemini && chmod 0755 /usr/local/bin/gemini
RUN mkdir -p /work && printf 'benign sample content\n' > /work/sample.txt && chmod -R a+rX /work
ENTRYPOINT ["gemini-bridge"]

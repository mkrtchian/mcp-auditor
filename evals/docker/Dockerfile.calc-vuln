# mcp_calculate_server (CVE-2026-44717), vulnerable commit 5e98d9a (0.1.0): calculate_expression
# builds locals_dict = {**sp.__dict__, 'x':x,'y':y,'z':z} and calls
# eval(expression, globals(), locals_dict), so an expression such as
# __import__('os').popen('cat /flag').read() runs an arbitrary shell command whose output is the
# tool's own return value. No npm/PyPI release exists; both arms are git commits.
# No COPY/ADD from the build context; the clone is a RUN fetch.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone https://github.com/611711Dark/mcp_calculate_server.git . \
    && git checkout 5e98d9a20dda1ec7b738fd0b63e9f369fed1e1f5
RUN pip install --no-cache-dir "mcp<2" "sympy>=1.13.3"
ENTRYPOINT ["python", "/app/server.py"]

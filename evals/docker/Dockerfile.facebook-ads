# gomarble-ai/facebook-ads-mcp-server pinned at 4e53875 (patched 4e53875, host-pinned fetch),
# a nuisance fixture for CVE-2026-19956 (SSRF in fetch_pagination_url). NOT an acceptance service.
# Source fetched by RUN from the pinned commit (Python stdlib, no COPY/ADD). The responder's
# public cert is baked at /ca.pem; the server's Python requests trusts it through
# REQUESTS_CA_BUNDLE, carried on the server's docker run by facebook_ads_network_args. The token
# the server reads off sys.argv (--fb-token) rides in the launch, not here.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN pip install --no-cache-dir "mcp>=1.6.0,<2" "requests>=2.32.3"

RUN python -c "import os,urllib.request; os.makedirs('/app',exist_ok=True); urllib.request.urlretrieve('https://raw.githubusercontent.com/gomarble-ai/facebook-ads-mcp-server/4e53875aa22e8991c2fa4a7660d86e1caba66659/server.py','/app/server.py')"

RUN echo '' | base64 -d > /ca.pem

ENTRYPOINT ["python", "/app/server.py"]

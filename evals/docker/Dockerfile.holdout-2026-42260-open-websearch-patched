# Patched open-websearch 2.1.7 (first fixed version for CVE-2026-42260): stripIpv6Brackets
# removes the brackets, then isIP + ipaddr.js range() != 'unicast' classes the IPv4-mapped
# link-local literal as non-unicast and rejects it, so the input is refused at zod validation
# before any fetch (MCP error -32602, no nonce). Built from the public source at tag v2.1.7 with
# its committed lockfile (npm ci): the npm-published 2.1.7 build/ is stale and ships the
# pre-fix urlSafety, so only a source build carries the fix. npm ci pins undici to 6.24.0, which
# loads on node:18 (undici 7.x, pulled by a fresh resolve, needs Node 20's global File).
FROM node:18-alpine
RUN apk add --no-cache git \
 && git clone --branch v2.1.7 --depth 1 https://github.com/Aas-ee/open-webSearch.git /app \
 && cd /app \
 && npm ci \
 && npm run build \
 && npm cache clean --force
WORKDIR /app
ENV NODE_ENV=production
ENV MODE=stdio
ENTRYPOINT ["node", "/app/build/index.js"]

# Stand-in for the external n8n instance (the backend an n8n-mcp deployment points
# N8N_API_URL at). It is NOT the server under test and carries none of the flaw: it only
# answers the two requests a webhook trigger makes, so the REAL redirect-following fetch in
# n8n-mcp (the GHSA-8g7g-hmwm-6rv2 SSRF) can be exercised end to end:
#   - GET /api/v1/workflows/<id>  -> an active workflow holding a webhook trigger node
#   - /webhook/r/<host>/<rest...> -> 302 Location: http://<host>/<rest...>
# The server under test validates the 302's origin, then follows the redirect to the
# internal host without re-validating it. BIND_ADDR/PORT choose where it listens.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

RUN printf '%s\n' \
  "const http=require('http');" \
  "const BIND=process.env.BIND_ADDR||'0.0.0.0', PORT=Number(process.env.PORT||80);" \
  "http.createServer((req,res)=>{" \
  "  console.error('REQ '+req.method+' '+req.url);" \
  "  const wf=req.url.match(/^\\/api\\/v1\\/workflows\\/([^/?]+)/);" \
  "  if(wf){" \
  "    res.writeHead(200,{'Content-Type':'application/json'});" \
  "    res.end(JSON.stringify({id:wf[1],name:'calib',active:true,connections:{}," \
  "      nodes:[{id:'n1',name:'Webhook',type:'n8n-nodes-base.webhook',typeVersion:1," \
  "        position:[0,0],parameters:{path:'calib',httpMethod:'GET'}}]}));" \
  "    return;" \
  "  }" \
  "  const m=req.url.match(/^\\/webhook\\/r\\/(.+)$/);" \
  "  if(m){res.writeHead(302,{Location:'http://'+m[1]});res.end('redirect');return;}" \
  "  if(req.url.startsWith('/webhook/')){res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify({ok:true,message:'workflow started'}));return;}" \
  "  res.writeHead(404,{'Content-Type':'text/plain'});res.end('no route');" \
  "}).listen(PORT,BIND,()=>console.error('stub on '+BIND+':'+PORT));" \
  > /stub.js

ENTRYPOINT ["node", "/stub.js"]

# The external n8n instance an n8n-mcp deployment points N8N_API_URL at. This is NOT the server
# under test: it is the real n8n, the workflow-automation software n8n-mcp's documentation names
# as the instance the n8n API tools talk to, pulled from the image n8n distributes (the digest
# docker.n8n.io serves for 2.46.6, the same as Docker Hub's). The fixture provisions it at launch
# through n8n's own REST and public API (owner setup, an API key, one active webhook workflow,
# evals/n8n_instance_backend.py) and n8n serves both legs n8n_test_workflow exercises: GET
# /api/v1/workflows/<id> (loading the workflow the tool triggers) and GET /webhook/<path> (the
# webhook endpoint of the attacker's own workflow, the endpoint the published redirect-following
# SSRF puts under the attacker's control). The workflow's Respond to Webhook node answers that
# webhook with a 302 whose Location is taken from the request's u query parameter, so the redirect
# target is the exploit call's own argument; n8n-mcp 2.50.0 follows the 302, 2.50.1 (maxRedirects:
# 0) stops at it.
FROM docker.n8n.io/n8nio/n8n:2.46.6@sha256:8602f5dfacbe2c931eeafd010de0e68182310e9f309921e780ab69182e92b3ae

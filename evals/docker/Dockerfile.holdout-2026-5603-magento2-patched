# Patched version of @elgentos/magento2-dev-mcp: the fix commit for CVE-2026-5603
# (aa1ffcc0aea1b212c69787391783af27df15ae9d, PR #5), which is NOT published on npm, so it is
# built from the public source at that exact commit. The fix routes local execution through
# execFile(magerunBin, args) instead of exec(shellString), removing the shell injection.
FROM node:20.18-bookworm-slim@sha256:ffc11dbf16dd0abcbb7b837410601b4d5592db2d03741e13a4a5336ab74d7ccb

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates php-cli git \
    && rm -rf /var/lib/apt/lists/*

# n98-magerun2, the real program executeMagerun2Command shells out to. The server documentation
# names no magerun2 channel or version, so the latest release the project published applies:
# 10.1.0 (github.com/netz98/n98-magerun2/releases, 2026-10-07), its release phar pinned by sha256.
ARG MAGERUN2_SHA256=76c931312f3ab6a5a5e1dbd40544cf43f9ecab176bca6a3597ebf4a3413fe270
RUN curl -fsSL https://github.com/netz98/n98-magerun2/releases/download/10.1.0/n98-magerun2.phar \
        -o /usr/local/bin/magerun2 \
    && echo "${MAGERUN2_SHA256}  /usr/local/bin/magerun2" | sha256sum -c - \
    && chmod +x /usr/local/bin/magerun2

# Real source at the pinned fix commit, built with the project's own tsc.
RUN git clone https://github.com/elgentos/magento2-dev-mcp.git /app \
    && cd /app \
    && git checkout aa1ffcc0aea1b212c69787391783af27df15ae9d \
    && npm install \
    && npm run build

ENTRYPOINT ["node", "/app/dist/index.js"]

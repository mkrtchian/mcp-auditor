# The jenkins backend of hekmon8/Jenkins-server-mcp: the real Jenkins controller, the 2.580.2 LTS
# from the project's official image, pinned by its index digest. It replaces the earlier HTTP
# responder (the image keeps its name): Jenkins runs within the backend's memory bound and needs no
# capability, so no part of it is a stand-in. It is NOT the server under test and carries none of
# its flaw.
# The job, the account and the first build are made by Jenkins itself at image build time. The base
# image declares JENKINS_HOME a volume, so what a RUN writes there is discarded: Jenkins runs once
# on it, its content then moves to the image's reference directory, which the image's jenkins.sh
# copies into the fresh JENKINS_HOME at every container start, so each container starts from this
# seed. An init script creates the account the server's documentation asks for (JENKINS_USER,
# JENKINS_TOKEN) with a fixed API token, the private realm and the logged-in authorization, and
# the freestyle job MyJob with Jenkins's default configuration, then one build is triggered through
# the REST API as that user. The init script is removed before the layer ends.
# At run time Jenkins starts on its default port 8080 as the image's own user, the setup wizard off.
# No COPY/ADD: everything is inline.
FROM jenkins/jenkins:2.580.2-lts-jdk21@sha256:74401de6a6f92e1afe1b02d1c8e3d0c33f263bfb5275dd8813f9150355f2367b
ARG JENKINS_API_TOKEN=11794c0bdb7038b17e9411596ab682d0c0
ENV JAVA_OPTS=-Djenkins.install.runSetupWizard=false
RUN <<'EOF'
set -eu
export JENKINS_HOME=/var/jenkins_home
mkdir -p "$JENKINS_HOME/init.groovy.d"
cat > "$JENKINS_HOME/init.groovy.d/account.groovy" <<'GROOVY'
import hudson.model.FreeStyleProject
import hudson.security.FullControlOnceLoggedInAuthorizationStrategy
import hudson.security.HudsonPrivateSecurityRealm
import jenkins.model.Jenkins
import jenkins.security.ApiTokenProperty

def jenkins = Jenkins.get()
def realm = new HudsonPrivateSecurityRealm(false)
def user = realm.createAccount('admin', UUID.randomUUID().toString())
user.getProperty(ApiTokenProperty).getTokenStore().addFixedNewToken('jenkins-server-mcp', System.getenv('JENKINS_API_TOKEN'), null)
user.save()
jenkins.setSecurityRealm(realm)
def strategy = new FullControlOnceLoggedInAuthorizationStrategy()
strategy.setAllowAnonymousRead(false)
jenkins.setAuthorizationStrategy(strategy)
jenkins.createProject(FreeStyleProject, 'MyJob')
jenkins.save()
GROOVY
java $JAVA_OPTS -jar /usr/share/jenkins/jenkins.war --httpPort=8080 &
pid=$!
n=0
until curl -fs -o /dev/null http://localhost:8080/login; do n=$((n+1)); [ "$n" -lt 150 ]; sleep 2; done
curl -fsS -X POST -u "admin:$JENKINS_API_TOKEN" http://localhost:8080/job/MyJob/build
n=0
until grep -qs '<result>' "$JENKINS_HOME/jobs/MyJob/builds/1/build.xml"; do n=$((n+1)); [ "$n" -lt 150 ]; sleep 2; done
kill "$pid"
while kill -0 "$pid" 2>/dev/null; do sleep 1; done
rm -r "$JENKINS_HOME/init.groovy.d"
cp -a "$JENKINS_HOME/." /usr/share/jenkins/ref/
find "$JENKINS_HOME" -mindepth 1 -delete
EOF

# Patched target for the nuisance fix-check of CVE-2026-57442, and the nuisance run image: @bitbonsai/mcpvault 0.11.5, the
# first version whose PathFilter deny-list matches .git / .obsidian / node_modules at any path
# segment, not only when root-anchored.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN npm install -g @bitbonsai/mcpvault@0.11.5

# The nuisance run's vault, holding the one note its benign calls read. The launch names it as the
# vault argument; the fix check mounts its own vault over it.
RUN mkdir -p /vault && printf 'hello\n' > /vault/welcome.md

ENTRYPOINT ["mcpvault"]

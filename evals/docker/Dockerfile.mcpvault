# Patched target for the nuisance fix-check of CVE-2026-57442, and the nuisance run image: @bitbonsai/mcpvault 0.11.5, the
# first version whose PathFilter deny-list matches .git / .obsidian / node_modules at any path
# segment, not only when root-anchored.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN npm install -g @bitbonsai/mcpvault@0.11.5

# The run's vault is Obsidian's published sample vault (the Sandbox vault of obsidianmd/obsidian-help),
# taken whole at a pinned commit. The launch names it as the vault argument, and the run user owns it
# as a user owns their own vault, so the note-editing tools can write. The fix check mounts its own
# vault over it.
ADD --checksum=24a31567c8a124aaaf95192fa49683bd35305dde --chown=65534:65534 --keep-git-dir=false \
    https://github.com/obsidianmd/obsidian-help.git#24a31567c8a124aaaf95192fa49683bd35305dde:Sandbox /vault

ENTRYPOINT ["mcpvault"]

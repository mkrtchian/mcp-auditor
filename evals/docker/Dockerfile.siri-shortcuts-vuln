# mcp-server-siri-shortcuts v1.1.0 (git tag 1.1.0) - vulnerable to CVE-2026-0758: shortcuts.ts's
# runShortcut builds `shortcuts run '${params.name}' ... | cat` and runs it with the shell `exec`,
# interpolating the caller's shortcut name into a single-quoted argument without escaping, so a
# name that closes the quote injects arbitrary shell commands whose output is reflected in the
# tool's own response.
# No COPY/ADD: the fingerprint hashes instructions only, so the `shortcuts` stub is inlined by RUN.
FROM node:20@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5
RUN git clone --depth 1 --branch 1.1.0 \
      https://github.com/dvcrn/mcp-server-siri-shortcuts.git /app
WORKDIR /app
RUN npm install && npm run build

# A stubbed `shortcuts` CLI on PATH: the real binary is macOS-only (Shortcuts.app), so the
# benign call answers with no external backend. `run` echoes a plausible confirmation line;
# every other subcommand (and the startup `list --show-identifiers`) exits 0 with no output.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'if [ "$1" = "run" ]; then' \
  '  echo "Shortcut ran: $2"' \
  'fi' \
  'exit 0' \
  > /usr/local/bin/shortcuts \
 && chmod +x /usr/local/bin/shortcuts

ENTRYPOINT ["node", "/app/dist/index.js"]

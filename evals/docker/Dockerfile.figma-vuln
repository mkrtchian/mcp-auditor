# figma-developer-mcp pinned at 0.6.2 (vulnerable 0.6.2, curl-fallback shell injection in get_figma_data), a nuisance fixture for CVE-2025-15061
# (command injection in get_figma_data's curl fallback). NOT an acceptance service. Source is
# installed by RUN from the pinned npm version (no COPY/ADD). The server reaches api.figma.com, which
# the fix check serves by a stand-in under its real name (the planting host's public names); the
# fixture authority is mounted at launch and trusted through NODE_EXTRA_CA_CERTS (the Node fetch)
# and CURL_CA_BUNDLE (the curl fallback). curl is present for the server's fetch fallback.
# The launch is the README's: the key on --figma-api-key and the stdio transport on --stdio.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN apk add --no-cache curl && npm install -g figma-developer-mcp@0.6.2

ENTRYPOINT ["figma-developer-mcp"]

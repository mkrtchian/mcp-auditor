# figma-developer-mcp pinned at 0.6.2 (vulnerable 0.6.2, curl-fallback shell injection in get_figma_data), a nuisance fixture for CVE-2025-15061
# (command injection in get_figma_data's curl fallback). NOT an acceptance service. Source is
# installed by RUN from the pinned npm version (no COPY/ADD). The responder's public cert is
# baked at /ca.pem; the Node server trusts it through NODE_EXTRA_CA_CERTS and the curl child
# through CURL_CA_BUNDLE, both carried on the server's docker run by figma_network_args. curl is
# present for the server's fetch fallback. The server opens its stdio transport only with --stdio
# on argv (carried in the launch) and exits at startup without FIGMA_API_KEY (carried as an env).
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN apk add --no-cache curl && npm install -g figma-developer-mcp@0.6.2

RUN echo '' | base64 -d > /ca.pem

ENTRYPOINT ["figma-developer-mcp"]

# Vulnerable @coding-solo/godot-mcp, built from the real source at the pre-fix commit 90b907a
# (package version 0.1.0; executeOperation still interpolates projectPath into an exec() shell
# string), with the real Godot 4.4.1 it drives.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates wget unzip \
      libfontconfig1 libfreetype6 libx11-6 libxcursor1 libxinerama1 libxi6 \
      libxrandr2 libxext6 libgl1 libglu1-mesa libasound2 libpulse0 libudev1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone https://github.com/Coding-Solo/godot-mcp.git . \
 && git checkout 90b907a472e343eb3807a49cb13f82e4c7b12731
RUN npm install && npm run build

RUN wget -q https://github.com/godotengine/godot/releases/download/4.4.1-stable/Godot_v4.4.1-stable_linux.x86_64.zip -O /tmp/godot.zip \
 && unzip -q /tmp/godot.zip -d /tmp/godot \
 && mv /tmp/godot/Godot_v4.4.1-stable_linux.x86_64 /usr/local/bin/godot \
 && chmod 0755 /usr/local/bin/godot \
 && rm -rf /tmp/godot.zip /tmp/godot

# A plain writable Godot project the exploits' first create_scene call writes into. It lives
# outside /work, which the planting code covers with a per-launch tmpfs.
RUN mkdir -p /opt/base-project \
 && printf 'config_version=5\n\n[application]\n\nconfig/name="Platformer"\nconfig/features=PackedStringArray("4.4")\n' > /opt/base-project/project.godot \
 && chmod -R 0777 /opt/base-project

ENTRYPOINT ["node", "/app/build/index.js"]

# The HTTPS front of httpbin, under the name the gateway's REST tool calls (httpbin.org). Like the
# real host it answers on 443 and on plain HTTP (80), where it does not redirect. It forwards the
# request's Host, scheme and client address, the scheme in X-Forwarded-Proto, which httpbin reads to
# mark its cookies Secure behind a TLS-terminating proxy (postmanlabs/httpbin, "fix: mark cookies
# Secure behind a TLS-terminating proxy"). The name's leaf and key
# (evals/stand_ins/tls/httpbin.org.pem, httpbin.org-key.pem) are mounted per launch under
# /etc/nginx/tls, never built in. nginx-unprivileged runs as uid 101 and binds 80 and 443 with no
# capability (a container's net.ipv4.ip_unprivileged_port_start is 0).
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
RUN cat > /etc/nginx/conf.d/default.conf <<'CONF'
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name httpbin.org;
    ssl_certificate /etc/nginx/tls/httpbin.org.pem;
    ssl_certificate_key /etc/nginx/tls/httpbin.org-key.pem;
    location / {
        proxy_pass http://httpbin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
CONF

# Patched: mcp-neo4j-cypher 0.6.0, which replaces the <0.6.0 keyword-regex read_only gate with an
# EXPLAIN query_type classification, so a write-mode CALL procedure (apoc.cypher.doIt) is classified
# 'rw' and rejected under --read-only (CVE-2026-35402). Doubles as the nuisance run image.
# The run path reaches the neo4j backend by its alias (neo4j_backend.NEO4J_HOST) over bolt from the
# baked ENV; the fix-check overrides NEO4J_URI by -e. --read-only is appended by the launch.
# Default transport is stdio. No COPY/ADD from the build context.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN pip install --no-cache-dir "mcp-neo4j-cypher==0.6.0"
ENV NEO4J_URI=bolt://neo4j:7687 NEO4J_USERNAME=neo4j NEO4J_PASSWORD=testpassword
ENTRYPOINT ["mcp-neo4j-cypher"]

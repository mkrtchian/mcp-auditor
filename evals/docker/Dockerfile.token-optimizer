# @ooples/token-optimizer-mcp 5.1.1, the first npm release carrying the CVE-2026-55157 fix
# (smart_user runs argv-mode execFileSafe). The advisory names 5.1.0, which is a git tag only.
# Installed globally as the README says (npm install -g). CI=true is scoped to the install step:
# it is the README's documented way to skip the postinstall hook installer, and the server never
# reads it, so it stays out of the server's environment.
# Base: node:24-trixie, the current Node.js LTS on Debian 13 (trixie), the current Debian stable.
# smart_user drives the distribution's getent (libc-bin) and id (coreutils); the image's toolchain
# compiles better-sqlite3 when no prebuilt binary fits. No COPY/ADD.
FROM node:24-trixie@sha256:5c6e2e57d7dd6652ce6f087ba0328312059d7c77f93baa8751865dbf103f1acb
RUN CI=true npm install -g @ooples/token-optimizer-mcp@5.1.1
# Session data get_session_stats reads under $HOME (HOME=/tmp at launch). The hooks write it only
# during a Claude Code session, so it comes from the project's own documents at tag v5.1.1
# (commit 687b55460d752fa4ee011c58535c733191b831c8): current-session.txt is the README's
# "Session Tracking Files" format block with its // annotations removed (JSON.parse rejects
# them), and the session log is the six event lines of docs/SESSION_LOG_SPEC.md, whole, under
# the file name the server derives from that session id.
RUN mkdir -p /tmp/.claude-global/hooks/data && cat > /tmp/.claude-global/hooks/data/current-session.txt <<'EOF'
{
  "sessionId": "abc-123",
  "sessionStart": "20251031-082211",
  "totalOperations": 1250,
  "totalTokens": 184000,
  "lastOptimized": 1698765432,
  "savings": {
    "totalTokensSaved": 125430,
    "tokenReductionPercent": 68.2,
    "originalTokens": 184000,
    "optimizedTokens": 58570,
    "cacheHitRate": 42.5,
    "compressionRatio": 0.32,
    "lastUpdated": "20251031-092500"
  }
}
EOF
RUN cat > /tmp/.claude-global/hooks/data/session-log-abc-123.jsonl <<'EOF'
{"type":"session_start","sessionId":"20251013-083016-9694","timestamp":"2025-10-13 08:30:16","contextWindowLimit":200000}
{"type":"tool_call","turn":1,"toolName":"Read","phase":"PreToolUse","timestamp":"2025-10-13 08:30:20","estimatedTokens":5000,"filePath":"C:\\path\\to\\file.ts"}
{"type":"tool_result","turn":1,"toolName":"Read","phase":"PostToolUse","timestamp":"2025-10-13 08:30:22","duration_ms":2150,"actualTokens":4950,"filePath":"C:\\path\\to\\file.ts"}
{"type":"hook_execution","turn":1,"hookName":"user-prompt-submit","timestamp":"2025-10-13 08:30:25","output":"Analyzing changes...","duration_ms":150,"estimated_tokens":50}
{"type":"system_reminder","turn":2,"timestamp":"2025-10-13 08:31:00","content":"<system-reminder>...</system-reminder>","tokens":1500}
{"type":"session_end","sessionId":"20251013-083016-9694","timestamp":"2025-10-13 09:15:30","totalTokens":125000,"totalTurns":45,"duration":"45m 14s"}
EOF
RUN chown -R 65534:65534 /tmp/.claude-global
ENTRYPOINT ["/usr/local/bin/token-optimizer-mcp"]

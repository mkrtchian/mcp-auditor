# @ooples/token-optimizer-mcp 5.1.1, the first npm release carrying the CVE-2026-55157 fix
# (smart_user runs argv-mode execFileSafe). The advisory names 5.1.0, which is a git tag only.
# node:20-bookworm ships the python3 and C++ toolchain better-sqlite3 compiles with. No COPY/ADD.
FROM node:20-bookworm
ENV CI=true
WORKDIR /app
RUN npm init -y >/dev/null 2>&1 \
 && npm install @ooples/token-optimizer-mcp@5.1.1 >/dev/null 2>&1
ENTRYPOINT ["node", "/app/node_modules/@ooples/token-optimizer-mcp/dist/server/index.js"]

# codehooks-mcp-server (CVE-2025-53100), vulnerable git tag v0.2.1 (commit 785b0d7e). The package
# is private and never published to npm; package.json reads 0.1.0 at both v0.2.1 and v0.2.2, so
# the fix is pinned by git tag (GHSA-fhq6-jf5q-qxvq: "This issue has been patched in version
# 0.2.2"). query_collection builds a shell command line from its arguments and runs it through
# child_process.exec. Fix check only, never a run. Same setup as the run image
# (Dockerfile.codehooks): the real Codehooks CLI, the hosts it calls served under their real
# names by the check's stand-ins. No COPY/ADD from the build context. The server's lock file is
# kept, so `npm install` honours it.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g codehooks@1.3.3
# deploy_code runs `npm install` on a package.json that depends on codehooks-js before `coho deploy`
# compiles it: the npm cache of the run user (HOME=/tmp) holds codehooks-js, the stable release of
# the build day, and its dependencies, since the run reaches no registry and npm falls back to its
# cache when the registry cannot be reached.
RUN mkdir /tmp/codehooks-js-cache && cd /tmp/codehooks-js-cache && npm init -y >/dev/null \
 && HOME=/tmp npm install codehooks-js@1.4.14 \
 && cd / && rm -rf /tmp/codehooks-js-cache && chown -R 65534:65534 /tmp/.npm
WORKDIR /app
RUN git clone --depth 1 --branch v0.2.1 https://github.com/RestDB/codehooks-mcp-server.git /app \
 && test "$(git -C /app rev-parse HEAD)" = 785b0d7e2dd9c272fb65712750474f8aaf2eb025 \
 && npm install \
 && chmod -R a+rX /app

ENV NODE_ENV=production \
    CODEHOOKS_PROJECT_NAME=petsdb-5544 \
    CODEHOOKS_SPACE=dev \
    CODEHOOKS_ADMIN_TOKEN=7c1e4b9a-3d2f-4a86-b0e5-91f2c6d8a437

ENTRYPOINT ["node", "/app/build/index.js"]

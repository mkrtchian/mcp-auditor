# Run image of aws-api-mcp, pinning the admission's patched version,
# awslabs.aws-api-mcp-server 1.3.9. The server pins the AWS CLI it drives (awscli==1.44.37 in its
# own requirements), so pip installs that release with it. Its other dependencies stay floating,
# bounded only by mcp<2: mcp 2.x drops mcp.shared.exceptions.McpError, which 1.3.9 imports at
# start (core/aws/service.py line 45), and its requirement mcp>=1.23.0 carries no upper bound.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

RUN pip install --no-cache-dir "awslabs.aws-api-mcp-server==1.3.9" "mcp<2"

# The server's documented stdio configuration (README, Installation Methods) sets AWS_REGION.
ENV AWS_REGION=us-east-1

ENTRYPOINT ["awslabs.aws-api-mcp-server"]

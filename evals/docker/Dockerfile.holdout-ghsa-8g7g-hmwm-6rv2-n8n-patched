# Patched n8n-mcp (2.50.1): the trigger handlers set maxRedirects: 0, so a validated
# webhook/form/chat URL no longer follows a redirect to an internal host
# (GHSA-8g7g-hmwm-6rv2). The real package is installed from npm, unmodified.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

RUN npm install -g n8n-mcp@2.50.1 \
    && npm cache clean --force

ENTRYPOINT ["n8n-mcp"]

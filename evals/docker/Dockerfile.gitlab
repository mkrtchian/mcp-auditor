# Patched: @zereight/mcp-gitlab 2.1.38, the version whose encodeGitLabPathSegment encodes the raw
# jobId in the pipeline-job request paths (fix commit e2a81a0), so a traversal in job_id no longer
# escapes /jobs/. Doubles as the nuisance run image. No COPY/ADD from the build context; the
# install is a RUN fetch from npm.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
RUN npm install -g @zereight/mcp-gitlab@2.1.38
# GITLAB_API_URL: the self-managed GitLab instance the README's GITLAB_API_URL row names ("Your
# GitLab instance API URL"), here the gitlab backend's stand-in, reached by the network alias
# gitlab.example.com (the host GitLab's API documentation uses for a self-managed instance). The
# fix check overrides it with its own -e to reach its per-launch responder.
# GITLAB_PERSONAL_ACCESS_TOKEN: required to start (index.js exits without a credential); its value
# is the README's docker example value.
# GITLAB_TOOLSETS=all: the launch option the fix needs, enabling the non-default pipelines toolset.
ENV GITLAB_API_URL=http://gitlab.example.com/api/v4 GITLAB_PERSONAL_ACCESS_TOKEN=your_gitlab_token GITLAB_TOOLSETS=all
ENTRYPOINT ["mcp-gitlab"]

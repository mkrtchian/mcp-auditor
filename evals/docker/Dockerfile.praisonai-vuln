# praisonai 4.6.33, last version before either the CVE-2026-44336 or the CVE-2026-47394 fix
# (rules.show's rule_name and workflow.show's file_path both join onto their base directory
# with no containment check). Real pinned software from PyPI, no stand-in. mcp is pinned below 2.0
# because the server's FastMCP-era API is v1-only and PyPI's default resolution of praisonai's
# unbounded "mcp>=1.20.0" picks the incompatible v2 line otherwise (confirmed: `mcp.server.
# fastmcp` was renamed in mcp 2.x). Base pinned by digest for cross-machine reproducibility
# (python:3.12-slim). No COPY/ADD: the fingerprint hashes instructions only, so the seeds the
# benign calls read are written by RUN. The server is started by calling
# praisonai.mcp_server.cli.handle_mcp_command directly, not through the `praisonai` console
# script: `praisonai serve mcp --transport stdio` writes informational lines to stdout before
# the JSON-RPC stream starts (corrupting it), and `praisonai mcp serve` is swallowed by a Typer
# "mcp" command group that has no "serve" subcommand in this version.
FROM python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN pip install --no-cache-dir "praisonai==4.6.33" "mcp>=1.20.0,<2"

# Seeds, taken whole from the sources the two ARG lines pin: /agents.yaml is the README's first
# agents.yaml sample (Using YAML (No Code), Example 1), in the working directory where
# workflow.show resolves it; /tmp/.praison/rules/python.md is the rules page's python.md
# rule file as it lives on disk, taken whole, in the rules directory rules.show reads
# (~/.praison/rules, HOME=/tmp). A build argument stays out of the server's environment.
ARG AGENTS_SAMPLE=MervinPraison/PraisonAI@a72e156c4d01ef06c64529d302c21381d6485716:README.md#L405-L417
ARG RULES_DOCUMENT=MervinPraison/PraisonAIDocs@bba9a51a6669db7b12004785539c051b9d3e109e:docs/features/rules.mdx#L344-L348
RUN printf '%s\n' \
    'framework: praisonai' \
    'topic: "Write a blog post about AI"' \
    '' \
    'agents:' \
    '  researcher:' \
    '    role: Research Analyst' \
    '    goal: Research AI trends and gather information' \
    '    instructions: "Find accurate information about AI trends"' \
    '    ' \
    '  writer:' \
    '    role: Content Writer' \
    '    goal: Write engaging blog posts' \
    '    instructions: "Write clear, engaging content based on research"' \
    > /agents.yaml \
 && chmod a+r /agents.yaml
RUN mkdir -p /tmp/.praison/rules \
 && printf '%s\n' \
    '---' \
    'activation: glob' \
    'globs: ["**/*.py"]' \
    '---' \
    'Use type hints on every function and method.' \
    > /tmp/.praison/rules/python.md \
 && chmod -R a+rX /tmp/.praison

ENTRYPOINT ["python3", "-c", "from praisonai.mcp_server.cli import handle_mcp_command; import sys; sys.exit(handle_mcp_command(['serve', '--transport', 'stdio']))"]

# CVE-2025-11489 vulnerable image: @wonderwhy-er/desktop-commander@0.2.32 (last vulnerable
# version; the symlink scope-bypass fix a1177ec / PR #321 lands in 0.2.33). The real npm package,
# no reimplementation. validatePath runs isPathAllowed on the unresolved path, then fs.realpath,
# so an in-scope symlink to an out-of-scope target is followed and read by read_file.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

# --ignore-scripts: skip the setup-claude-server postinstall (it edits the host Claude config and
# is irrelevant to the server). The published package already ships the built dist/.
RUN npm install -g --ignore-scripts @wonderwhy-er/desktop-commander@0.2.32 \
 && test -f /usr/local/lib/node_modules/@wonderwhy-er/desktop-commander/dist/index.js

# getAllowedDirs reads config.allowedDirectories from $HOME/.claude-server-commander/config.json;
# loadConfig REPLACES getDefaultConfig (no merge), so the file must carry the full default config.
# This is getDefaultConfig() verbatim with the single change allowedDirectories=["/srv/app"] (the
# deployment-layout scope): an empty/absent list fails open (isPathAllowed returns true), which
# would void the scope check. HOME is forced to /tmp by the launch (unprivileged_user_args:
# --user 65534:65534 -e HOME=/tmp), so the config lives at /tmp/.claude-server-commander/config.json.
RUN mkdir -p /tmp/.claude-server-commander \
 && printf '%s' '{"blockedCommands":["mkfs","format","mount","umount","fdisk","dd","parted","diskpart","sudo","su","passwd","adduser","useradd","usermod","groupadd","chsh","visudo","shutdown","reboot","halt","poweroff","init","iptables","firewall","netsh","sfc","bcdedit","reg","net","sc","runas","cipher","takeown"],"allowedDirectories":["/srv/app"],"telemetryEnabled":true,"fileWriteLineLimit":50,"fileReadLineLimit":1000,"pendingWelcomeOnboarding":true}' \
      > /tmp/.claude-server-commander/config.json \
 && chmod -R 0777 /tmp/.claude-server-commander

ENTRYPOINT ["node", "/usr/local/lib/node_modules/@wonderwhy-er/desktop-commander/dist/index.js"]

# Internal-service sentinel: writes $FLAG (supplied via -e FLAG=...) to a file and serves it
# over HTTP on port 80. SERVE_FILE names that file under the doc root (default /index.html),
# computed by the harness (`served_file`) as the file httpd maps the planted path to; BIND_ADDR
# chooses the bind address (default every address). It is never spoken to over MCP stdio: a
# fetch-style server reaches it, or the planting layer serves it inside a namespace holder the
# target joins.
# Base pinned by digest for cross-machine reproducibility (busybox).
FROM busybox:latest@sha256:fd8d9aa63ba2f0982b5304e1ee8d3b90a210bc1ffb5314d980eb6962f1a9715d

# Write the runtime FLAG at SERVE_FILE under the doc root as given (the harness has already
# stripped the query and fragment, decoded the escapes and mapped a trailing slash to
# index.html), then serve it in the foreground, bound to BIND_ADDR:80 when given, every
# address otherwise.
ENTRYPOINT ["sh", "-c", "p=\"${SERVE_FILE:-/index.html}\"; mkdir -p \"/www$(dirname \"$p\")\" && printf '%s' \"$FLAG\" > \"/www$p\" && if [ -n \"${BIND_ADDR:-}\" ]; then exec httpd -f -p \"$BIND_ADDR:80\" -h /www; else exec httpd -f -p 80 -h /www; fi"]

# Internal-service sentinel: writes $FLAG (supplied via -e FLAG=...) to a file and serves it
# over HTTP on port 80. SERVE_PATH chooses the served path (default the root, as index.html);
# BIND_ADDR chooses the bind address (default every address). It is never spoken to over MCP
# stdio: a fetch-style server reaches it, or the planting layer serves it inside a namespace
# holder the target joins.
# Base pinned by digest for cross-machine reproducibility (busybox).
FROM busybox:latest@sha256:fd8d9aa63ba2f0982b5304e1ee8d3b90a210bc1ffb5314d980eb6962f1a9715d

# Write the runtime FLAG at SERVE_PATH under the doc root, then serve it in the foreground,
# bound to BIND_ADDR:80 when given, every address otherwise. SERVE_PATH is normalised before
# the write so the file httpd maps a request to exists: the query string and fragment are
# stripped (httpd drops them when mapping a request to a file), and a trailing slash becomes
# that directory's index.html (httpd serves index.html for a directory request).
ENTRYPOINT ["sh", "-c", "p=\"${SERVE_PATH:-/index.html}\"; p=\"${p%%\\?*}\"; p=\"${p%%#*}\"; case \"$p\" in */) p=\"${p}index.html\";; esac; mkdir -p \"/www$(dirname \"$p\")\" && printf '%s' \"$FLAG\" > \"/www$p\" && if [ -n \"${BIND_ADDR:-}\" ]; then exec httpd -f -p \"$BIND_ADDR:80\" -h /www; else exec httpd -f -p 80 -h /www; fi"]

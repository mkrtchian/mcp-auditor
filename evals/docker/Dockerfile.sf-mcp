# Nuisance run image of sf-mcp: a copy of Dockerfile.holdout-2026-26029-sf-mcp-patched, instructions unchanged,
# pinning the admission's patched version, commit 99fba0171b8c22b5ee3c0405053ccfd2910a066d.

# sf-mcp-server, patched build (CVE-2026-26029).
# Identical to Dockerfile.holdout-2026-26029-sf-mcp except for the checked-out commit: 99fba01 is the fix that replaces
# exec(sfCommand) with execFile("sf", args), so query_records no longer spawns a shell.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN printf '#!/bin/sh\nprintf '\''{"result":{"records":[]}}'\''\n' > /usr/local/bin/sf \
    && chmod 755 /usr/local/bin/sf

WORKDIR /app
RUN git clone https://github.com/akutishevsky/sf-mcp-server.git . \
    && git checkout 99fba0171b8c22b5ee3c0405053ccfd2910a066d \
    && npm ci \
    && npm run build

ENTRYPOINT ["node", "/app/build/index.js"]

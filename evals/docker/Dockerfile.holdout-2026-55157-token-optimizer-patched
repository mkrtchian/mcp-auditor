# Patched server: @ooples/token-optimizer-mcp 5.1.0 (first patched version per the advisory,
# commit b4ee96d + release). npm skipped publishing 5.1.0, so it is built from the real public
# source at the v5.1.0 git tag. smart_user now runs argv-mode execFileSafe + assertSafeArg.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

ENV CI=true
WORKDIR /opt/token-optimizer-mcp

# Toolchain for the better-sqlite3 native build and for tsc; curl to fetch the tagged source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ ca-certificates curl \
    && curl -fsSL https://codeload.github.com/ooples/token-optimizer-mcp/tar.gz/refs/tags/v5.1.0 \
       | tar -xz --strip-components=1 \
    && npm install \
    && npm run build \
    && apt-get purge -y make g++ curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Absolute path: the launch sets -w /srv (read-only), so a relative entrypoint would not resolve.
ENTRYPOINT ["node", "/opt/token-optimizer-mcp/dist/server/index.js"]

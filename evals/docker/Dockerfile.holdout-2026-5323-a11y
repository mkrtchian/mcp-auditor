# CVE-2026-5323 (GHSA-prmx-7v35-7q82): SSRF in a11y-mcp < 1.0.5.
# audit_webpage / get_summary pass args.url straight to Puppeteer page.goto with no
# validation, so a caller can make the server's headless Chrome fetch any internal address.
# Vulnerable version pinned: 1.0.4 (the release just before the fix commit e3e11c9).
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

# Use Debian's Chromium as the Puppeteer engine (skip Puppeteer's own Chrome download):
# a11y-mcp calls puppeteer.launch() with no executablePath, so it reads this env var.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium ca-certificates fonts-liberation libnss3-tools \
    && rm -rf /var/lib/apt/lists/*

# Trust the stand-ins' fixture authority where Chromium reads it on Linux: the per-user NSS
# database at $HOME/.pki/nssdb (HOME=/tmp for the unprivileged account), not an environment
# variable (Chromium ignores SSL_CERT_FILE / NODE_EXTRA_CA_CERTS for page.goto). The authority
# is inlined, not COPYed, so it stays in the instruction fingerprint; it must equal
# evals/stand_ins/tls/fixture-authority.pem (a unit test checks it), so a regeneration rebuilds
# this image. certutil is from libnss3-tools. The store belongs to account 65534, which reads it
# at launch.
RUN mkdir -p /tmp/.pki/nssdb \
 && cat > /tmp/fixture-authority.pem <<'AUTHORITY_EOF' \
 && certutil -d sql:/tmp/.pki/nssdb -A -n 'Local Root CA' -t 'C,,' -i /tmp/fixture-authority.pem \
 && rm -f /tmp/fixture-authority.pem \
 && chown -R 65534:65534 /tmp/.pki

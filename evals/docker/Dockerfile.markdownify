# Nuisance run image of markdownify: a copy of Dockerfile.holdout-2025-58358-markdownify-patched,
# its instructions unchanged but for uv pinned at the holdout card's release, with the programs
# markitdown drives and the sample it converts added before its entrypoint. Pins the admission's patched version, commit a31204de058b.

# mcp-markdownify-server, patched for CVE-2025-58358. Pinned to commit a31204d ("Advisory
# fix 1"), the first version that fixes the command injection: _markitdown now uses
# child_process.execFile with an argument array (no shell). This is the advisory's
# "0.0.2" (the fix was merged but never published under that number; npm jumps 0.0.1 -> 1.0.0).
# By this commit the two sibling flaws are already fixed as well (URL validation / is_ip_private
# for SSRF, and a Markdown-extension check for get-markdown-file), both merged 2025-05-07.
FROM node:22-bookworm@sha256:18a6d90fd60542269850c80ca03b29b1d9b14d6b221ac7ee8e35b0d33ef904bd

# uv at the release the holdout card records (0.13.7), through its own installer as the server's
# setup.sh installs it, the installer pinned by its release checksum.
ADD --checksum=sha256:d263ee68314cf5bea36b08e6bd9e2c4563240d7adb73756cf33af5c199b92db4 \
    https://github.com/astral-sh/uv/releases/download/0.13.7/uv-installer.sh /usr/src/uv-installer.sh
RUN env UV_INSTALL_DIR=/usr/local/bin sh /usr/src/uv-installer.sh && rm /usr/src/uv-installer.sh

WORKDIR /app
RUN git clone https://github.com/zcaceres/markdownify-mcp.git . \
 && git checkout a31204de058b

# Drop the broken devDependencies metadata, install the real runtime deps from package.json
# (this commit adds private-ip, used by the SSRF fix in server.ts), then add the TypeScript
# toolchain (unsaved) to compile src -> dist.
RUN npm pkg delete devDependencies \
 && npm install --ignore-scripts --no-audit --no-fund \
 && npm install --ignore-scripts --no-audit --no-fund --no-save typescript@5 shx@0.3 @types/node@22
RUN npx tsc && npx shx chmod +x dist/*.js

RUN uv sync
ENV UV_PATH=/usr/local/bin/uv

# ffmpeg: the runtime dependency markitdown's own Dockerfile installs from its distribution
# (microsoft/markitdown v0.0.1a3, "apk add --no-cache ffmpeg"), here the base distribution's
# package. pydub, imported by markitdown, needs it on the PATH for markitdown to enable audio.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg=7:5.1.9-0+deb12u1 \
 && rm -rf /var/lib/apt/lists/*

# ExifTool, which markitdown runs for image and audio metadata (its tests' exiftool case), at
# the latest production release, installed as exiftool.org/install.html describes.
ADD --checksum=sha256:5f4c81d34ad406538c2871ad72dbfceb5d9b412b2f16cbbeb4d712d270846667 \
    https://sourceforge.net/projects/exiftool/files/Image-ExifTool-13.55.tar.gz/download /usr/src/Image-ExifTool-13.55.tar.gz
RUN cd /usr/src && tar -xzf Image-ExifTool-13.55.tar.gz \
 && cd Image-ExifTool-13.55 && perl Makefile.PL && make && make install \
 && cd /usr/src && rm -rf Image-ExifTool-13.55 Image-ExifTool-13.55.tar.gz

# markitdown's published test files, the repository taken whole at the first commit whose
# tests/test_files hold a sample of every format the six converters read.
RUN git init -q /opt/markitdown && cd /opt/markitdown \
 && git fetch -q --depth 1 https://github.com/microsoft/markitdown.git e921497f794e8f6a6cdf9872d2a29e187448c7eb \
 && git checkout -q FETCH_HEAD && rm -rf .git

ENTRYPOINT ["node", "/app/dist/index.js"]

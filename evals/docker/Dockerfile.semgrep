# mcp-server-semgrep (CVE-2026-7446), patched npm release 1.0.1. Every external call now uses
# execFile() with an argv array and file I/O uses fs.promises, so shell metacharacters in a path
# argument are passed verbatim and never reach a shell. Doubles as the nuisance run image. No
# COPY/ADD from the build context; the stub and the package are installed by RUN. The server
# declares @modelcontextprotocol/sdk as a devDependency, so it is installed explicitly (pinned to
# the lockfile's 1.32.2) on top of the prod deps.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

RUN printf '%s\n' '#!/bin/sh' \
  'if [ "$1" = "--version" ]; then echo "1.110.0"; exit 0; fi' \
  'echo "{\"results\":[]}"' \
  'exit 0' > /usr/local/bin/semgrep && chmod +x /usr/local/bin/semgrep

RUN mkdir -p /pkg /work \
 && cd /tmp \
 && npm pack mcp-server-semgrep@1.0.1 \
 && tar xzf mcp-server-semgrep-1.0.1.tgz -C /pkg --strip-components=1 \
 && rm -f mcp-server-semgrep-1.0.1.tgz \
 && cd /pkg && npm install --omit=dev --ignore-scripts \
 && npm install --ignore-scripts @modelcontextprotocol/sdk@1.32.2

RUN printf '{"results":[{"check_id":"demo.rule","path":"/work/a.js","start":{"line":1,"col":1},"end":{"line":1,"col":2},"extra":{"severity":"INFO","message":"demo finding","metadata":{"language":"javascript"}}}]}' > /work/results.json \
 && cp /work/results.json /work/old.json \
 && cp /work/results.json /work/new.json \
 && chmod -R 0777 /work

ENTRYPOINT ["node", "/pkg/build/index.js"]

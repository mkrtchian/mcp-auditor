# Nuisance run image of heim: a copy of Dockerfile.holdout-2026-5602-heim-patched, its instructions unchanged but for the cargo stub the run adds before its entrypoint,
# pinning the admission's patched version, commit c321d8af25f77668781e6ccb43a1336f9185df37 (abbreviated c321d8a below).

# Patched @nor2/heim-mcp, pinned to commit c321d8a, the execFile() fix for CVE-2026-5602
# (PR #2, "prevent command injection by replacing child_process.exec"). Still version 0.1.3:
# the fix did not bump the version, which is why the advisory lists no published patched
# release. Built from the real upstream source, identical build to the vulnerable image.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG HEIM_COMMIT=c321d8a
RUN curl -sfL "https://codeload.github.com/Nor2-io/heim-mcp/tar.gz/${HEIM_COMMIT}" \
    | tar xz --strip-components=1
RUN npm install && npm run build

RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/heim && chmod +x /usr/local/bin/heim
# new_heim_application builds the generated Rust application with cargo after `heim new`; the
# toolchain is stubbed like heim itself.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/cargo && chmod +x /usr/local/bin/cargo

ENTRYPOINT ["node", "/app/dist/index.js"]

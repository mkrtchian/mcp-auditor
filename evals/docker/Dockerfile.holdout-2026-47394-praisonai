 && rm /tmp/constraints.txt

# Launch the real MCP server over stdio at its module entrypoint. In this release the Typer
# front-end does not wire `praisonai mcp serve`, so the server is started through the real,
# installed handle_mcp_command (praisonai/mcp_server/cli.py -> MCPServerCLI.cmd_serve ->
# register_all -> MCPServer.run_stdio). This is the real pinned code path that registers
# praisonai.workflow.show and dispatches tools/call through the vulnerable _handle_tools_call.
# The deployment layout sets the working directory (the checkout /srv/app) with docker -w.
ENTRYPOINT ["python", "-c", "import sys; from praisonai.mcp_server.cli import handle_mcp_command; sys.exit(handle_mcp_command(['serve', '--transport', 'stdio']))"]

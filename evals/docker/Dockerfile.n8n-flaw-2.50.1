# n8n-mcp 2.50.1 for the nuisance fix-check: the patched arm of GHSA-8g7g-hmwm-6rv2 (the trigger
# handlers now set maxRedirects: 0) AND the vulnerable arm of CVE-2026-44694 (the API client axios
# instance still follows a redirect, fixed only in 2.50.2 with maxRedirects: 0). The fix-check
# builder points N8N_API_URL at its own stand-in at run time, so the image bakes no backend env.
# The real package is installed from npm, unmodified.
# No COPY/ADD: the fingerprint hashes instructions only.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

RUN npm install -g n8n-mcp@2.50.1 \
    && npm cache clean --force

ENTRYPOINT ["n8n-mcp"]

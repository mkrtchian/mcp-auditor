# scrapling-fetch-mcp (CVE-2026-81848), vulnerable PyPI release 0.2.2: s_fetch_page/s_fetch_pattern
# (mcp.py) pass the caller's url straight into scrapling's browse_url (_fetcher.py), which hands
# it to curl_cffi; curl_cffi honours file:// exactly as libcurl does, so url="file:///...witness"
# reads an arbitrary file the server's user can read and returns it as fetched page content: a
# read_outside_scope flaw, not the internal_fetch/SSRF-to-internal-address class the CVE's CWE-918
# tag suggests. A busybox-style static site (python http.server on loopback:8080) is baked in so
# the benign fetch has a same-image target, no separate service and no outbound network.
# No COPY/ADD from the build context; the package is installed from the PyPI registry by RUN.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN pip install --no-cache-dir "mcp<2" "scrapling-fetch-mcp==0.2.2"

RUN mkdir -p /srv/www \
 && printf '%s' '<html><body><h1>local test site</h1><p>benign fetch target</p></body></html>' > /srv/www/index.html \
 && chmod -R a+rX /srv/www

ENTRYPOINT ["sh", "-c", "python3 -m http.server 8080 --directory /srv/www >/dev/null 2>&1 & exec scrapling-fetch-mcp"]

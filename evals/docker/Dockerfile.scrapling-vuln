# scrapling-fetch-mcp (CVE-2026-81848), vulnerable PyPI release 0.2.2: s_fetch_page/s_fetch_pattern
# (mcp.py) pass the caller's url straight into scrapling's browse_url (_fetcher.py), which hands
# it to curl_cffi, with no scheme check: a read_outside_scope flaw. Same install and launch as the
# patched run image (Dockerfile.scrapling): the web page the fix check's benign calls fetch is a
# public host served under its real name by the stand-in, not a site baked in this image.
# "mcp<2": the server imports mcp.server.fastmcp, which mcp 2.x removed.
# No COPY/ADD from the build context; the package is installed from the PyPI registry by RUN.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN pip install --no-cache-dir "mcp<2" "scrapling-fetch-mcp==0.2.2"

ENTRYPOINT ["scrapling-fetch-mcp"]

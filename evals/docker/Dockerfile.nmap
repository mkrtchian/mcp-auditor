# Nuisance run image of nmap: the instructions of Dockerfile.holdout-2026-3484-nmap-patched,
# pinning the admission's patched version, commit 30a6b9e1c7fa6146f51e28d6ab83a2568d9a3488,
# and the Nmap release the holdout card records (7.993).

# Patched mcp-nmap-server: the fix commit for CVE-2026-3484 runs execFile('nmap', args) with no
# shell and validates additionalFlags.
FROM node@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential bzip2 \
    && rm -rf /var/lib/apt/lists/*

# The real nmap the server runs: Nmap 7.993 (nmap.org, 2026-10-23), the release the holdout card
# records, from the upstream source tarball, documented source install at its defaults
# (nmap.org/book/install.html: bzip2 -cd nmap-<ver>.tar.bz2 | tar xvf -; ./configure; make;
# make install). The sha256 is the one nmap.org publishes in dist/sigs/nmap-7.993.tar.bz2.digest.txt.
ARG NMAP_SHA256=270e55f04915bfcecb5db8feb959d4c5ba86a48c094520a4f1c07571e1c79c59
RUN curl -fsSL https://nmap.org/dist/nmap-7.993.tar.bz2 -o /tmp/nmap.tar.bz2 \
    && echo "${NMAP_SHA256}  /tmp/nmap.tar.bz2" | sha256sum -c - \
    && mkdir -p /tmp/nmapsrc \
    && bzip2 -cd /tmp/nmap.tar.bz2 | tar xf - -C /tmp/nmapsrc --strip-components=1 \
    && cd /tmp/nmapsrc \
    && ./configure \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/nmapsrc /tmp/nmap.tar.bz2

WORKDIR /app
# Real install of the pinned first-patched source.
RUN git clone https://github.com/PhialsBasement/nmap-mcp-server.git . \
    && git checkout 30a6b9e1c7fa6146f51e28d6ab83a2568d9a3488
# Pin zod-to-json-schema to the disclosure-era version (the package.json floor): later 3.25.x
# pulls zod v4, which conflicts with the SDK's zod v3 and breaks the original build. The code
# itself is untouched.
RUN npm install zod-to-json-schema@3.23.5 && npm install && npm run build

ENTRYPOINT ["node", "dist/index.js"]

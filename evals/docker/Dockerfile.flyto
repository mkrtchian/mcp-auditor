# flyto-core 2.28.0 (the shipped server, first fix of CVE-2026-73530), installed from PyPI.
# Base pinned by digest (python:3.12-slim). FLYTO_ALLOWED_HOSTS stays unset, its default in
# core/mcp_server.py. FLYTO_SANDBOX_DIR defaults to the working directory, and the run's working
# directory is /, where validate_path_safe (core/utils.py:1157) rejects every path because no
# path starts with "//": the variable the server's own warning names is set to the writable /tmp.
# The run_recipe call uses a recipe the package ships (recipes/json-to-csv.yaml): no file is added.
FROM python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN pip install --no-cache-dir "flyto-core==2.28.0"
ENV FLYTO_SANDBOX_DIR=/tmp
ENTRYPOINT ["python", "-m", "core.mcp_server"]

HEIM_DEPLOY_STDOUT_EOF
RUN cat > /usr/local/bin/heim <<'HEIM_STANDIN_EOF'
#!/bin/sh
case "$1" in
  deploy)
    if [ "$2" = "/opt/myapp" ]; then
        cat /usr/local/share/heim/deploy.stdout
        exit 0
    fi
    printf 'ERROR [ heim_cli::wasm::build ] could not build component: no component.toml found in the target path\n' >&2
    exit 1
    ;;
  *)
    printf 'error: unrecognized subcommand\n\nUsage: heim [OPTIONS] <COMMAND>\n\nFor more information, try '\''--help'\''.\n' >&2
    exit 2
    ;;
esac
HEIM_STANDIN_EOF
RUN chmod +x /usr/local/bin/heim

ENTRYPOINT ["node", "/app/dist/index.js"]

# Patched @nor2/heim-mcp, pinned to commit c321d8a, the execFile() fix for CVE-2026-5602
# (PR #2, "prevent command injection by replacing child_process.exec"). Still version 0.1.3:
# the fix did not bump the version, which is why the advisory lists no published patched
# release. Built from the real upstream source, identical build to the vulnerable image.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG HEIM_COMMIT=c321d8af25f77668781e6ccb43a1336f9185df37
RUN curl -sfL "https://codeload.github.com/Nor2-io/heim-mcp/tar.gz/${HEIM_COMMIT}" \
    | tar xz --strip-components=1
RUN npm install && npm run build

# Same published heim rust-http example application as the vulnerable image, seeded whole outside
# the layout so the benign `heim deploy /opt/myapp` points at a real, deployable heim application.
RUN mkdir -p /opt/myapp/src
RUN cat > /opt/myapp/component.toml <<'COMPONENT_TOML_EOF'
name = "myapp" # Component name
version = "0.1.0"

[commands] # Custom commands that can be used from the heim cli
run = "wasmtime serve -S cli target/wasm32-wasip2/debug/myapp.wasm --addr=127.0.0.1:8080"
run_production = "wasmtime serve -S cli target/wasm32-wasip2/release/myapp.wasm --addr=127.0.0.1:8080"


[build.dev] # Dev build command and output
build = "cargo build --target=wasm32-wasip2"
wasm_path = "target/wasm32-wasip2/debug/myapp.wasm"

[build.prod] # Prod build command and output
build = "cargo build --target=wasm32-wasip2 --release"
wasm_path = "target/wasm32-wasip2/release/myapp.wasm"
COMPONENT_TOML_EOF
RUN cat > /opt/myapp/application.toml <<'APPLICATION_TOML_EOF'
name = "myapp" # application name
component_target = 'myapp:0.1.0' # component to target

[[trigger]] # Trigger definition
type = 'http'
path = '/myapp'
method = 'GET'
APPLICATION_TOML_EOF
RUN cat > /opt/myapp/Cargo.toml <<'CARGO_TOML_EOF'
[package]
name = "myapp"
version = "0.1.0"
edition = "2021"

[lib]
crate-type = ["cdylib"]

[package.metadata.component]
package = "myorg:myapp"
proxy = false

[dependencies]
waki = { version = "0.5.0", features = ["json"] }

# reduce wasm binary size
[profile.release]
lto = true
strip = "symbols"
CARGO_TOML_EOF
RUN cat > /opt/myapp/src/lib.rs <<'LIB_RS_EOF'
use waki::{handler, ErrorCode, Request, Response};

#[handler]
fn hello(req: Request) -> Result<Response, ErrorCode> {
    Response::builder()
        .status_code(200)
        .body("Hello World")
        .build()
}
LIB_RS_EOF

# Same heim stand-in as the vulnerable image: `heim deploy /opt/myapp` replays the documented
# `heim deploy` output, `heim deploy` with any other / no path gets heim's build error, and any
# non-deploy invocation the unrecognized-subcommand error. On this version execFile passes the
# payload as one literal argv element, so the stand-in sees `deploy` plus a single path argument
# that is not /opt/myapp and returns the build error, with no shell to inject into.
RUN mkdir -p /usr/local/share/heim
RUN cat > /usr/local/share/heim/deploy.stdout <<'HEIM_DEPLOY_STDOUT_EOF'

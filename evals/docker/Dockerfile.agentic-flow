# agentic-flow (CVE-2026-58195), patched npm release 2.0.14 (PR #170 rewrites every call site to
# execFileSync('npx', argv, { shell: false }), so shell metacharacters in a tool parameter no
# longer reach a shell. Doubles as the nuisance run image. No COPY/ADD from the build context.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
RUN npm install -g agentic-flow@2.0.14 && npm cache clean --force
ENV npm_config_offline=true
ENTRYPOINT ["node", "/usr/local/lib/node_modules/agentic-flow/dist/mcp/standalone-stdio.js"]

# Patched server: awslabs.aws-healthomics-mcp-server 0.0.36 (CVE-2026-15415 fixed).
# 0.0.36 rejects a main_workflow_file that resolves outside the bundle ("Path traversal detected in
# main_workflow_file"), so the linter reads no file beyond the bundle.
FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

# miniwdl and cwltool are the real linters the server calls; the server pins neither (miniwdl>=1.12.0,
# cwltool[deps]>=3.1.0), so they are pinned here to the releases pip resolved at calibration, which the
# card records, to keep the image byte-stable across rebuilds.
RUN pip install --no-cache-dir \
      "awslabs.aws-healthomics-mcp-server==0.0.36" \
      "mcp[cli]>=1.23.0,<2" \
      "miniwdl==1.16.0" \
      "cwltool==3.3.20260925135507"

ENTRYPOINT ["awslabs.aws-healthomics-mcp-server"]

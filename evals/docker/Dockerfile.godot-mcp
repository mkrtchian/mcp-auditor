# Nuisance run image of godot-mcp: a copy of Dockerfile.holdout-2026-25546-godot-mcp-patched, with the godot stub's behaviour kept (its comments on the holdout's exploit dropped), the holdout's exploit project fixtures under /p left out, and the seeding the run adds before its entrypoint,
# pinning the admission's patched version, commit 21c785d923cfdb471ea60323c13807d62dfecc5a (abbreviated 21c785d below).

# Patched @coding-solo/godot-mcp, built from the real source at the fix merge commit 21c785d
# (first patched release 0.1.1; executeOperation uses execFile() with an argument array, no
# shell).
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN apk add --no-cache git

WORKDIR /app
RUN git clone https://github.com/Coding-Solo/godot-mcp.git . \
 && git checkout 21c785d
RUN npm install && npm run build

# The Godot CLI the server calls, stubbed: it answers the server's `--version` check and exits
# cleanly on every headless run.
RUN printf '#!/bin/sh\nif [ "$1" = "--version" ]; then\n  echo "4.4.1.stable.official"\nfi\nexit 0\n' > /usr/local/bin/godot \
 && chmod +x /usr/local/bin/godot

# A neutral Godot project for the benign calls: the project file the server checks, a scene
# and a texture, since the stub godot writes nothing and each tool checks its paths exist.
RUN mkdir -p /opt/project \
 && printf '[application]\nconfig/name="demo"\nconfig/features=PackedStringArray("4.4")\n' > /opt/project/project.godot \
 && printf '[gd_scene format=3]\n\n[node name="Root" type="Node2D"]\n' > /opt/project/scene.tscn \
 && node -e 'require("fs").writeFileSync("/opt/project/sprite.png", Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAFUlEQVR4nGP8//8/AzbAhFV00EoAAFbUAw037MyjAAAAAElFTkSuQmCC", "base64"))'

ENV GODOT_PATH=/usr/local/bin/godot
ENTRYPOINT ["node", "/app/build/index.js"]

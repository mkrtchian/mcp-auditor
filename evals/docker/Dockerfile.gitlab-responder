# Stand-in for the self-managed GitLab instance (GitLab CE) that the job tools of
# @zereight/mcp-gitlab (execute_graphql, upload_markdown, get_pipeline_job, get_pipeline_job_output, list_job_artifacts,
# download_job_artifacts, get_job_artifact_file, play/retry/cancel_pipeline_job) reach through
# GITLAB_API_URL on port 80. GitLab itself cannot run under the confinement: the Omnibus image
# needs root with CHOWN/DAC_OVERRIDE/SETUID/SETGID, which --cap-drop ALL removes. Every answer
# comes from GitLab's own sources, pinned at tag v19.5.3-ee:
#   - GET  /projects/1/jobs/8: doc/api/jobs.md "Retrieve a job by job ID" example response
#   - GET  /projects/1/jobs/42/trace: spec/fixtures/trace/sample_trace, the log the jobs API
#     spec serves through Workhorse
#   - GET  /projects/1/jobs/42/artifacts/tree: doc/api/job_artifacts.md example response
#   - GET  /projects/1/jobs/42/artifacts/<entry>: the entry of spec/fixtures/ci_build_artifacts.zip,
#     the archive of the :artifacts job factory
#   - GET  /projects/1/jobs/42/artifacts: that archive whole
#   - POST /projects/1/jobs/1/{play,retry,cancel}: invented in the form of the doc/api/jobs.md
#     example responses ("Run a job", "Retry a job", "Cancel a job"), whose "user": null the server
#     rejects, with the user object of that page's "Retrieve a job by job ID" example, since GitLab
#     answers these calls with the job's user (spec/requests/api/ci/jobs_spec.rb asserts the play
#     answer carries the requesting user, Ci::RetryJobService gives the new job the current user);
#     status 200 for play, 201 for retry and cancel, as that spec asserts
#   - POST /projects/5/uploads: doc/api/project_markdown_uploads.md "Create an upload" example
#     response, with the uploaded part's filename quoted where the example quotes its dk.png
#     (alt without the extension, url, full_path, markdown), status 201
#   - POST /api/graphql with the body {"query":<doc/api/graphql/getting_started.md "Get a specific
#     project and the title of Issue #2" query, on one line>,"variables":{}}: gitlab.com's answer
#     to that request (captured 2026-11-07); any other GraphQL body gets the 404 below
#   - anything else: 404 {"error":"404 Not Found"}, gitlab.com's answer to an API path it does
#     not route (captured 2026-11-07)
# Routes match the method and the raw request target exactly. WITNESS_NONCE is set only by the
# fix check's own per-launch container: it then serves the nonce on a /internal/ path (raw,
# %2F not decoded, so the patched server's encoded job_id never reaches it). The run singleton
# sets none and answers that path with the 404 above.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
ADD --checksum=sha256:c7f421244775924ea9d82d2a887a8608361e6d5568f83511c7d66f6160df85b6 https://gitlab.com/api/v4/projects/278964/repository/files/spec%2Ffixtures%2Ftrace%2Fsample_trace/raw?ref=v19.5.3-ee /srv/sample_trace
ADD --checksum=sha256:86f91b74d257dc0772827a8b72fdba66bb649d1e381460649321fec6d5eb63b4 https://gitlab.com/api/v4/projects/278964/repository/files/spec%2Ffixtures%2Fci_build_artifacts.zip/raw?ref=v19.5.3-ee /srv/ci_build_artifacts.zip
RUN unzip -p /srv/ci_build_artifacts.zip other_artifacts_0.1.2/doc_sample.txt > /srv/doc_sample.txt && test -s /srv/doc_sample.txt
RUN cat > /srv/responder.js <<'EOF_JS'

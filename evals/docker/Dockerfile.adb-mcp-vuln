# adb-mcp (CVE-2025-59834), vulnerable npm release 0.1.0: every tool that takes a `device`
# argument builds `adb -s ${device} ...` by string interpolation and runs it through
# child_process.exec. Fix-check image only. Same real adb and same Android device stand-in as
# the run image Dockerfile.adb-mcp; only the server release differs.
#
# Real software: Android SDK Platform-Tools r37.0.1 (adb 1.0.41, 37.0.1-15733141), the stable
# channel-0 release of https://dl.google.com/android/repository/repository2-3.xml, installed by
# unzipping Google's Linux archive as the platform-tools release notes say, checksum-pinned.
# The real adb client and its server run in the container. The one part that cannot run under
# the confinement is the Android device: the Android Emulator needs /dev/kvm for x86_64 system
# images, no device or /dev mount is allowed, and as a backend it does not fit the memory bound. It
# is stood in for by a process that speaks the adb transport protocol on 127.0.0.1:5555 (the first
# port adb's emulator scanner probes). Its outputs are a capture of the real device: Android
# Emulator 37.2.13 running system-images;android-37.0;default;x86_64 r06 (the AVD made by
# cmdline-tools 23.0 avdmanager from the medium_phone profile, booted headless from its Quick Boot
# snapshot with -timezone Etc/UTC and -qemu -cpu qemu64), driven by this image's adb through a
# relay that recorded the transport, on 2026-11-13: its connection banner, the sync service's
# answers (/system/etc/hosts read, /system/build.prop refused to the shell user, pushed files kept),
# Settings' "settings get" and the package installer's answers. logcat -d keeps the first output
# line of developer.android.com/tools/logcat. A shell command it does not hold gets mksh's
# "inaccessible or not found" error (exit 127), quoting only the command name as mksh does; any
# other service is refused as adbd refuses a service it cannot open.
# The adb server is started before the MCP server, as the server's README requires the device
# to be connected first; otherwise adb's first command prints "* daemon not running" on stderr.
# Seeded: /tmp/app.apk is androidx.test orchestrator 1.4.2, the APK the AndroidX Test runner
# guide installs with "adb install -r", from Google's Maven repository, checksum-pinned.
# No COPY/ADD from the build context; every file is written inline or fetched by checksum.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

ADD --checksum=sha256:d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1 https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip /opt/platform-tools.zip
ADD --checksum=sha256:b7a2e7d0184b03e12c7357f3914d539da40b52a11e90815edff1022c655f459b https://dl.google.com/android/maven2/androidx/test/orchestrator/1.4.2/orchestrator-1.4.2.apk /tmp/app.apk

RUN cat > /opt/unzip.js <<'EOF'
const fs = require('fs'), zlib = require('zlib'), path = require('path');
const [zipPath, dest] = process.argv.slice(2);
const d = fs.readFileSync(zipPath);
const e = d.lastIndexOf(Buffer.from([0x50, 0x4b, 0x05, 0x06]));
let p = d.readUInt32LE(e + 16);
const end = p + d.readUInt32LE(e + 12);
while (p < end) {
  const method = d.readUInt16LE(p + 10), csize = d.readUInt32LE(p + 20);
  const nl = d.readUInt16LE(p + 28), el = d.readUInt16LE(p + 30), cl = d.readUInt16LE(p + 32);
  const mode = (d.readUInt32LE(p + 38) >>> 16) & 0o777;
  const off = d.readUInt32LE(p + 42), name = d.subarray(p + 46, p + 46 + nl).toString();
  p += 46 + nl + el + cl;
  const out = path.join(dest, name);
  if (name.endsWith('/')) { fs.mkdirSync(out, { recursive: true }); continue; }
  const start = off + 30 + d.readUInt16LE(off + 26) + d.readUInt16LE(off + 28);
  const raw = d.subarray(start, start + csize);
  fs.mkdirSync(path.dirname(out), { recursive: true });
  fs.writeFileSync(out, method === 8 ? zlib.inflateRawSync(raw) : raw, { mode: mode || 0o644 });
}
EOF
RUN node /opt/unzip.js /opt/platform-tools.zip /opt \
 && rm /opt/unzip.js /opt/platform-tools.zip \
 && ln -s /opt/platform-tools/adb /usr/local/bin/adb \
 && chmod 0644 /tmp/app.apk \
 && adb version

RUN mkdir -p /usr/local/share/android-device \
 && printf '%s\n' 'I/ActivityManager(  585): Starting activity: Intent { action=android.intent.action...}' > /usr/local/share/android-device/logcat.txt

RUN mkdir -p /usr/local/lib/android-device && cat > /usr/local/lib/android-device/adbd.js <<'EOF'
'use strict';
const net = require('net');
const fs = require('fs');
const zlib = require('zlib');

const LOGCAT = fs.readFileSync('/usr/local/share/android-device/logcat.txt', 'utf8');
const APP_APK_SIZE = 643551;

function shellCommand(cmd) {
  if (cmd === "export ANDROID_LOG_TAGS=''; exec logcat '-d'") return ok(LOGCAT);
  if (cmd === 'cat /system/build.prop') return fail('', 'cat: /system/build.prop: Permission denied\n', 1);
  return mksh(words(cmd));
}

function installResult(size, zip) {
  if (size === APP_APK_SIZE && zip) return 'Success\n';
  return 'Failure [INSTALL_PARSE_FAILED_NOT_APK: Failed to parse /data/app/vmdl344711723.tmp/base.apk: ' +
    'Failed to load asset path /data/app/vmdl344711723.tmp/base.apk]\n';
}

const A_CNXN = 0x4e584e43, A_OPEN = 0x4e45504f, A_OKAY = 0x59414b4f, A_CLSE = 0x45534c43, A_WRTE = 0x45545257;
const A_VERSION = 0x01000001, MAX_PAYLOAD = 1024 * 1024;
const BANNER = 'device::ro.product.name=sdk_phone64_x86_64;ro.product.model=Android SDK built for x86_64;' +
  'ro.product.device=emu64x;features=shell_v2,cmd,stat_v2,ls_v2,fixed_push_mkdir,apex,abb,' +
  'fixed_push_symlink_timestamp,abb_exec,remount_shell,track_app,sendrecv_v2,sendrecv_v2_brotli,' +
  'sendrecv_v2_lz4,sendrecv_v2_zstd,sendrecv_v2_dry_run_send,openscreen_mdns,devicetracker_proto_format,' +
  'devraw,app_info,server_status,track_mdns,delayed_ack';

// Captured stat_v2 fields: [dev, ino, mode, nlink, uid, gid, size, atime, mtime, ctime].
const SDCARD = [42, 229379, 0o42770, 18, 1023, 1023, 4096, 1794602125, 1794602127, 1794602157];
const LOCAL_TMP = [65030, 65538, 0o40771, 2, 2000, 2000, 4096, 1794602115, 1794602115, 1794602115];
const DIRS = { __proto__: null, '/sdcard': SDCARD, '/sdcard/': SDCARD, '/storage/emulated/0': SDCARD, '/storage/emulated/0/': SDCARD,
  '/data/local/tmp': LOCAL_TMP, '/data/local/tmp/': LOCAL_TMP };
const HOSTS = Buffer.from('127.0.0.1       localhost\n::1             ip6-localhost\n');
const SYSTEM_FILES = { __proto__: null,
  '/system/etc/hosts': { stat: [65029, 753, 0o100644, 1, 0, 0, 56, 1791782088, 1791782088, 1791782088], data: HOSTS },
  '/system/build.prop': { stat: [65029, 686, 0o100600, 1, 0, 0, 5818, 1791782078, 1791782078, 1791782078], data: null },
};
const PUSHED_FORM = [42, 229435, 0o100660, 1, 10148, 1023];
const PUSHED_CTIME = 1794602186;
const WRITABLE = ['/sdcard/', '/storage/emulated/0/', '/data/local/tmp/'];
const pushed = new Map();

const id4 = (s) => (s.charCodeAt(0) | (s.charCodeAt(1) << 8) | (s.charCodeAt(2) << 16) | (s.charCodeAt(3) << 24)) >>> 0;
const ID = {};
for (const k of ['STAT', 'STA2', 'LST2', 'LIST', 'LIS2', 'SEND', 'SND2', 'RECV', 'RCV2', 'DONE', 'DATA', 'OKAY', 'FAIL', 'QUIT']) ID[k] = id4(k);

function words(cmd) {
  const out = [];
  const re = /'((?:[^']|'\\'')*)'|(\S+)/g;
  let m;
  while ((m = re.exec(cmd)) !== null) out.push(m[1] !== undefined ? m[1].replace(/'\\''/g, "'") : m[2]);
  return out;
}
const ok = (stdout = '') => ({ stdout, stderr: '', code: 0 });
const fail = (stdout, stderr, code) => ({ stdout, stderr, code });
const mksh = (w) => fail('', '/system/bin/sh: ' + (w[0] || '') + ': inaccessible or not found\n', 127);

function statOf(path) {
  if (SYSTEM_FILES[path]) return SYSTEM_FILES[path].stat;
  if (DIRS[path]) return DIRS[path];
  const f = pushed.get(path);
  if (f) return [...PUSHED_FORM, f.data.length, f.mtime, f.mtime, PUSHED_CTIME];
  return null;
}

function statV2(id, path) {
  const b = Buffer.alloc(72); b.writeUInt32LE(id, 0);
  const st = statOf(path);
  if (!st) { b.writeUInt32LE(2, 4); return b; }
  const [dev, ino, mode, nlink, uid, gid, size, atime, mtime, ctime] = st;
  b.writeBigUInt64LE(BigInt(dev), 8); b.writeBigUInt64LE(BigInt(ino), 16);
  b.writeUInt32LE(mode, 24); b.writeUInt32LE(nlink, 28); b.writeUInt32LE(uid, 32); b.writeUInt32LE(gid, 36);
  b.writeBigUInt64LE(BigInt(size), 40);
  b.writeBigInt64LE(BigInt(atime), 48); b.writeBigInt64LE(BigInt(mtime), 56); b.writeBigInt64LE(BigInt(ctime), 64);
  return b;
}

function statV1(path) {
  const b = Buffer.alloc(16); b.writeUInt32LE(ID.STAT, 0);
  const st = statOf(path);
  if (st) { b.writeUInt32LE(st[2], 4); b.writeUInt32LE(st[6], 8); b.writeUInt32LE(st[8], 12); }
  return b;
}

function syncStatus(id, msg) {
  const m = Buffer.from(msg || '');
  const h = Buffer.alloc(8); h.writeUInt32LE(id, 0); h.writeUInt32LE(m.length, 4);
  return Buffer.concat([h, m]);
}

function fileData(path, flags) {
  const system = SYSTEM_FILES[path];
  if (system && !system.data) return syncStatus(ID.FAIL, 'open failed: Permission denied');
  let data = system ? system.data : pushed.has(path) ? pushed.get(path).data : null;
  if (!data) return syncStatus(ID.FAIL, 'open failed: No such file or directory');
  if (flags === 1) data = zlib.brotliCompressSync(data);
  else if (flags !== 0) return syncStatus(ID.FAIL, 'unknown flags: ' + flags);
  const out = [];
  for (let i = 0; i < data.length; i += 65536) {
    const c = data.subarray(i, i + 65536);
    const h = Buffer.alloc(8); h.writeUInt32LE(ID.DATA, 0); h.writeUInt32LE(c.length, 4);
    out.push(h, c);
  }
  const d = Buffer.alloc(8); d.writeUInt32LE(ID.DONE, 0);
  out.push(d);
  return Buffer.concat(out);
}

function sendRefusal(path) {
  return path.startsWith('/system/') ? "couldn't create file: Read-only file system" : "couldn't create file: Permission denied";
}

function syncService(stream) {
  let buf = Buffer.alloc(0);
  let send = null;
  stream.onData = (data) => {
    buf = Buffer.concat([buf, data]);
    for (;;) {
      if (send) {
        if (buf.length < 8) return;
        const id = buf.readUInt32LE(0), n = buf.readUInt32LE(4);
        if (id === ID.DATA) {
          if (buf.length < 8 + n) return;
          send.parts.push(Buffer.from(buf.subarray(8, 8 + n)));
          buf = buf.subarray(8 + n);
          continue;
        }
        buf = buf.subarray(8);
        if (id === ID.DONE && WRITABLE.some((p) => send.path.startsWith(p))) {
          let body = Buffer.concat(send.parts);
          if (send.flags === 1) body = zlib.brotliDecompressSync(body);
          pushed.set(send.path, { data: body, mtime: n });
          stream.write(syncStatus(ID.OKAY));
        } else {
          stream.write(syncStatus(ID.FAIL, id === ID.DONE ? sendRefusal(send.path) : 'invalid data message'));
        }
        send = null;
        continue;
      }
      if (buf.length < 8) return;
      const id = buf.readUInt32LE(0), n = buf.readUInt32LE(4);
      const extra = id === ID.SND2 ? 12 : id === ID.RCV2 ? 8 : 0;
      if (buf.length < 8 + n + extra) return;
      const path = buf.subarray(8, 8 + n).toString('utf8');
      const setup = buf.subarray(8 + n, 8 + n + extra);
      buf = buf.subarray(8 + n + extra);
      if (id === ID.STA2 || id === ID.LST2) stream.write(statV2(id, path));
      else if (id === ID.STAT) stream.write(statV1(path));
      else if (id === ID.LIST) { const d = Buffer.alloc(20); d.writeUInt32LE(ID.DONE, 0); stream.write(d); }
      else if (id === ID.LIS2) { const d = Buffer.alloc(76); d.writeUInt32LE(ID.DONE, 0); stream.write(d); }
      else if (id === ID.SEND) send = { path: path.slice(0, path.lastIndexOf(',')), flags: 0, parts: [] };
      else if (id === ID.SND2) send = { path, flags: setup.readUInt32LE(8), parts: [] };
      else if (id === ID.RECV) stream.write(fileData(path, 0));
      else if (id === ID.RCV2) stream.write(fileData(path, setup.readUInt32LE(4)));
      else if (id === ID.QUIT) { stream.close(); return; }
      else { stream.write(syncStatus(ID.FAIL, 'unknown command ' + id.toString(16).padStart(8, '0'))); stream.close(); return; }
    }
  };
}

function installService(stream, size) {
  let got = 0, head = Buffer.alloc(0), done = false;
  const finish = () => {
    if (done) return; done = true;
    stream.write(Buffer.from(installResult(size, head.length >= 4 && head.readUInt32LE(0) === 0x04034b50)));
    stream.close();
  };
  stream.onData = (data) => {
    if (head.length < 4) head = Buffer.concat([head, data.subarray(0, 4 - head.length)]);
    got += data.length;
    if (got >= size) finish();
  };
  if (size === 0) finish();
}

function shellPacket(id, data) {
  const h = Buffer.alloc(5); h.writeUInt8(id, 0); h.writeUInt32LE(data.length, 1);
  return Buffer.concat([h, data]);
}

function openService(service, stream) {
  let m = /^shell(,[^:]*)?:([\s\S]*)$/.exec(service);
  if (m) {
    const v2 = (m[1] || '').split(',').includes('v2');
    const r = shellCommand(m[2]);
    return () => {
      const out = Buffer.from(r.stdout), err = Buffer.from(r.stderr);
      if (v2) {
        const parts = [];
        if (out.length) parts.push(shellPacket(1, out));
        if (err.length) parts.push(shellPacket(2, err));
        parts.push(shellPacket(3, Buffer.from([r.code & 0xff])));
        stream.write(Buffer.concat(parts));
      } else stream.write(Buffer.concat([out, err]));
      stream.close();
    };
  }
  if (service === 'sync:') return () => syncService(stream);
  if (service.startsWith('abb_exec:')) {
    const a = service.slice(9).split('\0');
    if (a.join(' ') === 'settings get global enable_adb_incremental_install_default') {
      return () => { stream.write(Buffer.from('null\n')); stream.close(); };
    }
    if (a[0] === 'package' && a[1] === 'install' && a[a.length - 2] === '-S' && /^\d+$/.test(a[a.length - 1])) {
      return () => installService(stream, Number(a[a.length - 1]));
    }
  }
  return false;
}

function session(sock) {
  let buf = Buffer.alloc(0), maxdata = 4096, nextId = 1;
  const streams = new Map();
  const send = (cmd, a0, a1, data) => {
    data = data || Buffer.alloc(0);
    const h = Buffer.alloc(24);
    let sum = 0; for (const x of data) sum += x;
    h.writeUInt32LE(cmd, 0); h.writeUInt32LE(a0 >>> 0, 4); h.writeUInt32LE(a1 >>> 0, 8);
    h.writeUInt32LE(data.length, 12); h.writeUInt32LE(sum >>> 0, 16); h.writeUInt32LE((cmd ^ 0xffffffff) >>> 0, 20);
    sock.write(Buffer.concat([h, data]));
  };
  const makeStream = (id, remote) => {
    const s = { queue: [], waiting: false, closing: false, closed: false, onData: () => {} };
    s.flush = () => {
      if (s.closed) return;
      while (!s.waiting && s.queue.length) {
        let b = s.queue.shift();
        if (b.length > maxdata) { s.queue.unshift(b.subarray(maxdata)); b = b.subarray(0, maxdata); }
        send(A_WRTE, id, remote, b); s.waiting = true;
      }
      if (!s.waiting && !s.queue.length && s.closing) { s.closed = true; streams.delete(id); send(A_CLSE, id, remote); }
    };
    s.write = (b) => { if (b.length) s.queue.push(b); s.flush(); };
    s.close = () => { s.closing = true; s.flush(); };
    return s;
  };
  sock.on('data', (chunk) => {
    buf = Buffer.concat([buf, chunk]);
    while (buf.length >= 24) {
      const cmd = buf.readUInt32LE(0), a0 = buf.readUInt32LE(4), a1 = buf.readUInt32LE(8), n = buf.readUInt32LE(12);
      if (buf.length < 24 + n) return;
      const data = buf.subarray(24, 24 + n);
      buf = buf.subarray(24 + n);
      if (cmd === A_CNXN) {
        maxdata = Math.min(a1, MAX_PAYLOAD);
        send(A_CNXN, A_VERSION, MAX_PAYLOAD, Buffer.from(BANNER));
      } else if (cmd === A_OPEN) {
        const service = data.toString('utf8').replace(/\0+$/, '');
        const id = nextId++;
        const s = makeStream(id, a0);
        const start = openService(service, s);
        if (!start) { send(A_CLSE, 0, a0); continue; }
        streams.set(id, s);
        send(A_OKAY, id, a0);
        start();
      } else if (cmd === A_OKAY) {
        const s = streams.get(a1);
        if (s) { s.waiting = false; s.flush(); }
      } else if (cmd === A_WRTE) {
        const s = streams.get(a1);
        if (s) { send(A_OKAY, a1, a0); s.onData(Buffer.from(data)); }
        else send(A_CLSE, 0, a0);
      } else if (cmd === A_CLSE) {
        const s = streams.get(a1);
        if (s) { s.closed = true; streams.delete(a1); }
      }
    }
  });
  sock.on('error', () => {});
}

net.createServer(session).listen(5555, '127.0.0.1');
EOF

RUN cat > /usr/local/bin/adb-mcp-session <<'EOF' && chmod 0755 /usr/local/bin/adb-mcp-session
#!/bin/sh
node /usr/local/lib/android-device/adbd.js </dev/null >/dev/null 2>&1 &
i=0
until node -e "require('net').connect(5555,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))" 2>/dev/null; do
  i=$((i+1)); [ "$i" -ge 100 ] && break; sleep 0.1
done
adb start-server </dev/null >/dev/null 2>&1
timeout 30 adb wait-for-device </dev/null >/dev/null 2>&1
exec adb-mcp "$@"
EOF

RUN npm install -g adb-mcp@0.1.0

ENTRYPOINT ["adb-mcp-session"]

# rails-mcp-server (CVE-2026-81097), patched gem 1.6.1 (adds the /\bPTY\b/ forbidden pattern and
# a require allowlist that rejects `require "pty"`, while keeping execute_ruby itself, unlike
# 2.0.0 which removes the tool and would make the benign call error). Doubles as the nuisance run
# image. No COPY/ADD from the build context.
FROM ruby:3.3-slim@sha256:eaeeb51411875c81f7f9b5353558decb8e3e1dbde38b18ff1d6c910f95cf860b

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash git build-essential libyaml-dev pkg-config tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN gem install rails -v '~> 7.2' --no-document

RUN rails new /app --minimal --skip-active-record --skip-bundle \
 && cd /app && bundle install \
 && chmod -R a+rwX /app

ENV RAILS_MCP_PROJECT_PATH=/app \
    SHELL=/bin/bash

# The fixed release.
RUN gem install rails-mcp-server -v '1.6.1' --no-document

ENTRYPOINT ["rails-mcp-server"]

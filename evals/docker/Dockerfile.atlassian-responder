def issue_detail(issue):
    project = issue["key"].split("-")[0]
    text = json.dumps(MOCK_JIRA_ISSUE_RESPONSE).replace("https://example.atlassian.net", "http://localhost:8080")
    detail = json.loads(text.replace("PROJ", project))
    detail.update(id=issue["id"], self=JIRA + issue["id"], key=issue["key"])
    return detail


ISSUES = {issue["key"]: issue_detail(issue) for search in SEARCHES.values() for issue in search["issues"]}


JIRA_ERROR = {"errorMessages": [], "errors": {}}
CONFLUENCE_ERROR = {"statusCode": 400}

PROJ_JQLS = (
    "project = PROJ",
    "((project = PROJ) AND project = PROJ) AND project = PROJ",
    'project = "PROJ"',
    '(project = "PROJ") AND project = PROJ',
    "(sprint = 10001) AND project = PROJ",
)
DEMO_JQLS = (
    "(issuetype = Task) AND project = DEMO",
    'project = "DEMO"',
    "sprint = 10001 AND project = DEMO",
)
JQL_SEARCHES = {
    **{jql: PROJ_SEARCH for jql in PROJ_JQLS},
    **{jql: demo_search() for jql in DEMO_JQLS},
}
CQL_RESULTS = {
    "space = TEAM": TEAM_RESULT,
    "((space = TEAM) AND (space = TEAM)) AND (space = TEAM)": TEAM_RESULT,
    "(type = page) AND (space = DEMO)": demo_result(),
}


def answer(method, target):
    url = urllib.parse.urlparse(target)
    params = urllib.parse.parse_qs(url.query)
    path = url.path.rstrip("/")
    if method == "GET" and path == "/rest/api/2/search":
        return search_jira(params.get("jql", [""])[0])
    if method == "GET" and path == "/rest/api/search":
        return search_confluence(params.get("cql", [""])[0])
    if method == "GET" and path.removeprefix(ISSUE_PATH) in ISSUES:
        return 200, ISSUES[path.removeprefix(ISSUE_PATH)]
    return 404, JIRA_ERROR


def search_jira(jql):
    if jql in JQL_SEARCHES:
        return 200, JQL_SEARCHES[jql]
    return 400, JIRA_ERROR


def search_confluence(cql):
    if cql not in CQL_RESULTS:
        return 400, CONFLUENCE_ERROR
    return 200, {
        "results": [CQL_RESULTS[cql]],
        "start": 0,
        "limit": 50,
        "size": 1,
        "totalSize": 1,
        "cqlQuery": cql,
        "searchDuration": 156,
        "_links": {
            "base": "https://example.atlassian.net/wiki",
            "context": "/wiki",
            "self": "https://example.atlassian.net/wiki/rest/api/search?cql=parent%3D123456789",
        },
    }


class Handler(http.server.BaseHTTPRequestHandler):
    def __getattr__(self, name):
        if name.startswith("do_"):
            return self.respond
        raise AttributeError(name)

    def respond(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(length)
        code, payload = answer(self.command, self.path)
        body = json.dumps(payload).encode()
        self.send_response_only(code)
        self.send_header("Date", self.date_time_string())
        self.send_header("Content-Type", "application/json;charset=UTF-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    http.server.HTTPServer(("0.0.0.0", 80), Handler).serve_forever()

# geekgod382/filesystem-mcp-server (CVE-2026-7400) patched: v1.1.0 (commit 4536454, "fixed
# ALLOWED_PATHS check bypass issue"), the repository's fix tag, with no registry release.
# is_path_allowed now resolves with os.path.realpath and anchors the prefix on the allowed root
# plus os.sep, plus an exact-match branch, rejecting a sibling-prefix path or a symlink escape.
# Doubles as the nuisance run image. The ten tools drive no software outside the server (Python's
# os/shutil on the container's own filesystem). mcp follows the server's requirements.txt
# (mcp[cli]>=1.25), bounded below 2: mcp 2.x drops Server.call_tool, which src/tools.py uses, and
# the server then fails to start. It floats within 1.x, as do the transitive dependencies.
# File: README.md at 4536454, Example Usage "Create a new file called notes.txt with the content
# "Hello World"", placed under the declared root (Path.home(), HOME=/tmp at launch) and owned by
# the run account so write_file_tool may overwrite it as the README does.
# No COPY/ADD from the build context; the clone is a RUN fetch.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/geekgod382/filesystem-mcp-server /app \
    && cd /app && git checkout 45364545fc60dc80aadcd4379f08042d3d3d292e
RUN pip install --no-cache-dir "mcp[cli]>=1.25,<2"
RUN printf 'Hello World' > /tmp/notes.txt && chown 65534:65534 /tmp/notes.txt
WORKDIR /app
ENTRYPOINT ["python", "/app/server.py"]

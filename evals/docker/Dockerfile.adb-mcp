RUN printf '%s\n' 'I/ActivityManager(  585): Starting activity: Intent { action=android.intent.action...}' > /usr/local/share/android-device/logcat.txt \
 && echo 'a93661125a6ce1582f9d622067dd9b38b9fb47b6504e79317c68e1c364c724aa  /usr/local/share/android-device/build.prop' | sha256sum -c -

RUN mkdir -p /usr/local/lib/android-device && cat > /usr/local/lib/android-device/adbd.js <<'EOF'
'use strict';
const net = require('net');
const fs = require('fs');
const zlib = require('zlib');

const A_CNXN = 0x4e584e43, A_OPEN = 0x4e45504f, A_OKAY = 0x59414b4f, A_CLSE = 0x45534c43, A_WRTE = 0x45545257;
const A_VERSION = 0x01000001, MAX_PAYLOAD = 1024 * 1024;
const FEATURES = ['shell_v2', 'cmd', 'stat_v2', 'ls_v2', 'fixed_push_mkdir', 'apex', 'abb',
  'fixed_push_symlink_timestamp', 'abb_exec', 'remount_shell', 'track_app', 'sendrecv_v2',
  'sendrecv_v2_brotli', 'sendrecv_v2_lz4', 'sendrecv_v2_zstd', 'sendrecv_v2_dry_run_send',
  'openscreen_mdns', 'devicetracker_proto_format', 'devraw', 'app_info', 'server_status',
  'track_mdns', 'delayed_ack'];
const BANNER = 'device::ro.product.name=sdk_phone64_x86_64;ro.product.model=Android SDK built for x86_64;' +
  'ro.product.device=emu64x;features=' + FEATURES.join(',');

const SHARE = '/usr/local/share/android-device/';
const BUILD_PROP = fs.readFileSync(SHARE + 'build.prop');
const LOGCAT = fs.readFileSync(SHARE + 'logcat.txt');
const FILES = { '/system/build.prop': BUILD_PROP };
const DIRS = { '/sdcard': 0o40770, '/sdcard/': 0o40770, '/data/local/tmp': 0o40771, '/data/local/tmp/': 0o40771 };
const WRITABLE = ['/sdcard/', '/storage/emulated/0/', '/data/local/tmp/'];
const SHELL = { "export ANDROID_LOG_TAGS=''; exec logcat '-d'": LOGCAT, 'cat /system/build.prop': BUILD_PROP };
const TIME = 1230768000n;
const ENOENT = 2;

const id4 = (s) => s.charCodeAt(0) | (s.charCodeAt(1) << 8) | (s.charCodeAt(2) << 16) | (s.charCodeAt(3) << 24) >>> 0;
const ID = {};
for (const k of ['STAT', 'STA2', 'LST2', 'LIST', 'LIS2', 'DENT', 'DNT2', 'SEND', 'SND2', 'RECV', 'RCV2', 'DONE', 'DATA', 'OKAY', 'FAIL', 'QUIT']) ID[k] = id4(k) >>> 0;

function syncStatus(id, msg) {
  const m = Buffer.from(msg || '');
  const h = Buffer.alloc(8); h.writeUInt32LE(id, 0); h.writeUInt32LE(m.length, 4);
  return Buffer.concat([h, m]);
}

function statV2(id, path) {
  const b = Buffer.alloc(72); b.writeUInt32LE(id, 0);
  let mode = 0, size = 0n;
  if (FILES[path]) { mode = 0o100644; size = BigInt(FILES[path].length); }
  else if (DIRS[path]) { mode = DIRS[path]; size = 4096n; }
  else { b.writeUInt32LE(ENOENT, 4); return b; }
  b.writeUInt32LE(mode, 24); b.writeUInt32LE(1, 28);
  b.writeBigUInt64LE(size, 40);
  b.writeBigInt64LE(TIME, 48); b.writeBigInt64LE(TIME, 56); b.writeBigInt64LE(TIME, 64);
  return b;
}

function statV1(path) {
  const b = Buffer.alloc(16); b.writeUInt32LE(ID.STAT, 0);
  if (FILES[path]) { b.writeUInt32LE(0o100644, 4); b.writeUInt32LE(FILES[path].length, 8); b.writeUInt32LE(Number(TIME), 12); }
  else if (DIRS[path]) { b.writeUInt32LE(DIRS[path], 4); b.writeUInt32LE(4096, 8); b.writeUInt32LE(Number(TIME), 12); }
  return b;
}

function fileData(path, flags) {
  let data = FILES[path];
  if (!data) return syncStatus(ID.FAIL, 'open failed: No such file or directory');
  if (flags === 1) data = zlib.brotliCompressSync(data);
  else if (flags !== 0) return syncStatus(ID.FAIL, 'unknown flags: ' + flags);
  const out = [];
  for (let i = 0; i < data.length; i += 65536) {
    const c = data.subarray(i, i + 65536);
    const h = Buffer.alloc(8); h.writeUInt32LE(ID.DATA, 0); h.writeUInt32LE(c.length, 4);
    out.push(h, c);
  }
  const d = Buffer.alloc(8); d.writeUInt32LE(ID.DONE, 0);
  out.push(d);
  return Buffer.concat(out);
}

function shellPacket(id, data) {
  const h = Buffer.alloc(5); h.writeUInt8(id, 0); h.writeUInt32LE(data.length, 1);
  return Buffer.concat([h, data]);
}

function syncService(stream) {
  let buf = Buffer.alloc(0);
  let send = null;
  stream.onData = (data) => {
    buf = Buffer.concat([buf, data]);
    for (;;) {
      if (send) {
        if (buf.length < 8) return;
        const id = buf.readUInt32LE(0), n = buf.readUInt32LE(4);
        if (id === ID.DATA) {
          if (buf.length < 8 + n) return;
          buf = buf.subarray(8 + n);
          continue;
        }
        buf = buf.subarray(8);
        const ok = id === ID.DONE && WRITABLE.some((p) => send.startsWith(p));
        stream.write(ok ? syncStatus(ID.OKAY) : syncStatus(ID.FAIL, id === ID.DONE
          ? "couldn't create file: Permission denied" : 'invalid data message'));
        send = null;
        continue;
      }
      if (buf.length < 8) return;
      const id = buf.readUInt32LE(0), n = buf.readUInt32LE(4);
      const extra = id === ID.SND2 ? 12 : id === ID.RCV2 ? 8 : 0;
      if (buf.length < 8 + n + extra) return;
      const path = buf.subarray(8, 8 + n).toString('latin1');
      const setup = buf.subarray(8 + n, 8 + n + extra);
      buf = buf.subarray(8 + n + extra);
      if (id === ID.STA2 || id === ID.LST2) stream.write(statV2(id, path));
      else if (id === ID.STAT) stream.write(statV1(path));
      else if (id === ID.LIST) { const d = Buffer.alloc(20); d.writeUInt32LE(ID.DONE, 0); stream.write(d); }
      else if (id === ID.LIS2) { const d = Buffer.alloc(76); d.writeUInt32LE(ID.DONE, 0); stream.write(d); }
      else if (id === ID.SEND) send = path.slice(0, path.lastIndexOf(','));
      else if (id === ID.SND2) send = path;
      else if (id === ID.RECV) stream.write(fileData(path, 0));
      else if (id === ID.RCV2) stream.write(fileData(path, setup.readUInt32LE(4)));
      else if (id === ID.QUIT) { stream.close(); return; }
      else { stream.write(syncStatus(ID.FAIL, 'unknown command ' + id.toString(16).padStart(8, '0'))); stream.close(); return; }
    }
  };
}

function installService(stream, size) {
  let got = 0, head = Buffer.alloc(0), done = false;
  const finish = () => {
    if (done) return; done = true;
    const apk = head.length >= 4 && head.readUInt32LE(0) === 0x04034b50;
    stream.write(Buffer.from(apk ? 'Success\n' : 'Failure [INSTALL_PARSE_FAILED_NOT_APK]\n'));
    stream.close();
  };
  stream.onData = (data) => {
    if (head.length < 4) head = Buffer.concat([head, data.subarray(0, 4 - head.length)]);
    got += data.length;
    if (got >= size) finish();
  };
  if (size === 0) finish();
}

function openService(service, stream) {
  let m = /^shell(,[^:]*)?:([\s\S]*)$/.exec(service);
  if (m) {
    const v2 = (m[1] || '').split(',').includes('v2');
    const out = SHELL[m[2]];
    let fd = 1, code = 0, text = out;
    if (!out) {
      fd = 2; code = 127;
      text = Buffer.from('/system/bin/sh: ' + (m[2].trim().split(/\s+/)[0] || '') + ': inaccessible or not found\n');
    }
    return () => {
      stream.write(v2 ? Buffer.concat([shellPacket(fd, text), shellPacket(3, Buffer.from([code]))]) : text);
      stream.close();
    };
  }
  if (service === 'sync:') return () => syncService(stream);
  if (service.startsWith('abb_exec:')) {
    const a = service.slice(9).split('\0');
    if (a.join(' ') === 'settings get global enable_adb_incremental_install_default') {
      return () => { stream.write(Buffer.from('null\n')); stream.close(); };
    }
    if (a[0] === 'package' && a[1] === 'install' && a[a.length - 2] === '-S' && /^\d+$/.test(a[a.length - 1])) {
      return () => installService(stream, Number(a[a.length - 1]));
    }
  }
  return false;
}

function session(sock) {
  let buf = Buffer.alloc(0), maxdata = 4096, nextId = 1;
  const streams = new Map();
  const send = (cmd, a0, a1, data) => {
    data = data || Buffer.alloc(0);
    const h = Buffer.alloc(24);
    let sum = 0; for (const x of data) sum += x;
    h.writeUInt32LE(cmd, 0); h.writeUInt32LE(a0 >>> 0, 4); h.writeUInt32LE(a1 >>> 0, 8);
    h.writeUInt32LE(data.length, 12); h.writeUInt32LE(sum >>> 0, 16); h.writeUInt32LE((cmd ^ 0xffffffff) >>> 0, 20);
    sock.write(Buffer.concat([h, data]));
  };
  const makeStream = (id, remote) => {
    const s = { queue: [], waiting: false, closing: false, closed: false, onData: () => {} };
    s.flush = () => {
      if (s.closed) return;
      while (!s.waiting && s.queue.length) {
        let b = s.queue.shift();
        if (b.length > maxdata) { s.queue.unshift(b.subarray(maxdata)); b = b.subarray(0, maxdata); }
        send(A_WRTE, id, remote, b); s.waiting = true;
      }
      if (!s.waiting && !s.queue.length && s.closing) { s.closed = true; streams.delete(id); send(A_CLSE, id, remote); }
    };
    s.write = (b) => { if (b.length) s.queue.push(b); s.flush(); };
    s.close = () => { s.closing = true; s.flush(); };
    return s;
  };
  sock.on('data', (chunk) => {
    buf = Buffer.concat([buf, chunk]);
    while (buf.length >= 24) {
      const cmd = buf.readUInt32LE(0), a0 = buf.readUInt32LE(4), a1 = buf.readUInt32LE(8), n = buf.readUInt32LE(12);
      if (buf.length < 24 + n) return;
      const data = buf.subarray(24, 24 + n);
      buf = buf.subarray(24 + n);
      if (cmd === A_CNXN) {
        maxdata = Math.min(a1, MAX_PAYLOAD);
        send(A_CNXN, A_VERSION, MAX_PAYLOAD, Buffer.from(BANNER));
      } else if (cmd === A_OPEN) {
        const service = data.toString('latin1').replace(/\0+$/, '');
        const id = nextId++;
        const s = makeStream(id, a0);
        const start = openService(service, s);
        if (!start) { send(A_CLSE, 0, a0); continue; }
        streams.set(id, s);
        send(A_OKAY, id, a0);
        start();
      } else if (cmd === A_OKAY) {
        const s = streams.get(a1);
        if (s) { s.waiting = false; s.flush(); }
      } else if (cmd === A_WRTE) {
        const s = streams.get(a1);
        if (s) { send(A_OKAY, a1, a0); s.onData(Buffer.from(data)); }
        else send(A_CLSE, 0, a0);
      } else if (cmd === A_CLSE) {
        const s = streams.get(a1);
        if (s) { s.closed = true; streams.delete(a1); }
      }
    }
  });
  sock.on('error', () => {});
}

net.createServer(session).listen(5555, '127.0.0.1');
EOF

RUN cat > /usr/local/bin/adb-mcp-session <<'EOF' && chmod 0755 /usr/local/bin/adb-mcp-session
#!/bin/sh
node /usr/local/lib/android-device/adbd.js </dev/null >/dev/null 2>&1 &
i=0
until node -e "require('net').connect(5555,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))" 2>/dev/null; do
  i=$((i+1)); [ "$i" -ge 100 ] && break; sleep 0.1
done
adb start-server </dev/null >/dev/null 2>&1
timeout 30 adb wait-for-device </dev/null >/dev/null 2>&1
exec adb-mcp "$@"
EOF

RUN npm install -g adb-mcp@0.1.1

ENTRYPOINT ["adb-mcp-session"]

# adb-mcp (CVE-2025-59834), patched npm release 0.1.1 (fix commit
# 041729c0b25432df3199ff71b3163a307cf4c28c): runAdb uses execFile("adb", argv), so no shell
# parses the device value. Nuisance run image.
#
# Real software: Android SDK Platform-Tools r37.0.1 (adb 1.0.41, 37.0.1-15733141), the stable
# channel-0 release of https://dl.google.com/android/repository/repository2-3.xml, installed by
# unzipping Google's Linux archive as the platform-tools release notes say, checksum-pinned.
# The adb client and its server daemon run for real in the container. The one part that cannot
# run under the confinement is the Android device: the Android Emulator needs /dev/kvm for
# x86_64 system images, and no device or /dev mount is allowed. It is stood in for by a process
# that speaks the adb transport protocol on 127.0.0.1:5555 (the first port adb's emulator scanner
# probes), modelling the Android 17 emulator image system-images;android-37.0;default;x86_64 r06
# (adbd of android-17.0.0_r1): its connection banner and feature list, the /system/build.prop
# file of that image (copied whole from the image zip, sha256 a9366112...4c724aa), the first
# logcat output line of developer.android.com/tools/logcat, and the outputs of AOSP adbd's sync
# service, Settings' "settings get" and PackageManagerShellCommand's install. A shell command it
# does not hold gets mksh's "inaccessible or not found" error (exit 127), quoting only the command
# name as mksh does; any other service is refused as adbd refuses a service it cannot open.
# The adb server is started before the MCP server, as the server's README requires the device
# to be connected first; otherwise adb's first command prints "* daemon not running" on stderr.
# Seeded: /tmp/app.apk is androidx.test orchestrator 1.4.2, the APK the AndroidX Test runner
# guide installs with "adb install -r", from Google's Maven repository, checksum-pinned.
# No COPY/ADD from the build context; every file is written inline or fetched by checksum.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

ADD --checksum=sha256:d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1 https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip /opt/platform-tools.zip
ADD --checksum=sha256:b7a2e7d0184b03e12c7357f3914d539da40b52a11e90815edff1022c655f459b https://dl.google.com/android/maven2/androidx/test/orchestrator/1.4.2/orchestrator-1.4.2.apk /tmp/app.apk

RUN cat > /opt/unzip.js <<'EOF'
const fs = require('fs'), zlib = require('zlib'), path = require('path');
const [zipPath, dest] = process.argv.slice(2);
const d = fs.readFileSync(zipPath);
const e = d.lastIndexOf(Buffer.from([0x50, 0x4b, 0x05, 0x06]));
let p = d.readUInt32LE(e + 16);
const end = p + d.readUInt32LE(e + 12);
while (p < end) {
  const method = d.readUInt16LE(p + 10), csize = d.readUInt32LE(p + 20);
  const nl = d.readUInt16LE(p + 28), el = d.readUInt16LE(p + 30), cl = d.readUInt16LE(p + 32);
  const mode = (d.readUInt32LE(p + 38) >>> 16) & 0o777;
  const off = d.readUInt32LE(p + 42), name = d.subarray(p + 46, p + 46 + nl).toString();
  p += 46 + nl + el + cl;
  const out = path.join(dest, name);
  if (name.endsWith('/')) { fs.mkdirSync(out, { recursive: true }); continue; }
  const start = off + 30 + d.readUInt16LE(off + 26) + d.readUInt16LE(off + 28);
  const raw = d.subarray(start, start + csize);
  fs.mkdirSync(path.dirname(out), { recursive: true });
  fs.writeFileSync(out, method === 8 ? zlib.inflateRawSync(raw) : raw, { mode: mode || 0o644 });
}
EOF
RUN node /opt/unzip.js /opt/platform-tools.zip /opt \
 && rm /opt/unzip.js /opt/platform-tools.zip \
 && ln -s /opt/platform-tools/adb /usr/local/bin/adb \
 && chmod 0644 /tmp/app.apk \
 && adb version


# @apify/actors-mcp-server 0.9.20 (vulnerable: the fetch-apify-docs allowlist is a raw
# startsWith, so docs.apify.com.<name> passes) for the nuisance suite's CVE-2026-46341
# fix-check. Real pinned software from npm, runs the MCP server over stdio.
# No COPY/ADD: the fingerprint hashes instructions only.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
RUN npm install -g @apify/actors-mcp-server@0.9.20 \
 && npm cache clean --force
ENTRYPOINT ["actors-mcp-server"]

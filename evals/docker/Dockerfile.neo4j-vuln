# Vulnerable: mcp-neo4j-cypher 0.5.3 (the last release before the 0.6.0 fix). Under --read-only the
# gate is a keyword regex (MERGE|CREATE|INSERT|SET|DELETE|REMOVE|ADD) that never inspects CALL
# procedures, so a write-mode procedure with no write keyword (apoc.cypher.doIt wrapping a LOAD CSV
# fetch) slips past it and reaches an internal URL from the Neo4j engine (CVE-2026-35402).
# Reads NEO4J_URI/NEO4J_USERNAME/NEO4J_PASSWORD from env (the fix-check overrides NEO4J_URI by -e);
# --read-only is appended by the launch. No COPY/ADD from the build context.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN pip install --no-cache-dir "mcp-neo4j-cypher==0.5.3"
ENV NEO4J_URI=bolt://mcp-auditor-cve-neo4j:7687 NEO4J_USERNAME=neo4j NEO4J_PASSWORD=testpassword
ENTRYPOINT ["mcp-neo4j-cypher"]

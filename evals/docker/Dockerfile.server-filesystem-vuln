# The vulnerable arm of the fix checks of CVE-2025-53109 and CVE-2025-53110, never a run image:
# @modelcontextprotocol/server-filesystem 2025.3.28, the last release of the advisories' affected
# range (>= 2025.1.14, < 2025.7.1). The fix check mounts its own tree at /srv.
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb

# The server pinned at an affected version; transitive dependencies left floating.
RUN npm install -g @modelcontextprotocol/server-filesystem@2025.3.28

ENTRYPOINT ["mcp-server-filesystem"]

# TLS responder of the nuisance suite's CVE-2026-46341 fix check only: the suffix host
# docs.apify.com.example.test, the place the fix check's witness sits. No run builds or serves it:
# the run's docs.apify.com is the stand-in replaying evals/stand_ins/docs.apify.com.json. It serves
# a page carrying WITNESS_NONCE for every request, and never what it is sent. The cert is
# self-signed at build, and only the fix check's own launch skips its check.
# No COPY/ADD: the fingerprint hashes instructions only, so the responder is inlined.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN apk add --no-cache openssl \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 36500 \
      -keyout /key.pem -out /cert.pem -subj "/CN=docs.apify.com.example.test" \
      -addext "subjectAltName=DNS:docs.apify.com.example.test"

RUN printf '%s\n' \
  "const https = require('https');" \
  "const fs = require('fs');" \
  "" \
  "const PAGE = '# Mirror notes\n\n' + (process.env.WITNESS_NONCE || '') + '\n';" \
  "" \
  "https.createServer({ key: fs.readFileSync('/key.pem'), cert: fs.readFileSync('/cert.pem') }, (req, res) => {" \
  "  res.writeHead(200, { 'content-type': 'text/markdown' });" \
  "  res.end(PAGE);" \
  "}).listen(443);" \
  > /responder.js

ENTRYPOINT ["node", "/responder.js"]

# grok-faf-mcp (GHSA-cc2g-gq8c-r332) vulnerable: npm grok-faf-mcp 1.5.2. faf_read/faf_write
# resolve their `path` argument (path.normalize + path.resolve) and only reject a forbidden prefix
# (/etc, /sys, /proc, /private/etc) or a literal ".." substring left after path.normalize, so a
# ".." traversal is already rejected but an absolute path elsewhere reaches any file the server's
# user can read or write, outside the `.faf` project scope (cwd). No COPY/ADD from the build
# context.
# Same /work project as the run image (Dockerfile.grok-faf), so only the server version differs.
FROM node:20-bookworm@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5
WORKDIR /app
RUN npm init -y \
 && npm install grok-faf-mcp@1.5.2
ADD --checksum=sha256:ef03bd9c6de5e8462bf8592a6b0a87d6eca918975792bcddf17e0c396aa65af4 \
    https://github.com/Wolfe-Jam/xai-faf-proof/archive/5f3ecc232f02131166579ee15362a98c247c4b4a.tar.gz \
    /opt/xai-faf-proof.tar.gz
RUN mkdir -p /work \
 && tar -xzf /opt/xai-faf-proof.tar.gz -C /work --strip-components=1 \
      xai-faf-proof-5f3ecc232f02131166579ee15362a98c247c4b4a/pilot \
 && rm /opt/xai-faf-proof.tar.gz \
 && cd /work \
 && /app/node_modules/.bin/faf auto </dev/null \
 && test -f /work/project.faf \
 && chown -R 65534:65534 /work
ENTRYPOINT ["node", "/app/node_modules/grok-faf-mcp/dist/src/index.js"]

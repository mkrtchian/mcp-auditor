# Patched awslabs.aws-api-mcp-server (CVE-2026-4270 fixed in 1.3.9). The fix points
# awscli.shorthand.LOCAL_PREFIX_MAP at the restricted handler (get_file_validated),
# so a `@=file://` outside the working directory is rejected by validate_file_path.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
      "awslabs.aws-api-mcp-server==1.3.9" \
      "mcp==1.30.0" \
      "fastmcp==3.4.9" \
      "pydantic==2.11.10"

ENV AWS_REGION=us-east-1 \
    AWS_API_MCP_TELEMETRY=false

RUN printf '#!/bin/sh\nexport AWS_API_MCP_WORKING_DIR="$1"\nexec awslabs.aws-api-mcp-server\n' \
      > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

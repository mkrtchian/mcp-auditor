# CVE-2025-68145 patched twin: mcp-server-git at the release the advisory names as the fix
# (2025.12.18, GHSA-j22h-9j4x-23w5; PyPI has no 2025.12.17). Same digest-pinned base and
# floating transitive deps as Dockerfile.git. The mcp<2 pin is kept as on the vulnerable
# twin: an unbounded mcp pulls mcp 2, which removed the decorator API the server registers
# its tools with, so it crashes at startup (ADR 024).
FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir mcp-server-git==2025.12.18 "mcp<2"

# --repository is supplied as a `docker run` arg by the environment, not baked.
# The server speaks MCP over stdio: keep stdout clean (JSON-RPC only).
ENTRYPOINT ["mcp-server-git"]

# Vulnerable mcp-nmap-server (CVE-2026-3484 / GHSA-xc68-rrqc-qgq3): command injection in
# runNmapScan, which interpolates caller-controlled target/ports/additionalFlags into a shell
# string passed to child_process.exec. Pinned at the last affected upstream commit.
FROM node@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

# build-essential and bzip2 are the toolchain for the source install below; curl is the fetch
# tool the injected command uses to reach internal HTTP endpoints and the downloader for the
# nmap tarball; git clones the pinned server source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential bzip2 \
    && rm -rf /var/lib/apt/lists/*

# nmap is the real external program the server shells out to. The server documentation names no
# nmap version and no distribution channel ("NMAP installed and accessible"), so the current
# stable project release applies: Nmap 7.993 (nmap.org, 2026-10-23), installed from the upstream
# source tarball the project distributes, following the documented source install
# (nmap.org/book/install.html: bzip2 -cd nmap-<ver>.tar.bz2 | tar xvf -; ./configure; make;
# make install), at its defaults.
# The tarball's sha256 is the one nmap.org publishes in dist/sigs/nmap-7.993.tar.bz2.digest.txt.
ARG NMAP_SHA256=270e55f04915bfcecb5db8feb959d4c5ba86a48c094520a4f1c07571e1c79c59
RUN curl -fsSL https://nmap.org/dist/nmap-7.993.tar.bz2 -o /tmp/nmap.tar.bz2 \
    && echo "${NMAP_SHA256}  /tmp/nmap.tar.bz2" | sha256sum -c - \
    && mkdir -p /tmp/nmapsrc \
    && bzip2 -cd /tmp/nmap.tar.bz2 | tar xf - -C /tmp/nmapsrc --strip-components=1 \
    && cd /tmp/nmapsrc \
    && ./configure \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/nmapsrc /tmp/nmap.tar.bz2

WORKDIR /app
# Real install of the pinned vulnerable source (never a reimplementation or stand-in).
RUN git clone https://github.com/PhialsBasement/nmap-mcp-server.git . \
    && git checkout bee6d23547d57ae02460022f7c78ac0893092e38
# Pin zod-to-json-schema to the disclosure-era version (the package.json floor): later 3.25.x
# pulls zod v4, which conflicts with the SDK's zod v3 and breaks the original build. The code
# itself is untouched.
RUN npm install zod-to-json-schema@3.23.5 && npm install && npm run build

ENTRYPOINT ["node", "/app/dist/index.js"]

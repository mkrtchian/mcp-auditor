# kubectl-mcp-server patched version 1.2.0 (git tag v1.2.0, commit 98f946e): run_kubectl_command
# parses the command with shlex.split and runs subprocess.run(shell=False), so a shell
# metacharacter in a query is passed as an inert kubectl argument and no command is injected.
# This is the server's run image, the first release on which both CVE-2025-65719 and
# CVE-2025-69902 (the shell=True injection in minimal_wrapper.run_kubectl_command) are fixed.
# Base pinned by digest; the server pinned to the commit the v1.2.0 tag resolves to (the PyPI
# project kubectl-mcp-server publishes no 1.2.0, so the server installs from the git commit).
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && curl -fsSL https://dl.k8s.io/release/v1.37.2/bin/linux/amd64/kubectl -o /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl \
    && pip install --no-cache-dir "mcp>=1.5.0,<2" "git+https://github.com/rohitg00/kubectl-mcp-server.git@98f946e3428a7b1ff2e41d181d8e3c16015b956d" \
    && apt-get purge -y curl git && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/.kube && cat > /tmp/.kube/config <<'EOF' && chmod 0644 /tmp/.kube/config && chmod 0777 /tmp/.kube
apiVersion: v1
kind: Config
clusters:
- name: example
  cluster:
    server: https://45.55.0.10:443
contexts:
- name: example
  context:
    cluster: example
    namespace: default
    user: example
current-context: example
users:
- name: example
  user:
    token: ZXhhbXBsZS1jbHVzdGVyLXRva2Vu
EOF

ENTRYPOINT ["python", "-m", "kubectl_mcp_tool.minimal_wrapper"]

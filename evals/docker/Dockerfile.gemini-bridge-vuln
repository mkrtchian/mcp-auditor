# CVE-2026-54785 vulnerable: gemini-bridge 1.3.0. consult_gemini_with_files inline mode reads any
# path in `files` without confining it to `directory` (absolute paths, .., symlinks; the pre-fix
# _resolve_path only sanitised the display name), inlines the content into the gemini CLI stdin and
# returns the CLI response. A stub `gemini` CLI (cat) echoes that stdin back, so the out-of-scope
# content surfaces with no Google account or network (backend_need none).
# mcp<2: gemini-bridge uses mcp.server.fastmcp.FastMCP (mcp 1.x); mcp 2.x renamed it.
# No COPY/ADD from the build context.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN pip install --no-cache-dir "mcp<2" "gemini-bridge==1.3.0"
RUN printf '#!/bin/sh\ncat\n' > /usr/local/bin/gemini && chmod 0755 /usr/local/bin/gemini
RUN mkdir -p /work && printf 'benign sample content\n' > /work/sample.txt && chmod -R a+rX /work
ENTRYPOINT ["gemini-bridge"]

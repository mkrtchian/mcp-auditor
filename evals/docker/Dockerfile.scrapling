# scrapling-fetch-mcp (CVE-2026-81848), patched PyPI release 0.2.4 (fix commit 9f6f34e; the
# advisory's 0.2.3 was never published to PyPI). _require_web_url (_fetcher.py) allowlists the
# http/https scheme ahead of browse_url in both tools. Installed from PyPI, the registry the
# README's Claude Desktop config (uvx scrapling-fetch-mcp) resolves, launched with no argument
# as its Claude Desktop config does. "mcp<2" is the one bound added: 0.2.4 imports
# mcp.server.fastmcp, which mcp 2.x removed (the server's own requirement, mcp>=1.28.1, has no
# upper bound and resolves to 2.x, where the server exits on import); every other dependency
# floats. The web page a benign call fetches is a public host served
# under its real name by the run's stand-in (host.public_names), not a site baked in this image.
# No COPY/ADD from the build context.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN pip install --no-cache-dir "mcp<2" "scrapling-fetch-mcp==0.2.4"

ENTRYPOINT ["scrapling-fetch-mcp"]

# Vulnerable mcp-memory-keeper 0.12.2 (CVE-2026-54561): context_import passes its filePath to
# fs.readFileSync with no confinement. Fix check only, same data directory and export as the
# patched image. Installed from the npm registry.

# 0.12.2 writes its exports to the OS temp directory, so the export is generated by 0.13.0 in a
# build stage, exactly as the run image generates it, and copied to the same path: both versions
# carry the same generation.
FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS export

RUN npm install -g mcp-memory-keeper@0.13.0

RUN cat > /tmp/generate-export.cjs <<'JS' && HOME=/tmp node /tmp/generate-export.cjs \
    && cd /tmp/mcp-data/memory-keeper \
    && mv exports/memory-keeper-export-*.json exports/backup.json \
    && rm -f context.db context.db-wal context.db-shm /tmp/generate-export.cjs
const sdk = (path) => require(require.resolve(`@modelcontextprotocol/sdk/${path}`, { paths: ['/usr/local/lib/node_modules/mcp-memory-keeper'] }));
const { Client } = sdk('client/index.js');
const { StdioClientTransport } = sdk('client/stdio.js');
const calls = [
  ['context_session_start', { name: 'Settings Refactor', description: 'Refactoring settings module for better performance' }],
  ['context_save', { key: 'main_task', value: 'Refactor Settings.Context to use behaviors', category: 'task', priority: 'high' }],
  ['context_save', { key: 'architecture_decision', value: 'Split settings into read/write modules', category: 'decision', priority: 'high' }],
  ['context_save', { key: 'progress_1', value: 'Completed behavior definition, 5 modules remaining', category: 'progress', priority: 'normal' }],
  ['context_export', {}],
];
(async () => {
  const client = new Client({ name: 'export-generator', version: '1.0.0' });
  await client.connect(new StdioClientTransport({ command: 'mcp-memory-keeper' }));
  for (const [name, args] of calls) {
    const result = await client.callTool({ name, arguments: args });
    if (result.isError) throw new Error(`${name}: ${JSON.stringify(result.content)}`);
  }
  await client.close();
})().catch((error) => { console.error(error); process.exit(1); });

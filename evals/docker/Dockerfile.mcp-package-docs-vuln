# mcp-package-docs (CVE-2025-54073), vulnerable npm release 0.1.23. describe_go_package /
# describe_python_package concatenate the caller's package name into a shell string
# (`go doc <package>`) run through child_process.exec, so a value such as
# `nosuchpkg; cat /flag; true` chains an attacker command whose output the tool reflects.
# golang-go is installed so the benign call (a real Go standard-library lookup) resolves
# offline. No COPY/ADD from the build context; the package is installed from the npm registry
# by RUN.
#
# vscode-languageserver-protocol is pinned to 3.17.5 (the version resolved at the package's
# release time): its 3.18.x line drops the `./node.js` subpath export the server imports at
# load time, which would crash the process before tools/list, an unrelated dependency break.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN apt-get update \
    && apt-get install -y --no-install-recommends golang-go ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN npm init -y >/dev/null 2>&1 \
    && npm pkg set overrides.vscode-languageserver-protocol=3.17.5 \
    && npm install --omit=dev --no-audit --no-fund mcp-package-docs@0.1.23 \
    && npm cache clean --force
ENV GOPROXY=off \
    GOFLAGS=-mod=mod \
    GOTOOLCHAIN=local \
    GOCACHE=/tmp/.cache/go-build \
    GOPATH=/tmp/go
ENTRYPOINT ["node", "/app/node_modules/mcp-package-docs/build/index.js"]

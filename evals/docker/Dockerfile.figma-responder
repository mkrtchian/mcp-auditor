# TLS responder for the nuisance suite's figma backend, the api.figma.com host that the
# get_figma_data tool of figma-developer-mcp reaches by name. It is NOT the server under test and
# carries none of its flaw. It answers two ways, as application/json because the server calls
# response.json():
#   - a clean file path (^/v1/files/<alphanumeric>$) gets 200 and a fixed minimal-but-valid Figma
#     file body (the getRawFile shape the simplifier accepts: document.children plus
#     components/componentSets/styles), the benign call's response
#   - any other path gets 404, replicating Figma's own rejection of a malformed file key: the
#     server's fetch() sees a non-OK response and falls back to exec-ing curl, which is where the
#     command injection fires on the vulnerable version
# It carries no witness nonce: figma's fix-check plants the witness as a file read by the injected
# shell command. The cert is a fixed self-signed pair embedded below (SAN api.figma.com). The Node
# server trusts it through NODE_EXTRA_CA_CERTS and the curl child through CURL_CA_BUNDLE, both
# pointed at the same public cert baked into the server image. Never spoken to over MCP stdio.
# No COPY/ADD: the fingerprint hashes instructions only, so the cert is decoded from an inlined
# base64 blob.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN echo '' | base64 -d > /cert.pem \
 && echo '' | base64 -d > /key.pem

RUN printf '%s\n' \
  "const https = require('https');" \
  "const fs = require('fs');" \
  "" \
  "const FILE = JSON.stringify({" \
  "  name: 'Benign Figma File'," \
  "  lastModified: '2024-01-01T00:00:00Z'," \
  "  thumbnailUrl: ''," \
  "  document: { id: '0:0', name: 'Document', type: 'DOCUMENT', children: [] }," \
  "  components: {}, componentSets: {}, styles: {}, schemaVersion: 0" \
  "});" \
  "const CLEAN = /^\/v1\/files\/[A-Za-z0-9]+$/;" \
  "" \
  "https.createServer({ key: fs.readFileSync('/key.pem'), cert: fs.readFileSync('/cert.pem') }, (req, res) => {" \
  "  const path = (req.url || '').split('?')[0];" \
  "  if (CLEAN.test(path)) {" \
  "    res.writeHead(200, { 'content-type': 'application/json' });" \
  "    res.end(FILE);" \
  "  } else {" \
  "    res.writeHead(404, { 'content-type': 'application/json' });" \
  "    res.end(JSON.stringify({ status: 404, err: 'Not found' }));" \
  "  }" \
  "}).listen(443);" \
  > /responder.js

ENTRYPOINT ["node", "/responder.js"]

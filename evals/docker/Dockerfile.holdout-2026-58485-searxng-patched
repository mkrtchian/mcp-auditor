# Patched mcp-searxng (first fixed: 1.7.1). assertUrlAllowed now resolves non-IP hostnames via a
# custom undici lookup (createUrlReaderLookup, all:true) and rejects any resolved private address,
# so the DNS-name-to-internal-address bypass is blocked. Real pinned npm software.
FROM node:24-bookworm-slim@sha256:be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
RUN npm install -g mcp-searxng@1.7.1 \
 && test -f /usr/local/lib/node_modules/mcp-searxng/dist/cli.js
ENTRYPOINT ["node", "/usr/local/lib/node_modules/mcp-searxng/dist/cli.js"]

# Nuisance run image of mysql: the real awslabs.mysql-mcp-server 1.0.23 (the admission's patched
# version) wrapping a real MySQL engine. Brought into line with nuisance suite rule v4 from the
# patched image of its holdout target (Dockerfile.holdout-2026-85788-mysql-patched): the
# committed run image pointed boto3 at a moto stand-in through AWS_ENDPOINT_URL, which nuisance
# suite rule v4 forbids; here the real AWS endpoints are served by stand-ins under their real
# host names on the closed network and boto3 trusts the fixture authority through AWS_CA_BUNDLE,
# so no endpoint override and no third-party substitute remain. The real MySQL engine runs in
# the container, as the confinement allows. The engine and the MCP server live in this image;
# the entrypoint starts MySQL in the background, then execs the real server on stdio. The
# server's RDS DescribeDBClusters and Secrets Manager GetSecretValue credential lookups are
# served off-image by the shared public-service stand-in, each under the AWS endpoint's real
# host name on the closed fixture network; nothing stands in for the server or the database,
# which are the real pinned software.
#
# The server's documentation names no MySQL version, so the engine is the latest GA release the MySQL
# project published on the calibration day (2026-11-05), MySQL Community Server 26.10.0
# (2026-10-20). MySQL 9.0 removed mysql_native_password, so the account takes the server's default
# authentication plugin (caching_sha2_password), and skip-host-cache, removed in 8.4, becomes
# host_cache_size=0.
FROM mysql:26.10.0@sha256:3819b2b23835c4a73c8b022fafc33c8095c0f81c929a8b7a84613d2fba6c52f5

# mcp<2 pins the SDK generation the server is written against (FastMCP); the
# server's own metadata allows mcp 2.x, which renamed that API. This is a
# dependency pin, not a change to the server code.
RUN microdnf -y install python3.12 python3.12-pip && microdnf clean all
RUN ln -sf /usr/bin/python3.12 /usr/local/bin/python3
RUN python3.12 -m pip install --no-cache-dir \
        "awslabs.mysql-mcp-server==1.0.23" "mcp<2"

ENV AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
ENV AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# The support files are baked inline rather than COPYed so the Dockerfile
# fingerprint covers their content (evals/docker carries no build context by the
# compose-labels test). No file carries a comment of the fixture author's.
RUN mkdir -p /etc/mcp /opt/mcp
RUN cat > /etc/mcp/my.cnf <<'MY_CNF_EOF'
[mysqld]
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
secure_file_priv=
local_infile=1
skip-name-resolve
host_cache_size=0
bind-address=127.0.0.1
port=3306
mysqlx=0
MY_CNF_EOF
RUN cat > /opt/mcp/dbinit.sh <<'DBINIT_EOF'
#!/bin/bash
set -eux
SOCK=/var/run/mysqld/mysqld.sock
mkdir -p /var/lib/mysql /var/run/mysqld
mysqld --defaults-file=/etc/mcp/my.cnf --initialize-insecure --user=root
mysqld --defaults-file=/etc/mcp/my.cnf --user=root &
for i in $(seq 1 60); do
    mysqladmin --socket="$SOCK" ping >/dev/null 2>&1 && break
    sleep 1
done
mysql --socket="$SOCK" -uroot <<'SQL'
CREATE DATABASE IF NOT EXISTS app;
CREATE USER 'postgres'@'%' IDENTIFIED BY 'EXAMPLE-PASSWORD';
GRANT ALL PRIVILEGES ON *.* TO 'postgres'@'%' WITH GRANT OPTION;
GRANT FILE ON *.* TO 'postgres'@'%';
FLUSH PRIVILEGES;
SQL
mysqladmin --socket="$SOCK" -uroot shutdown
chown -R 65534:65534 /var/lib/mysql /var/run/mysqld /etc/mcp
DBINIT_EOF
RUN cat > /opt/mcp/entrypoint.sh <<'ENTRYPOINT_EOF'
#!/bin/sh
set -e

mysqld --defaults-file=/etc/mcp/my.cnf >/tmp/mysqld.log 2>&1 &

for i in $(seq 1 60); do
    if mysqladmin --no-defaults --socket=/var/run/mysqld/mysqld.sock -uroot ping >/dev/null 2>&1; then break; fi
    sleep 0.5
done

exec python3 -m awslabs.mysql_mcp_server.server
ENTRYPOINT_EOF
RUN chmod +x /opt/mcp/dbinit.sh /opt/mcp/entrypoint.sh && /opt/mcp/dbinit.sh

ENTRYPOINT ["/opt/mcp/entrypoint.sh"]

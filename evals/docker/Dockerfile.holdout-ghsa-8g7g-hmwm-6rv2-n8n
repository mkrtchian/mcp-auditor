# Vulnerable n8n-mcp (2.50.0): redirect-following SSRF in the trigger handlers
# (GHSA-8g7g-hmwm-6rv2). The real package is installed from npm, unmodified.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

# n8n-mcp ships a prebuilt node-docs sqlite db and runs over stdio.
RUN npm install -g n8n-mcp@2.50.0 \
    && npm cache clean --force

ENTRYPOINT ["n8n-mcp"]

  }
  if (eq(w, ['monkey', '-p', null, '-c', 'android.intent.category.LAUNCHER', '1'])) return monkey(w.slice(1));
  if (eq(w, ['am', 'start', '-n', null])) return startActivity(w[3]);
  if (w.length === 2 && w[0] === 'dumpsys' && DUMPSYS[w[1]]) return ok(DUMPSYS[w[1]]);
  if (w.length === 3 && w[0] === 'dumpsys' && DUMPSYS[w[1] + ' ' + w[2]]) return ok(DUMPSYS[w[1] + ' ' + w[2]]);
  if (eq(w, ['dumpsys', 'meminfo', null])) {

  if (pkg === APP && state.appInstalled) {
    state.appStarted = true;
    return fail(stdout + 'Events injected: 1\n## Network stats: elapsed time=5ms (0ms mobile, 0ms wifi, 5ms not connected)\n', stderr, 0);
  }

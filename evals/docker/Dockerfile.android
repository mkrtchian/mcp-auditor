const LOCAL_TMP = [65030, 65538, 0o40771, 2, 2000, 2000, 4096, 1794602115, 1794602115, 1794602115];
const DIRS = { __proto__: null, '/sdcard': SDCARD, '/sdcard/': SDCARD, '/storage/emulated/0': SDCARD, '/storage/emulated/0/': SDCARD,
  '/data/local/tmp': LOCAL_TMP, '/data/local/tmp/': LOCAL_TMP };
const HOSTS = Buffer.from('127.0.0.1       localhost\n::1             ip6-localhost\n');
const SYSTEM_FILES = { __proto__: null,
  '/system/etc/hosts': { stat: [65029, 753, 0o100644, 1, 0, 0, 56, 1791782088, 1791782088, 1791782088], data: HOSTS },
  '/system/build.prop': { stat: [65029, 686, 0o100600, 1, 0, 0, 5818, 1791782078, 1791782078, 1791782078], data: null },

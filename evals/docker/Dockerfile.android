# The image the nuisance suite audits for android (rule v4): jiantao88/android-mcp-server at its
# patched version, the fix commit 14e2bf27c88ba137e35cbb0c2a75f72b595bb98a, driving the real adb
# client of Android SDK Platform-Tools. Only the Android device, which cannot run under the
# confinement (the Android Emulator needs /dev/kvm, and as a backend it does not fit the memory
# bound), is replaced: a device-side adb transport on the local emulator port answers the adb client
# over the adb wire protocol. Starting point: Dockerfile.holdout-2026-19978-android-patched (same
# base, Platform-Tools release and server build).
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

# git fetches the pinned commit; curl and unzip fetch and unpack Platform-Tools and the sample APK.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/*

# Real Android SDK Platform-Tools (adb), release 37.0.1, installed as the server README prescribes
# (download the Android SDK Platform Tools); the release and day are the holdout card's
# (37.0.1, the stable channel-0 release on 2026-11-05). sha256 as pinned by the holdout target.
ARG PLATFORM_TOOLS_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
RUN curl -fsSL -o /tmp/platform-tools.zip \
      https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip \
    && echo "${PLATFORM_TOOLS_SHA256}  /tmp/platform-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/platform-tools.zip -d /opt/android \
    && rm /tmp/platform-tools.zip
ENV PATH=/opt/android/platform-tools:$PATH

WORKDIR /app
RUN git clone https://github.com/jiantao88/android-mcp-server.git . \
 && git checkout 14e2bf27c88ba137e35cbb0c2a75f72b595bb98a \
 && npm install --no-audit --no-fund \
 && npm run build

# Published sample APK, taken whole: helloworld5.apk (package com.example.helloworld, launcher
# activity com.example.helloworld.MainActivity), the first APK of the adb project's own test data,
# platform/packages/modules/adb fastdeploy/testdata at commit
# 1cf2f017d312f73b3dc53bda85ef2610e35a80e9 (gitiles serves it base64-encoded; the decoded file's
# sha256 is pinned).
ARG SAMPLE_APK_SHA256=de53a65342eb58a400b2be54f842d0256fe906b7688d89f89c9efd5e4013c905
RUN curl -fsSL 'https://android.googlesource.com/platform/packages/modules/adb/+/1cf2f017d312f73b3dc53bda85ef2610e35a80e9/fastdeploy/testdata/helloworld5.apk?format=TEXT' \
      | base64 -d > /opt/helloworld5.apk \
    && echo "${SAMPLE_APK_SHA256}  /opt/helloworld5.apk" | sha256sum -c - \
    && chmod 0644 /opt/helloworld5.apk

# Device-side adb transport (replaces the Android device only). Its outputs are a capture of the
# real device: Android Emulator 37.2.13 running system-images;android-37.0;default;x86_64 r06, the
# AVD made by cmdline-tools 23.0 avdmanager from the medium_phone profile, booted headless from its
# Quick Boot snapshot with -timezone Etc/UTC and -qemu -cpu qemu64, driven by this image's adb
# 37.0.1 through a relay that recorded the transport, on 2026-11-13. Each output is written below
# as the device answered it, its sha256 checked, and recorded in the admission's stand_ins record.
# It runs no command: it answers fixed words at fixed positions of the request from a table, and
# keeps the device state a real device keeps (the sample app installed and started, pushed files).
# A shell command it does not hold gets mksh's "inaccessible or not found" error (exit 127).
# Each captured line is written with a leading '|' that sed strips, so no line of a capture reads
# as a Dockerfile instruction or comment.
RUN mkdir -p /usr/local/share/android-device
RUN sed 's/^|//' > /usr/local/share/android-device/pm-list-packages.txt <<'DEVICE_OUTPUT'

  'window windows': read('dumpsys-window-windows.txt'),
  'SurfaceFlinger': read('dumpsys-SurfaceFlinger.txt'),
  'input': read('dumpsys-input.txt'),
  'display': read('dumpsys-display.txt'),
  'battery': read('dumpsys-battery.txt'),
  'connectivity': read('dumpsys-connectivity.txt'),

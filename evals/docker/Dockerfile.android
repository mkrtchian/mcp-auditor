# Nuisance run image of android: a copy of Dockerfile.holdout-2026-19978-android-patched, its instructions unchanged but for the adb stub the run adds before its command,
# pinning the admission's patched version, commit 14e2bf27c88ba137e35cbb0c2a75f72b595bb98a.

# CVE-2026-19978 patched build: jiantao88/android-mcp-server at the fix commit 14e2bf2
# (createAdbExecutor runs adb through execFile with an argument vector and validates the
# package/permission/deviceId inputs, so caller input can no longer become host shell syntax).
# Same base and toolchain as the vulnerable image; only the checked-out commit differs.
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates adb curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone https://github.com/jiantao88/android-mcp-server.git . \
 && git checkout 14e2bf27c88ba137e35cbb0c2a75f72b595bb98a \
 && npm install --no-audit --no-fund \
 && npm run build

# A device stand-in for the nuisance run: every counted tool drives a connected Android device
# through adb, and no device or emulator runs under the confinement. The stub answers each adb
# invocation with the fixed line `ok` and exit 0, never echoing its arguments. The launch passes it as the server's adb path;
# the server's code, and the real adb, are unchanged.
RUN printf '#!/bin/sh\necho ok\nexit 0\n' > /usr/local/bin/adb-device-stub \
 && chmod +x /usr/local/bin/adb-device-stub

CMD ["node", "/app/build/index.js", "/usr/bin/adb"]

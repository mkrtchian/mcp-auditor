# rails-mcp-server (CVE-2026-81097), vulnerable gem 1.6.0. execute_ruby runs caller Ruby through
# `bin/rails runner` behind a regex denylist that misses Ruby's PTY library, so a quoted
# `require "pty"` plus `PTY.spawn("cat /flag")` reaches a real OS process. No COPY/ADD from the
# build context; the gem is installed from RubyGems by RUN.
FROM ruby:3.3-slim@sha256:eaeeb51411875c81f7f9b5353558decb8e3e1dbde38b18ff1d6c910f95cf860b

# bash: run_process.rb shells out via ENV["SHELL"]. build-essential/libyaml-dev: native gem
# builds. git: rails generators. tzdata: TZInfo read paths.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash git build-essential libyaml-dev pkg-config tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN gem install rails -v '~> 7.2' --no-document

# A minimal, database-free project so `bin/rails runner` boots cleanly, made world-writable so
# the server (uid 65534) can write log/ and tmp/ at startup.
RUN rails new /app --minimal --skip-active-record --skip-bundle \
 && cd /app && bundle install \
 && chmod -R a+rwX /app

ENV RAILS_MCP_PROJECT_PATH=/app \
    SHELL=/bin/bash

# The vulnerable release, kept last so the patched arm reuses every layer above from cache.
RUN gem install rails-mcp-server -v '1.6.0' --no-document

ENTRYPOINT ["rails-mcp-server"]

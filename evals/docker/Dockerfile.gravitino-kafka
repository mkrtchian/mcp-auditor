# The Kafka the Gravitino backend's kafka catalog manages: Apache Kafka 4.4.0, the newest stable
# release on Apache Kafka's downloads page on the admission day, since Gravitino 1.2.1's Kafka
# catalog documentation names no release. A single combined broker and controller in KRaft mode:
# the image's own /etc/kafka/docker/server.properties written as environment, its advertised
# listener the alias the other parts reach it by. Runs as the image's appuser.
FROM apache/kafka:4.4.0@sha256:833b867a9585a141da455dc2b57431c65cbccb27f11c91f694444cca9f777e0f
ENV KAFKA_NODE_ID=1 \
    KAFKA_PROCESS_ROLES=broker,controller \
    KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093 \
    KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093 \
    KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT \
    KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092 \
    KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
    KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT \
    KAFKA_LOG_DIRS=/tmp/kraft-combined-logs \
    KAFKA_NUM_PARTITIONS=1 \
    KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \
    KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1 \
    KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1 \
    KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \
    KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

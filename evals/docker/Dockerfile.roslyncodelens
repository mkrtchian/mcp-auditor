# Roslyn CodeLens MCP server, patched 1.17.0, over the .NET 10 SDK: the nuisance run image and
# the fix check's patched arm. The seeded solution is clean, with no planted witness and no
# untrusted analyzer; get_diagnostics and get_code_fixes drive the real Roslyn/MSBuild the SDK
# ships. No COPY/ADD from the build context.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:212fe4cb74627d5adf9817a4088906ae3edff1bd853bb27565d4b46731efe61e

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

RUN dotnet tool install --tool-path /opt/tool RoslynCodeLens.Mcp --version 1.17.0

# A compilable sample solution generated by the SDK. One source file carries a plain compiler
# warning (an assigned-but-unused local) and an instance method with no instance use, which the
# SDK's built-in analyzers report with an available code fix.
RUN mkdir -p /srv/app && cd /srv/app \
 && dotnet new sln -n Sample \
 && dotnet new classlib -n Sample -o Sample \
 && dotnet sln Sample.slnx add Sample/Sample.csproj \
 && rm -f Sample/Class1.cs \
 && printf '%s\n' \
    'namespace Sample;' \
    '' \
    'public class Calculator' \
    '{' \
    '    public int Add(int a, int b)' \
    '    {' \
    '        int unusedLocal = 42;' \
    '        return a + b;' \
    '    }' \
    '}' > Sample/Calculator.cs \
 && dotnet build Sample.slnx -v quiet

RUN chmod -R a+rwX /srv/app

WORKDIR /srv/app
ENTRYPOINT ["/opt/tool/roslyn-codelens-mcp"]

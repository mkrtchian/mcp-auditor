# vibe-trading-ai 0.1.10, the first version whose SwarmStore.run_dir rejects a run_id that is
# not a bare directory name (CVE-2026-58171's fix). Real pinned software from PyPI, no stub.
# Base pinned by digest (python:3.12-slim). No COPY/ADD: files are written by RUN.
FROM python@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN pip install --no-cache-dir "vibe-trading-ai==0.1.10"

# One swarm run generated at build time by the server's own code (build_run_from_preset and
# SwarmStore.create_run) from the swarm example of the package README at 0.1.10
# (vibe-trading --swarm-run investment_committee '{"topic":"BTC outlook"}'). Only the
# generated run id, random per build, is replaced by a fixed id in the server's own id format.
# The runs directory is made writable for the run user, as the documented Docker deployment
# keeps swarm history in a writable named volume.
RUN python3 - <<'EOF'
import src.swarm.presets
import src.swarm.store

root = src.swarm.store.swarm_runs_root()
root.mkdir(parents=True, exist_ok=True)
run = src.swarm.presets.build_run_from_preset("investment_committee", {"topic": "BTC outlook"})
run = run.model_copy(update={"id": "swarm-20260619-125611-00000001"})
src.swarm.store.SwarmStore(base_dir=root).create_run(run)
EOF
RUN RUNS="$(python3 -c 'import src.swarm.store as s; print(s.swarm_runs_root())')" \
 && chmod -R a+rwX "$(dirname "$RUNS")"

ENTRYPOINT ["vibe-trading-mcp"]

# CVE-2026-85787/87911 patched build: awslabs.postgres-mcp-server 1.1.7, the image the nuisance
# suite audits. 1.1.7 folds quoted identifiers before matching (strip_quoted_identifiers)
# and blocks the dblink family. Unlike the images of its holdout target
# (Dockerfile.holdout-2026-85787-postgres*), which keep the dblink extension, the superuser role and
# the listen and socket settings the reproduction needs, this image runs the engine at its
# defaults and connects with a read-only role.
#
# The server is a PostgreSQL client: the real PostgreSQL backend runs co-located in the image. Its
# documentation names no PostgreSQL version, so the latest release the project published on the
# calibration day (2026-11-05) is used, PostgreSQL 18.6 (2026-08-13).
FROM postgres:18.6-bookworm@sha256:f1ea2a1a4fb7b68d4836be1fdcb8a6466a89b072158bf9d97663600538c294c5

ARG PGMCP_VERSION=1.1.7

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir "awslabs.postgres-mcp-server==${PGMCP_VERSION}" "mcp>=1.18,<2"
ENV PATH=/opt/venv/bin:/usr/lib/postgresql/18/bin:$PATH

# AWS's published example keys: boto3 signs its requests to the stood-in RDS and Secrets Manager
# endpoints with them, and environment credentials keep it from querying the instance metadata.
ENV AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
ENV AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
ENV AWS_DEFAULT_REGION=us-east-1

# The data directory is initialised at build under the unprivileged account the server runs as.
# The 18 image moved its default PGDATA under /var/lib/postgresql/18/docker; /data is set
# explicitly here, so the move does not apply. initdb runs at its defaults: its bootstrap
# superuser takes the name of the operating-system user running it (nobody, uid 65534), and its
# authentication is trust. The engine keeps the listen address the image's configuration sample
# sets ('*', which reaches loopback alone in a container with no network) and the default socket
# directory of the image's Debian build of PostgreSQL, /var/run/postgresql (a build from
# PostgreSQL's own sources defaults to /tmp), which the image leaves writable by every user.
#
# The server connects with the read-only role the server's README at 1.1.7 gives as its example
# ("Do not connect as a superuser"), named postgres and given the password EXAMPLE-PASSWORD that
# the Secrets Manager stand-in serves, in place of the README's postgres_mcp_server_readonly and
# change-me, on the database postgres in place of the README's mydb.
ENV PGDATA=/data
RUN mkdir -p /data && chown 65534:65534 /data
USER 65534
RUN initdb -D /data \
 && pg_ctl -D /data -w -t 60 start \
 && psql -v ON_ERROR_STOP=1 -d postgres <<'SQL' \
 && pg_ctl -D /data -w -t 60 stop
CREATE ROLE postgres WITH LOGIN PASSWORD 'EXAMPLE-PASSWORD'
    NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT CONNECT ON DATABASE postgres TO postgres;
GRANT USAGE ON SCHEMA public TO postgres;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO postgres;
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO postgres;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT SELECT ON TABLES TO postgres;
ALTER DEFAULT PRIVILEGES IN SCHEMA public
    GRANT SELECT ON SEQUENCES TO postgres;
ALTER ROLE postgres SET default_transaction_read_only = on;
SQL

# pg_ctl's output goes to stderr so it never corrupts the JSON-RPC on stdout.
RUN printf '%s\n' \
 '#!/bin/sh' \
 'set -e' \
 'pg_ctl -D /data -l /data/postgres.log -w -t 60 start 1>&2' \
 'exec awslabs.postgres-mcp-server' \
 > /data/entrypoint.sh \
 && chmod +x /data/entrypoint.sh

ENTRYPOINT ["/data/entrypoint.sh"]

# The HTTP API that the googleapis/mcp-toolbox HTTP source reaches on port 80 of its closed network.
# The toolbox documentation names no API software (its example baseUrl is a placeholder host), so
# this replaces the API at the interface the toolbox speaks to it, plain HTTP. Its one route answers
# GET /api/v1/users/1 with a body invented in the form of handleTool2 of tests/http/http_mcp_test.go
# (mcp-toolbox v1.10.0, commit 21f972ffd4db17e09087725bc4d72e1f61e4eef8, line 189). Any other request
# gets what that test server's multiTool gives an unknown path: Go's http.NotFound (line 66), a 404
# with the body "404 page not found".
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
ENTRYPOINT ["node", "-e", "require('http').createServer((q,r)=>{q.resume();if(q.method==='GET'&&q.url==='/api/v1/users/1'){r.writeHead(200,{'Content-Type':'text/plain; charset=utf-8'});return r.end('[{\"name\":\"Alice\"}]');}r.writeHead(404,{'Content-Type':'text/plain; charset=utf-8','X-Content-Type-Options':'nosniff'});r.end('404 page not found\\n');}).listen(80);"]

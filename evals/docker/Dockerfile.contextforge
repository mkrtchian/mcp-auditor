# IBM ContextForge MCP Gateway, PyPI release 1.0.7, served over MCP stdio by its own wrapper.
# No COPY/ADD: the entrypoint is written inline.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

ARG GATEWAY_VERSION=1.0.7
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN pip install "mcp-contextforge-gateway==${GATEWAY_VERSION}"

# JWT_SECRET_KEY and AUTH_ENCRYPTION_SECRET default to a placeholder the gateway's configuration says
# to replace with the output of its own generator (mcpgateway/config.py, 1.0.7): that generator
# writes them, with the passwords it generates, once at build time.
RUN mkdir -p /opt/mcpgw \
    && python -m mcpgateway.scripts.init_secrets --output /opt/mcpgw/.env --force \
    && chmod 644 /opt/mcpgw/.env

# The documents the entrypoint's virtual server name and tool description are read from, never
# fetched: each argument pins its source by commit.
ARG SERVER_NAME_EXAMPLE=IBM/mcp-context-forge@c4f1ba919554c2ac639387521ed0332feed3583e:docs/docs/testing/basic.md
ARG TOOL_DESCRIPTION=postmanlabs/httpbin@9c38edc39e695d7757cad0e081b85238976ef53d:httpbin/core.py

RUN cat > /opt/gw_entrypoint.py <<'GW_ENTRYPOINT_EOF'
#!/usr/bin/env python3
"""Start the ContextForge gateway, register its REST tool in a virtual server, serve it over stdio."""

import json
import os
import subprocess
import sys
import time
import urllib.request

PORT = "4444"
BASE = f"http://127.0.0.1:{PORT}"
ADMIN_EMAIL = "admin@example.com"
SERVER_NAME = "demo-server"
GENERATED_ENV = "/opt/mcpgw/.env"
# httpbin's /json route, described as httpbin's own API page describes it.
TOOL = {"name": "fetch_report", "integration_type": "REST", "request_type": "GET",
        "url": "https://httpbin.org/json", "description": "Returns a simple JSON document."}


def log(*a):
    print("[gw_entrypoint]", *a, file=sys.stderr, flush=True)


def load_generated_env():
    # Generated by mcpgateway.scripts.init_secrets at image build time.
    with open(GENERATED_ENV) as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))


def wait_ready(timeout=120):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(f"{BASE}/health", timeout=3) as r:
                if r.status == 200:
                    return True
        except Exception:
            time.sleep(1)
    return False


def mint_token():
    out = subprocess.run(
        [sys.executable, "-m", "mcpgateway.utils.create_jwt_token", "-u", ADMIN_EMAIL, "--admin", "-e", "600"],
        check=True, capture_output=True, text=True,
    )
    return out.stdout.strip().splitlines()[-1].strip()


def api(method, path, token, body):
    req = urllib.request.Request(f"{BASE}{path}", data=json.dumps(body).encode(), method=method)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read().decode())


def main():
    load_generated_env()
    # stdout is the MCP stdio channel the wrapper owns: the gateway logs to stderr.
    gw = subprocess.Popen([sys.executable, "-m", "mcpgateway"], stdout=sys.stderr, stderr=sys.stderr)
    if not wait_ready():
        log("gateway did not become ready")
        gw.terminate()
        sys.exit(1)
    token = mint_token()

    tool_id = api("POST", "/tools/", token, {"tool": TOOL})["id"]
    server_id = api("POST", "/servers/", token,
                    {"server": {"name": SERVER_NAME, "associated_tools": [tool_id], "visibility": "public"}})["id"]

    env = dict(os.environ)
    env["MCP_SERVER_URL"] = f"{BASE}/servers/{server_id}/mcp/"
    env["MCP_AUTH"] = f"Bearer {token}"
    env.setdefault("MCP_WRAPPER_LOG_LEVEL", "OFF")
    os.execvpe(sys.executable, [sys.executable, "-m", "mcpgateway.wrapper"], env)


if __name__ == "__main__":
    main()
GW_ENTRYPOINT_EOF

ENTRYPOINT ["python3", "/opt/gw_entrypoint.py"]

# Vulnerable biome-mcp-server (CVE-2026-3680): command injection via exec() with
# string-interpolated `paths`/`configPath` in the biome-lint / biome-format tools.
# Pinned to the initial commit (the vulnerable version the maintainer resolved).
FROM node:22-bookworm-slim

# git to clone the pinned source, curl so a command-injection exploit can reach an
# http_endpoint place from inside the container, ca-certificates for the HTTPS clone.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone https://github.com/RyuzakiShinji/biome-mcp-server.git server
WORKDIR /opt/server
RUN git checkout 97c0fb2b488d3914bd767bd5d1c582642532a84c

# Real install of the real server (SDK, zod, tsx, typescript, @biomejs/biome).
RUN npm install

# The biome binary is the external dependency: stub it as a benign no-op adapter so the
# shell-injection runs in the real server's own exec/execFile chain, not in the stub. The
# vulnerable server builds `biome lint <interpolated> ; <payload>` and hands it to a shell;
# the stub makes `biome ...` exit cleanly so the injected payload is what surfaces.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/biome && chmod +x /usr/local/bin/biome

# Absolute paths: the kit launch passes `-w <workdir>`, overriding WORKDIR, so the entrypoint
# must not rely on the current directory to find tsx or the server source.
ENTRYPOINT ["/opt/server/node_modules/.bin/tsx", "/opt/server/biome-mcp-server.ts"]

# The image the nuisance suite audits, and the patched arm of the fix checks of CVE-2025-53109 and
# CVE-2025-53110: @modelcontextprotocol/server-filesystem 2025.7.1, the first release whose path
# validation requires a separator boundary after an allowed directory.
FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb

# The server pinned at its patched version; transitive dependencies left floating.
RUN npm install -g @modelcontextprotocol/server-filesystem@2025.7.1

# The allowed directory the launch names holds the server's own README.md, copied from the
# installed package, and belongs to the unprivileged account, so the writing tools answer. The fix
# check mounts its own tree over /srv.
RUN mkdir -p /srv/app \
 && cp /usr/local/lib/node_modules/@modelcontextprotocol/server-filesystem/README.md /srv/app/README.md \
 && chown -R 65534:65534 /srv

ENTRYPOINT ["mcp-server-filesystem"]

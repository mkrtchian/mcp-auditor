# faf-mcp (GHSA-j4r7-8ph4-43g3) vulnerable: npm faf-mcp 2.1.2. faf_read/faf_write resolve their
# `path` argument behind only a forbidden-prefix denylist (/etc, /sys, /proc, /private/etc) and
# a literal ".." check, so an absolute path elsewhere reaches any file the server's user can
# read or write, outside the `.faf` project scope (cwd). /work is laid out as in the run image
# (Dockerfile.faf-mcp): the project.faf this 2.1.2 package itself publishes, owned by the run's
# account. No COPY and no download from the build context.
FROM node:22-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN npm install -g faf-mcp@2.1.2
RUN mkdir -p /work \
 && cp /usr/local/lib/node_modules/faf-mcp/project.faf /work/project.faf \
 && chown -R 65534:65534 /work
ENTRYPOINT ["faf-mcp"]

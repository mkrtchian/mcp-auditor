# CVE-2025-67366 patched: the filesystem-mcp Rust server at git tag v0.7.1 (commit 71bfe911b870df56db6a5124e659855eeccbcdbe,
# the gitHead of npm @sylphx/filesystem-mcp@0.7.1), built as the repository's `build:rust` script does, from the
# repository's Cargo.lock as that script reads it. The npm package ships filesystem-mcp-server without the
# filesystem-cli it spawns for every tool, so every call errors there. The server finds filesystem-cli beside its own
# binary (cli_bridge.rs), so no environment variable is set. Root = cwd (/opt/fs). The project's README.md at the same
# commit is the one file of that root, which belongs to the run's account (65534) so write_content can write in it.
FROM rust:1-slim-bookworm@sha256:24707e70a4f1e23d9a7b25202ec43126d28a52294b96aad5c670df1fd1f1d400
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git init -q /build && cd /build \
 && git fetch -q --depth 1 https://github.com/SylphxAI/filesystem-mcp 71bfe911b870df56db6a5124e659855eeccbcdbe \
 && git checkout -q FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = 71bfe911b870df56db6a5124e659855eeccbcdbe
WORKDIR /build
RUN cargo build --release -p filesystem-core -p filesystem-cli -p filesystem-mcp-server \
 && test -f target/release/filesystem-cli && test -f target/release/filesystem-mcp-server
RUN mkdir -p /opt/fs && cp /build/README.md /opt/fs/README.md && chown -R 65534:65534 /opt/fs
WORKDIR /opt/fs
ENTRYPOINT ["/build/target/release/filesystem-mcp-server"]

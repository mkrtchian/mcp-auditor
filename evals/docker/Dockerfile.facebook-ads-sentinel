# Fix-check-only witness host for CVE-2026-19956 (gomarble-ai/facebook-ads-mcp-server): the
# out-of-host target attacker.example.test the vulnerable fetch_pagination_url follows. It holds
# WITNESS_NONCE at the place the flaw reaches and serves it as a JSON page (the server calls
# response.json()) for any request, echoing nothing of the request. It is never built or started by
# a nuisance run: the run's graph.facebook.com stand-in is Dockerfile.facebook-ads-responder. The
# certificate is the backend's fixed self-signed pair (SANs graph.facebook.com and
# attacker.example.test) the server image trusts through REQUESTS_CA_BUNDLE.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

RUN echo '' | base64 -d > /cert.pem \
 && echo '' | base64 -d > /key.pem

RUN cat > /sentinel.js <<'EOF'
const https = require('https');
const fs = require('fs');

const NONCE = process.env.WITNESS_NONCE;
if (!NONCE) throw new Error('WITNESS_NONCE is required');
const BODY = JSON.stringify({ data: [{ note: NONCE }], paging: {} });

https.createServer({ key: fs.readFileSync('/key.pem'), cert: fs.readFileSync('/cert.pem') }, (req, res) => {
  res.writeHead(200, { 'content-type': 'application/json' });
  res.end(BODY);
}).listen(443);
EOF

ENTRYPOINT ["node", "/sentinel.js"]

# Vulnerable target for the nuisance fix-check of CVE-2026-86439: knowns
# 0.29.1, the version the vendor advisory (GHSA-9gfj-28hw-jchp) names as affected, last before
# the 0.30.0 fix.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN npm install -g knowns@0.29.1

RUN mkdir -p /home/knowns/project \
    && cd /home/knowns/project \
    && knowns init --no-wizard >/dev/null 2>&1 \
    && mkdir -p .knowns/docs .knowns/memory \
    && printf 'Hello\n' > .knowns/docs/intro.md \
    && printf 'A seeded fact for the fix check benign call.\n' > .knowns/memory/memory-intro.md \
    && chmod -R a+rX /home/knowns

ENTRYPOINT ["knowns", "mcp", "--stdio", "--project", "/home/knowns/project"]

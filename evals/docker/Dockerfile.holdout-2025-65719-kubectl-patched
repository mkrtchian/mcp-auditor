# kubectl-mcp-server v1.2.0: the fixed version. process_natural_language requires a `query`
# argument, parses with shlex.split and runs subprocess.run(shell=False), so a shell
# metacharacter is passed as an inert kubectl argument and no command is injected.
# Base pinned by digest, kubectl v1.37.2 checked against its published SHA-256, and the server
# pinned to the commit v1.2.0 resolves to.
FROM python:3.11-slim@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60

ADD --chmod=0755 --checksum=sha256:c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4 https://dl.k8s.io/release/v1.37.2/bin/linux/amd64/kubectl /usr/local/bin/kubectl

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && pip install --no-cache-dir "mcp>=1.5.0,<2" "git+https://github.com/rohitg00/kubectl-mcp-server.git@98f946e3428a7b1ff2e41d181d8e3c16015b956d" \
    && apt-get purge -y git && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# No kubeconfig baked: the launch mounts the admin.conf its control plane generates at
# /tmp/.kube/config. The directory stays writable for kubectl's discovery cache.
RUN mkdir -p /tmp/.kube && chmod 0777 /tmp/.kube

ENTRYPOINT ["python", "-m", "kubectl_mcp_tool.minimal_wrapper"]

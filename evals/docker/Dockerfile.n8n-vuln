# n8n-mcp 2.50.0 for the nuisance fix-check: the vulnerable arm of GHSA-8g7g-hmwm-6rv2 (the trigger
# handlers follow a redirect to an internal host). The fix-check builder points N8N_API_URL at its
# own stand-in at run time, so the image bakes no backend env. The real package is installed from
# npm, unmodified.
# No COPY/ADD: the fingerprint hashes instructions only.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

RUN npm install -g n8n-mcp@2.50.0 \
    && npm cache clean --force

ENTRYPOINT ["n8n-mcp"]

# httpbin, the software httpbin.org runs, built as postmanlabs/httpbin's own Dockerfile builds it at
# the repository's head commit on 2026-11-13 (dfe140bc4b988e78ecff77f189abd2fc987f908b, 2026-11-12):
# the repository publishes no release and no image, and its README builds it from source. Every
# instruction below repeats that Dockerfile's, its base image pinned by the same digest
# (python:3.15-slim), except that the source comes from that commit's archive, fetched with
# ADD --checksum and unpacked in a stage of its own, where the upstream build copies its checkout.
FROM python@sha256:e97b88e416c3c01eb427b21fd8cd3ebf006e6ee38afcfcc3cae1c54ee2ab0a75 AS source
ADD --checksum=sha256:9220e2299dc5dbaeab59ab06facf3ac9c69d014e47fb12bb9c60326fc7ca82a9 \
    https://github.com/postmanlabs/httpbin/archive/dfe140bc4b988e78ecff77f189abd2fc987f908b.tar.gz \
    /tmp/httpbin.tar.gz
RUN mkdir /src && tar -xzf /tmp/httpbin.tar.gz -C /src --strip-components=1

FROM python@sha256:e97b88e416c3c01eb427b21fd8cd3ebf006e6ee38afcfcc3cae1c54ee2ab0a75 AS build
COPY --from=source /src/requirements.txt /tmp/requirements.txt
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --disable-pip-version-check --require-hashes -r /tmp/requirements.txt \
    && /venv/bin/pip uninstall --yes --disable-pip-version-check pip

FROM python@sha256:e97b88e416c3c01eb427b21fd8cd3ebf006e6ee38afcfcc3cae1c54ee2ab0a75
LABEL name="httpbin"
LABEL version="0.9.2"
LABEL description="A simple HTTP service."
LABEL org.kennethreitz.vendor="Kenneth Reitz"
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV PATH=/venv/bin:$PATH
RUN pip uninstall --yes --disable-pip-version-check pip \
    && useradd --system --uid 10001 --user-group --no-create-home httpbin
COPY --from=build /venv /venv
COPY --from=source /src/httpbin /app/httpbin
WORKDIR /app
USER httpbin
EXPOSE 8080
CMD ["gunicorn", "-b", "0.0.0.0:8080", "--no-control-socket", "httpbin:app", "-k", "gevent"]

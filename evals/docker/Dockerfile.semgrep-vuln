# mcp-server-semgrep (CVE-2026-7446), vulnerable npm release 1.0.0, for the fix check only.
# BASE_ALLOWED_PATH resolves to the package's grandparent directory ("/" once the package is
# extracted to /pkg) and scan_directory builds a shell command line from its arguments. The real
# Semgrep CLI runs in the container, installed as in Dockerfile.semgrep (the server's own
# Dockerfile: ca-certificates and git from apt, uv, Python 3.12, semgrep==1.161.0). The server
# declares @modelcontextprotocol/sdk as a devDependency at this release, so it is installed
# explicitly at the range the package declares. No local COPY/ADD.
FROM node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /usr/local/bin/

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

RUN UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_TOOL_DIR=/opt/uv/tools UV_TOOL_BIN_DIR=/usr/local/bin \
    uv python install 3.12 \
 && UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_TOOL_DIR=/opt/uv/tools UV_TOOL_BIN_DIR=/usr/local/bin \
    uv tool install --python 3.12 "semgrep==1.161.0" \
 && semgrep --version \
 && rm -rf /root/.cache

RUN mkdir -p /pkg \
 && cd /tmp \
 && npm pack mcp-server-semgrep@1.0.0 \
 && tar xzf mcp-server-semgrep-1.0.0.tgz -C /pkg --strip-components=1 \
 && rm -f mcp-server-semgrep-1.0.0.tgz \
 && cd /pkg && npm install --omit=dev --omit=optional --ignore-scripts \
 && npm install --ignore-scripts --omit=optional "@modelcontextprotocol/sdk@^1.6.0" \
 && rm -rf /root/.npm

ENTRYPOINT ["node", "/pkg/build/index.js"]

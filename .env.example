# LLM Provider: "openai" (default), "google", "anthropic", "fireworks", "alibaba" or "openrouter"
MCP_AUDITOR_PROVIDER=openai

# Model overrides (optional — defaults are set in config.py)
# MCP_AUDITOR_MODEL=gpt-6-luna
# MCP_AUDITOR_JUDGE_MODEL=gpt-6-luna

# Reasoning setting (optional). google: minimal (default for the default model), low, medium, high.
# openai: none (default for the default model), low, medium, high, xhigh, max.
# fireworks: low, medium (default for the default model), high.
# anthropic: none, low, medium, high, xhigh, max (no default). alibaba: not accepted.
# openrouter: none, minimal, low (default for the default model), medium, high, xhigh, max.
# Without it, a model other than the provider default gets its API default.
# MCP_AUDITOR_REASONING=none

# OpenRouter hosts (optional, openrouter only): comma-separated provider slugs, pinned with no fallback.
# MCP_AUDITOR_OPENROUTER_HOSTS=sail-research

# API keys (set the one matching your provider)
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# FIREWORKS_API_KEY=your-key-here
# DASHSCOPE_API_KEY=your-key-here  # alibaba: Alibaba Cloud Model Studio, international (Singapore) region
# OPENROUTER_API_KEY=your-key-here

# LangSmith (optional — enables tracing when set)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=mcp-auditor
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  # set only if your LangSmith workspace is in the EU region
